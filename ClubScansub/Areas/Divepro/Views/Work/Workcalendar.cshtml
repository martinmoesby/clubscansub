@using System.Threading
@using ClubScansub.Utility.Extensions
@*@using Nager.Date*@
@using Nager.Date.Model
@using System.Globalization
@model IEnumerable<CourseSession>
@{

    ViewData["Title"] = "Divepro Arbejdskalender";
    var pageTitle = ViewData["Title"];
    var activeCourse = ViewBag.ActiveCourse;
    var poolIcon = "fa-swimming-pool";
    var openwaterIcon = "fa-water";
    var academicIcon = "fa-chalkboard-teacher";
    var currentMonthKey = (MonthKey)ViewBag.CurrentMonthKey;
    var actualMonthKey = new MonthKey(DateTime.Now);
    var next = currentMonthKey.GetNext();
    var prev = currentMonthKey.GetPrevious();
    
    var numberOfDays = currentMonthKey.NumberOfDays;
    DateTime startDate = currentMonthKey.CalendarStartDate;
    DateTime endDate = currentMonthKey.CalendarEndDate;
    DateTime iterateDate = startDate;
    int totalDays =currentMonthKey.TotalCalendarDays;
    IEnumerable<PublicHoliday> holidays = currentMonthKey.GetHolidays();
    
    Calendar cal = new CultureInfo("da-DK").Calendar;


}

<div class="container-fluid" style="min-width:1388px;">
    <partial name="_IndexPageHeaderPartialNoCreateButton" model="@pageTitle" />

    <div class="row">
        <div class="col-2">
            <a asp-action="Workcalendar" class="btn btn-outline-info rounded-circle mb-2" asp-route-monthKey=@prev.Id title="@prev.ToString()"><i class="fas fa-arrow-left"></i></a> 
        </div>
        <div class="col-8 text-center">
            @if (actualMonthKey.Id != currentMonthKey.Id) {
                <a asp-action="Workcalendar" class="btn btn-outline-info rounded-circle mb-2" title="@actualMonthKey.ToString()"><i class="fa fa-undo" aria-hidden="true"></i></a>
            }            
            <span class="h3 text-info text-capitalize">@currentMonthKey.ToString()</span>
        </div>
        <div class="col-2 text-right">

            <a asp-action="Workcalendar" class="btn btn-outline-info rounded-circle mb-2" asp-route-monthKey=@next.Id title="@next.ToString()"><i class="fas fa-arrow-right"></i></a>
        </div>
    </div>

    <div class="row border-bottom border-info text-info mt-2">
        <div class="px-1" style="width:30px">Uge</div>
        <div class="col">Mandag</div>
        <div class="col">Tirsdag</div>
        <div class="col">Onsdag</div>
        <div class="col">Torsdag</div>
        <div class="col">Fredag</div>
        <div class="col">Lørdag</div>
        <div class="col">Søndag</div>
    </div>

    <div class="row border-bottom border-left" style="min-height:75px">
        <div class="border-right border-info alert-info small align-items-center px-1" style="width:30px"><span class="small">@cal.GetWeekOfYear(startDate, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday)</span></div>
        @for (int i = 0; i < totalDays; i++)
        {
            var holidayName = "";

            iterateDate = startDate.AddDays(i);
            var bgStyle = iterateDate.DayOfWeek == DayOfWeek.Sunday || iterateDate.DayOfWeek == DayOfWeek.Saturday ? "bg-light text-dark" : "bg-white text-dark";
            var holiday = holidays.FirstOrDefault(x => x.Date == iterateDate);
            if (holiday != null) {
                holidayName = $" - {holiday.LocalName}";
                bgStyle = "alert-info";
            }


            if (iterateDate.DayOfWeek == Thread.CurrentThread.CurrentCulture.DateTimeFormat.FirstDayOfWeek && i > 0)
                {
                    @:</div><div class="row border-bottom border-left" style="min-height:75px"><div class="border-right border-info alert-info small px-1" style="width:30px"><span class="small"> @cal.GetWeekOfYear(iterateDate, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday)</span></div>
                    // start a new row every 7 days
                }  
                <div class="col border-right @bgStyle">
                    @if (iterateDate.Month == currentMonthKey.FirstDate.Month)
                    {
                    <div class="mb-2">@iterateDate.ToString("M") <span class="small text-bold">@holidayName</span></div>

                    var daysCOurses = Model.Where(x => x.DateTime.Day == iterateDate.Day);
                    var dayIsDisabled = iterateDate < DateTime.Now.Date;

                    foreach (var item in daysCOurses.OrderBy(x=>x.DateTime))
                    {
                        var alreadyActivatedMe = daysCOurses.SelectMany(x => x.SessionInstructors).Where(x => x.InstructorId == User.GetIdentityId() && x.InstructorApproved && x.CourseSessionId != item.Id).Any();

                        var bgItemStyle = "bg-white";
                            
                        @if (item.SessionInstructors.Where(x=>!x.InstructorRetracted).Any(x=> x.InstructorId == User.GetIdentityId()))
                        {
                            bgItemStyle = "alert-warning";//"alert alert-warning";
                        }
                            
                        @if (item.SessionInstructors.Where(x=>x.InstructorApproved).Any(x=> x.InstructorId == User.GetIdentityId()))
                        {
                            bgItemStyle = "alert-success";//"alert alert-success";
                        }


                        <div class="card mb-1 small">
                            <div class="card-header @bgItemStyle p-0 px-1">

                                <div class="row">
                                    <div class="col-3 small">
                                        <i class="fas @(item.Sessiontype == CourseSessionTypeEnum.AcademicSession ? academicIcon : @item.Sessiontype == CourseSessionTypeEnum.PoolSession ? poolIcon : openwaterIcon) text-info"></i>
                                        @item.DateTime.ToShortTimeString()
                                    </div>

                                    <div class="col-9 small font-weight-bold">
                                        @item.Course.CourseName
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-3 small">
                                        <i class="fas fa-user mr-1" title="Students"></i>@(item.Course.Participants.Count() + @item.Course.Signups.Count())                                           
                                    </div>                                     
                                    <div class="col-9 text-truncate small">
                                            @item.SessionName
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-3 small">
                                        <i class="fas fa-map-marker-alt" title="Location"></i>                                                                                    
                                    </div>                                     
                                    <div class="col-9 small text-truncate">
                                        @(item.Divelocation != null ? item.Divelocation.Name : item.Divelocation?.MeetingLocation != null ? item.Divelocation.MeetingLocation.Name : item.Address?.Name)
                                    </div>
                                </div>

                            </div>

                            <div class="card-body p-0 px-1">
                                <div class="row d-flex">
                                    @* Can only sign up, if you are NOT site-admin /Owner *@
                                    @if (!item.SessionInstructors.Any(x => x.InstructorId == User.GetIdentityId()) && !User.IsInRole("Owner"))
                                    {
                                        @if(!alreadyActivatedMe && !dayIsDisabled)
                                        {
                                            <div class="col-auto m-1 small">
                                                <a class="btn btn-sm btn-info" asp-action="ApplySingle" asp-route-sessionId="@item.Id" asp-route-monthKey="@currentMonthKey.Id">Skriv mig på <i class="fas fa-thumbs-up small ml-2" title="Yes, I can - sign me up!!"></i></a>
                                            </div>
                                        }
                                    }                                     

                                    @foreach (var instructor in item.SessionInstructors.OrderByDescending(x=>x.InstructorApproved))
                                    {
                                        var alreadyActivatedThisInstructor = daysCOurses.SelectMany(x => x.SessionInstructors).Any(x => x.InstructorId == instructor.InstructorId && x.InstructorApproved && x.CourseSessionId != item.Id && x.CourseSession.Course.Id != item.Course.Id);

                                        <div class="col-auto m-1 small">
                                           
                                        @if (instructor.InstructorRetracted && !instructor.InstructorApproved)
                                        {
                                            <span class="btn btn-sm alert-danger" disabled>
                                                <s>@instructor.Instructor.ShortName</s>
                                            </span>
                                        } 
                                        else if (!instructor.InstructorApproved && !instructor.InstructorRetracted && instructor.InstructorId == User.GetIdentityId() && !dayIsDisabled)
                                        {
                                            <a class="btn btn-sm btn-danger alert-danger mr-1" asp-action="Retract" asp-route-sessionid="@item.Id" asp-route-monthKey="@(ViewBag.Current)" title="Sorry, have to retract my subnmission">
                                                @instructor.Instructor.ShortName<i class="far fa-thumbs-down small ml-2" ></i>
                                            </a>
                                        } 
                                        else if (User.IsInRole("Administrator") && !instructor.InstructorRetracted)
                                        {
                                            if (!instructor.InstructorApproved)
                                            {
                                                if(alreadyActivatedThisInstructor || dayIsDisabled)
                                                {
                                                    var title = alreadyActivatedThisInstructor ? "Cannot approve - already assigned to a different Course" : "Cannot approve for days in the past";
                                                    <button class="btn btn-sm alert-warning" disabled title="@title">
                                                        @instructor.Instructor.ShortName
                                                        </button>                                               

                                                } else
                                                {
                                                    <a class="btn btn-sm alert-warning" asp-action="Approve"  asp-route-sessionId="@item.Id" asp-route-instructorId="@instructor.InstructorId"
                                                        title="Assign instructor">
                                                        @instructor.Instructor.ShortName<i class="fas fa-check small ml-2 text-success"></i>
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                if (dayIsDisabled)
                                                {
                                                    <button class="btn btn-sm btn-success" title="Remove instructor" disabled>
                                                        @instructor.Instructor.ShortName
                                                    </button>

                                                } else
                                                {
                                                    <a class="btn btn-sm btn-success" asp-action="Approve" asp-route-sessionId="@item.Id" asp-route-instructorId="@instructor.InstructorId" title="Remove instructor">
                                                        @instructor.Instructor.ShortName<i class="fas fa-times small ml-2 text-danger"></i>
                                                    </a>
                                                }
                                            }
                                        }
                                        else 
                                        {
                                            <span class="btn btn-sm @(instructor.InstructorApproved ? "badge-success" : instructor.InstructorRetracted ? "badge-danger" : "badge-warning")">@instructor.Instructor.ShortName</span>
                                        }
                                            
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                          

                    }
                 }
            </div>
        }
    </div>
</div>
