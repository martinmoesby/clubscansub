@model IEnumerable<CourseSessionInstructor>
@{
    ViewData["Title"] = "Min Undervisningsplan";
    var pageTitle = ViewData["Title"];
}

<partial name="_StatusMessage" model="@ViewBag.StatusMessage" />

<div class="container">

    <partial name="_IndexPageHeaderPartialNoCreateButton" model="@pageTitle" />

    <div class="border rounded-sm alert alert-success p-3 mt-3">
        <h4>Sat på som intruktør:</h4>
        <table class="table">
            <thead>
                <tr>
                    <th style="width:80px;">Kursus</th>
                    <th style="width:80px">Type</th>
                    <th style="width:200px;">Session</th>
                    <th style="width:80px;">Dato</th>
                    <th style="width:40px;">Start</th>
                    <th style="width:40px;">Slut</th>
                    <th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Where(x => x.InstructorApproved).OrderBy(x => x.CourseSession.DateTime))
                {
                    <tr>
                        <td class="small">@item.CourseSession.Course.CourseName</td>
                        <td class="small">@item.CourseSession.Sessiontype</td>
                        <td class="small">@(string.IsNullOrEmpty(item.CourseSession.SessionDescription) ? item.CourseSession.CourseSessionTemplate?.Description : item.CourseSession.SessionDescription )</td>
                        <td class="small">@item.CourseSession.DateTime.ToString("dd. MMMM yyyy")</td>
                        <td class="small">@item.CourseSession.DateTime.ToString("HH:mm")</td>
                        <td class="small">@item.CourseSession.DateTime.Add(item.CourseSession.Duration != null ? item.CourseSession.Duration : (item.CourseSession.CourseSessionTemplate?.DefaultDuration).GetValueOrDefault()).ToString("HH:mm")</td>
                        <td>&nbsp;</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="border rounded-sm alert alert-warning p-3 mt-3">
        <h4>Skrevet op som instruktør:</h4>
        <table class="table">
            <thead>
                <tr>
                    <th style="width:80px;">Kursus</th>
                    <th style="width:80px">Type</th>
                    <th style="width:200px;">Session</th>
                    <th style="width:80px;">Dato</th>
                    <th style="width:40px;">Start</th>
                    <th style="width:40px;">Slut</th>
                    <th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Where(x => !x.InstructorApproved).OrderBy(x => x.CourseSession.DateTime))
                {
                <tr>
                    <td class="small">@item.CourseSession.Course.CourseName</td>
                    <td class="small">@item.CourseSession.Sessiontype</td>
                    <td class="small">@(string.IsNullOrEmpty(item.CourseSession.SessionDescription) ? item.CourseSession.CourseSessionTemplate?.Name : item.CourseSession.SessionDescription)</td>
                    <td class="small">@item.CourseSession.DateTime.ToString("dd. MMMM yyyy")</td>
                    <td class="small">@item.CourseSession.DateTime.ToString("HH:mm")</td>
                    <td class="small">@item.CourseSession.DateTime.Add(item.CourseSession.Duration != null ? item.CourseSession.Duration : (item.CourseSession.CourseSessionTemplate?.DefaultDuration).GetValueOrDefault()).ToString("HH:mm")</td>
                    <td class="small">
                            @{
                                if (item.InstructorRetracted)
                                {
                                    <span class="border rounded-circle text-success btn border-success"><i class="fas fa-times" title="DU har afmeldt din tilmelding"></i></span>
                                }  
                                else 
                                {
                                    <a asp-action="Retract" asp-route-sessionId="@item.CourseSessionId" class="border rounded-circle text-danger btn border-danger"><i class="fas fa-undo" title="Afmeld som instruktør"></i></a>
                                }
                             }

                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>