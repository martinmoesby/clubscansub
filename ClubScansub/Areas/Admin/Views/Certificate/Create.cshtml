@model Certificate
@{
    ViewData["Title"] = "Create";
}

<div class="container">
    <form method="post" asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <h3 class="text-info mb-3">Ny Dykker organisation</h3>

        <div class="row">
            <div class="col-md-10 col-12">
                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="ShortName" class="col-form-label"></label>
                    </div>
                    <div class="col-3">
                        <input asp-for="ShortName" class="form-control" placeholder="Kaldenavn" />
                        <span asp-validation-for="ShortName" class="text-danger"></span>
                    </div>
                    <div class="col-3">
                        <label asp-for="DepthLimit" class="col-form-label"></label>
                    </div>
                    <div class="col-3">
                        <input type="number" asp-for="DepthLimit" class="form-control" placeholder="Maks dybde" />
                        <span asp-validation-for="DepthLimit" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="Name" class="col-form-label"></label>
                    </div>
                    <div class="col-9">
                        <input asp-for="Name" class="form-control" placeholder="Certifikat navn" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="Description" class="col-form-label"></label>
                    </div>
                    <div class="col-9">
                        <textarea asp-for="Description" class="form-control" placeholder="Beskrivelse"></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                
                <div class="form-group row">
                    <div class="col-3">
                        <label asp-for="IsDiveproCertificate" class="col-form-label"></label>
                    </div>
                    <div class="col-9">
                        <input type="checkbox" asp-for="IsDiveproCertificate" />
                    </div>
                    <span asp-validation-for="IsDiveproCertificate" class="text-danger"></span>
                </div>

            </div>
        </div>

        @*<div class="row d-flex">
            @foreach (var item in instructors)
            {
                <div class="col4">
                    <input type="checkbox" id="@item.Id" class="form-check" name="instructors" />
                    <label asp-for="@item.Id">@item.Name</label>
                </div>
            }
        </div>*@

        <button type="submit" class="btn btn-outline-success btn-sm"><i class="fas fa-save"></i>&nbsp;Gem</button>
    </form>

</div>

