@model ClubScansub.Areas.Admin.ViewModels.CreateDivelocationViewModel
@{
    ViewData["Title"] = "Create";
}

<form method="post" asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container p-4 m-4">
        <h2 class="text-info mb-3">Nyt dykkersted</h2>
        <div class="row">
            <div class="col-md-6 col-12">
                <h4>Dykkersted</h4>
                <!-- Divelocation.Name-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.Name" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="Divelocation.Name" class="form-control" placeholder="Dykkersted/vragnavn" />
                    </div>
                    <span asp-validation-for="Divelocation.Name" class="text-danger"></span>
                </div>

                <!-- Divelocation.Min and Max-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.MinDepth" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <input type="text" asp-for="Divelocation.MinDepth" class="form-control" placeholder="Min. dybde" />
                    </div>
                    <div class="col-4 text-right">
                        <label asp-for="Divelocation.MaxDepth" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <input type="text" asp-for="Divelocation.MaxDepth" class="form-control" placeholder="Max. dybde" />
                    </div>
                    <span asp-validation-for="Divelocation.MinDepth" class="text-danger"></span>
                    <span asp-validation-for="Divelocation.MaxDepth" class="text-danger"></span>
                </div>

                <!-- Divelocation.Min and Max participants-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.MinParticipants" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <input type="text" asp-for="Divelocation.MinParticipants" class="form-control" placeholder="Min. deltagere" />
                    </div>
                    <div class="col-4 text-right">
                        <label asp-for="Divelocation.MaxParticipants" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <input type="text" asp-for="Divelocation.MaxParticipants" class="form-control" placeholder="Max. deltagere" />
                    </div>
                    <span asp-validation-for="Divelocation.MinParticipants" class="text-danger"></span>
                    <span asp-validation-for="Divelocation.MaxParticipants" class="text-danger"></span>
                </div>

                <!-- Divelocation.Certification-->
                <div class="form-group row">
                    <div class="col-4">
                        <label class="col-form-label">Min. certifikat krav</label>
                    </div>
                    <div class="col-8">
                        <select asp-for="SelectedCertificateId" class="form-control" placeholder="Angiv minimums certifikat" asp-items="Model.Certificates">
                            <option value="" selected>Vælg certifikat krav</option>
                        </select>
                    </div>
                    <span asp-validation-for="SelectedCertificateId" class="text-danger"></span>
                </div>

                <!-- Divelocation.Default Start and duration-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.DefaultStartTime" class="col-form-label"></label>
                    </div>
                    <div class="col-6">
                        <input type="time" asp-for="Divelocation.DefaultStartTime" class="form-control" placeholder="Normal mødetidspunkt" />
                    </div>

                    <span asp-validation-for="Divelocation.DefaultStartTime" class="text-danger"></span>

                </div>

                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.DefaultDuration" class="col-form-label"></label>
                    </div>
                    <div class="col-6">
                        <input type="time" asp-for="Divelocation.DefaultDuration" class="form-control" placeholder="Normal varighed" />
                    </div>
                    <span asp-validation-for="Divelocation.DefaultDuration" class="text-danger"></span>
                </div>

                <!-- Divelocation.Price-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.Price" class="col-form-label"></label>
                    </div>
                    <div class="col-4">
                        <input asp-for="Divelocation.Price" type="number" class="form-control" placeholder="Angiv en standard pris" />
                    </div>
                    <span asp-validation-for="Divelocation.Price" class="text-danger"></span>
                </div>



                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.DefaultEventType" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <select asp-for="Divelocation.DefaultEventType" asp-items="Html.GetEnumSelectList<ClubScansub.Utility.EventTypeEnum>()" class="form-control"></select>
                    </div>
                    <span asp-validation-for="Divelocation.DefaultEventType" class="text-danger"></span>
                </div>

                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.DiveType" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <select asp-for="Divelocation.DiveType" asp-items="Html.GetEnumSelectList<ClubScansub.Utility.DiveTypeEnum>()" class="form-control"></select>
                    </div>
                    <span asp-validation-for="Divelocation.DiveType" class="text-danger"></span>
                </div>

                <!-- Divelocation.Description -->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.Description" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <textarea asp-for="Divelocation.Description" class="form-control" style="min-height:100px" placeholder="Angiv en beskrivelse"></textarea>
                    </div>
                    <span asp-validation-for="Divelocation.Description" class="text-danger"></span>
                </div>

                <!-- Divelocation.Image -->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.Image" class="col-form-label"></label>
                    </div>
                    <div class="col-4">
                        <input type="file" name="files" id="projectImage" class="form-control" />
                    </div>
                    <span asp-validation-for="Divelocation.Image" class="text-danger"></span>
                </div>

                <div class="form-group row">
                    <div class="col-md-8 col-12">
                        @{if (Model.Divelocation.Image.ImageData != null)
                            {
                                var imgSource = $"data:image;base64,{Convert.ToBase64String(Model.Divelocation.Image.ImageData)}";
                                <img class="img-fluid rounded rounded-circle" src="@(imgSource)" alt="" />
                            }
                            else
                            {
                                <p class="">Intet billede indlæst</p>
                            }
                        }
                    </div>
                </div>

            </div>
            <div class="col-md-6 col-12">

                <h4>Mødested</h4>
                <!-- .MeetingLocation.ExsitingAddresses-->
                <div class="form-group row border-bottom">
                    <div class="input-group">
                        <div class="col-4 input-group-prepend">
                            <label class="col-form-label">Vælg eksisterende mødested</label>
                        </div>
                        <div class="col-8">
                            <select asp-for="SelectedAddressId" class="form-control" id="selectedAddressId" onchange="onDivelocationChange()" asp-items="@Model.ExistingAddresses">
                                <option value="">Vælg eksisterende mødested eller...</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- .MeetingLocation.Name-->
                <div class="form-group row">
                    <div class="input-group">
                        <div class="col-4 input-group-prepend">
                            <label asp-for="Divelocation.MeetingLocation.Name" class="col-form-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="Divelocation.MeetingLocation.Name" id="addressName" class="form-control" placeholder="Stednavn" />
                        </div>
                    </div>
                    <span asp-validation-for="Divelocation.MeetingLocation.Name" class="text-danger"></span>
                </div>

                <!-- .MeetingLocation.Streetname-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.MeetingLocation.Streetname" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="Divelocation.MeetingLocation.Streetname" id="addressStreetname" class="form-control" />
                    </div>
                    <span asp-validation-for="Divelocation.MeetingLocation.Streetname" class="text-danger"></span>
                </div>

                <!-- .MeetingLocation.Zip/City -->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.MeetingLocation.Zipcode" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <input asp-for="Divelocation.MeetingLocation.Zipcode" id="addressZipcode" class="form-control" />
                    </div>
                    <div class="col-1 text-right">
                        <label asp-for="Divelocation.MeetingLocation.City" class="col-form-label"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="Divelocation.MeetingLocation.City" id="addressCity" class="form-control" />
                    </div>
                    <span asp-validation-for="Divelocation.MeetingLocation.Zipcode" class="text-danger"></span>
                    <span asp-validation-for="Divelocation.MeetingLocation.City" class="text-danger"></span>

                </div>

                <!-- .MeetingLocation.Country-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Divelocation.MeetingLocation.Country" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="Divelocation.MeetingLocation.Country" id="addressCountry" class="form-control" />
                    </div>
                    <span asp-validation-for="Divelocation.MeetingLocation.Country" class="text-danger"></span>
                </div>

                <div class="form-group row">
                    <div class="col-3 offset-4"><button type="button" onclick="geocodeMap()" class="btn btn-sm btn-outline-info mb-2"><i class="fas fa-search"></i>&nbsp;Find...</button> </div>
                    <div class="col-12">
                        <div id="meetLocationMap" class="map" style="height:300px;"></div>
                        <div id="geocodeAddress">
                            <input id="latitude" class="form-control" asp-for="Divelocation.MeetingLocation.Latitude" type="hidden" />
                            <input id="longitude" class="form-control" asp-for="Divelocation.MeetingLocation.Longitude" type="hidden" />
                        </div>
                    </div>
                </div>


            </div>

        </div>

        <!-- Buttons -->
        <div class="form-group row">
            <div class="col-6 offset-6">
                <partial name="_SaveAndBackButtonsPartial" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script language="javascript">
        function onDivelocationChange() {

            var selectedId = $('#selectedAddressId')[0].value;

            $.getJSON({
                url: "/Admin/Divesite/GetExistingAddress",
                data: { id: selectedId },
                success: function (data) {

                    $('#addressCity').val(data.city);
                    $('#addressZipcode').val(data.zipcode);
                    $('#addressStreetname').val(data.streetname);
                    $('#addressName').val(data.name);
                    $('#addressCountry').val(data.country);

                    geocodeMap();
                }
            })
        }
    </script>
    <script src="~/js/bingmap.js"></script>

}