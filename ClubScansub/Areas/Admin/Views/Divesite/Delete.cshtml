                    </div>
                    <div class="col-8">
                        <label class="form-control">@(string.IsNullOrEmpty(Model.Description) ? "Ingen Beskrivelse angivet" : Model.Description)</label>
                    </div>
                </div>
                   *@
                <!-- Min and Max-->
                @*<div class="form-group row">
                    <div class="col-4">
                        <label asp-for="MinDepth" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <label class="form-control">@Model.MinDepth</label>
                    </div>
                    <div class="col-4 text-right">
                        <label asp-for="MaxDepth" class="col-form-label"></label>
                    </div>
                    <div class="col-2">
                        <label class="form-control">@Model.MaxDepth</label>
                    </div>

                </div>*@

                @*<button type="submit" class="btn btn-outline-danger form-control" asp-route-id="Id"><i class="fas fa-trash"></i>Slet</button>*@

                @*<div class="row">
                        <div class="col-4 offset-4">
