@model Divelocation

@{
    ViewData["Title"] = "Administration - Dykkersted - Slet ?";
}

<form method="post" asp-action="Delete">
    <div class="container p-4 m-4">
        <h2 class="text-info mb-3">Slet dykkersted ?</h2>
        <div class="alert-danger my-3 p-4 rounded border-danger">Dette kan ikke fortrydes - alle ture i kalenderen, som går til dette sted vil også blive fjernet fra systemet</div>
        <div class="row">
            <div class="col-md-6 col-12">
