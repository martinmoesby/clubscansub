                </div>

                <!-- Name-->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="Name" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <label class="form-control">@Model.Name</label>
                    </div>
                </div>

                <!-- DiveType -->
                <div class="form-group row">
                    <div class="col-4">
                        <label asp-for="DiveType" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <label class="form-control">@Model.DiveType</label>
                    </div>
                </div>

