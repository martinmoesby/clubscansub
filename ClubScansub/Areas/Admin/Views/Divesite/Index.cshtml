@model  IEnumerable<Divelocation>
@{
    ViewData["Title"] = "Admin - Dykkersteder";
    var pageTitle = "Dykkersteder";
}

    <div class="container">

        <partial name="_IndexPageHeaderPartial" model="@pageTitle" />

        @if (Model.Count() == 0)
        {
            <h4 class="text-info">Ingen dykkersteder</h4>
            <p>Tryk på 'Ny' for at oprette et nyt dykkersted</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th></th>
                        <th>
                            <label asp-for="@Model.First().Id"></label>
                        </th>
                        <th>
                            <label asp-for="@Model.First().Name"></label>
                        </th>
                        <th>
                            <label asp-for="@Model.First().DiveType"></label>
                        </th>
                        <th>
                            <label asp-for="@Model.First().DefaultEventType"></label>
                        </th>
                        <th>
                            <label>Dybde</label>
                        </th>
                        <th>
                            <label>Mødested</label>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var location in Model)
                    {
                    <tr>
                        <td class="small" style="width:128px;">
                            @{if (location.Image != null)
                                {
                                    var imgSource = $"data:image;base64,{Convert.ToBase64String(location.Image)}";
                                    <img class="img rounded" src="@(imgSource)" alt="" height="64" style="height:64px" />
                                }
                                else
                                {
                                    <p class="small">Intet billede indlæst</p>
                                }
                            }
                        </td>
                        <td class="small">@location.Id</td>
                        <td class="small">@location.Name</td>
                        <td class="small"><span>@location.DiveType.ToString()</span></td>
                        <td class="small"><span>@location.DefaultEventType.ToString()</span></td>
                        <td class="small">@location.MinDepth til @location.MaxDepth m.</td>
                        <td class="small">
                            @if (location.MeetingLocation != null)
                            {
                                <p>
                                    @location.MeetingLocation.Name
                                </p>
                            }
                            else
                            {

                                <p>Intet mødested angivet</p>
                            }

                        </td>
                        <td>
                            <partial name="_EditDetailsDeleteButtonsPartial" model="@location.Id" />
                        </td>
                    </tr>
                    }
                </tbody>
            </table>

        }
    </div>
