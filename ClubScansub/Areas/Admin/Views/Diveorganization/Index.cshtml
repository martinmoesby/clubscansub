@model  IEnumerable<Diveorganization>
@{
    ViewData["Title"] = "Dykker Organisationer";
}

    <div class="container">
        <h1 class="display-4">Dykker organisationer</h1>
        <h3 class="font-weight-light"> - og certifikater</h3>

        <div class="row mt-3">
            <table class="table">
                <thead>
                    <tr>
                        <th><label asp-for="FirstOrDefault().ShortName"></label></th>
                        <th><label asp-for="FirstOrDefault().Name"></label></th>
                        <th><label asp-for="FirstOrDefault().Description"></label></th>
                        <th><a class="btn btn-outline-info btn-sm form-control" asp-action="Create" asp-controller="Diveorganization" asp-area="Admin"><i class="fas fa-plus"></i>&nbsp;Tilføj</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var org in Model)
                    {
                        <tr>
                            <td><button data-toggle="collapse" data-target="#collapse_@org.Id" class="btn btn-outline-info btn-sm form-control" title="Klik for at se certificater" >@org.ShortName</button> </td>
                            <td>@org.Name</td>
                            <td>@org.Description</td>
                            <td><partial name="_EditDetailsDeleteButtonsPartial" model="org.Id" /></td>
                        </tr>
                        <tr class="collapse" id="collapse_@org.Id">
                            <td></td>
                            <td colspan="2">
                                @if (org.Certificates.Count > 0)
                                {
                                    <table class="table table-info">
                                        <thead>
                                            <tr>
                                                <th colspan="3">
                                                    <i class="fas fa-award"></i>&nbsp;Certifikater
                                                </th>
                                            </tr>
                                        </thead>
                                        @foreach (var cert in org.Certificates)
                                        {
                                            <tr>
                                                <td>@cert.Certificate.ShortName</td>
                                                <td>@cert.Certificate.Name</td>
                                                <td>@cert.Certificate.Description</td>
                                            </tr>
                                        }
                                    </table>
                                }
                                else
                                {
                                    <p>Ingen certifikater tilknyttet</p>
                                }
                            </td>
                            <td><button class="btn btn-outline-info btn-sm" asp-action="AddCertificate" asp-route-id="@org.Id"><i class="fas fa-plus"></i>&nbsp;Tilknyt</button></td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

