@model IEnumerable<Event>
@{
    ViewData["Title"] = "Admin - Begivenheder";
    var pageTitle = ViewBag.PageTitle;

}
<partial name="_StatusMessage" model="@ViewBag.StatusMessage" />
<div class="container">

    <partial name="_IndexPageHeaderPartial" model="@pageTitle" />


    @if (Model.Count() == 0)
    {
        <h4 class="text-info">Ingen begivenheder</h4>
        <p>Tryk på 'Ny' for at oprette en ny begivenhed</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    @*<th>
                            <label asp-for="@Model.First().Id"></label>
                        </th>*@
                    <th>
                        <label asp-for="@Model.First().Title"></label>
                    </th>
                    <th>
                        <label asp-for="@Model.First().StartDateAndTime"></label>
                    </th>
                    <th>
                        <label asp-for="@Model.First().Divelocation.Name"></label>
                    </th>
                    <th>
                        <label>Dybde</label>
                    </th>
                    <th><label>Tilmeldte</label></th>
                    <th>
                        <label asp-for="@Model.First().IsInternal"></label>
                    </th>
                    @*<th>
                            <label asp-for="@Model.First().IsFreeForDivepros"></label>
                        </th>*@
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @*<td class="small">@item.Id</td>*@
                        <td class="small">@item.Title</td>
                        <td class="small">@item.StartDateAndTime.ToShortDateString() kl. @item.StartDateAndTime.ToShortTimeString()</td>
                        @if (item.Divelocation != null)
                        {
                            <td class="small">@item.Divelocation.Name</td>
                            <td class="small">@item.Divelocation.MinDepth til @item.Divelocation.MaxDepth m.</td>
                        }
                        else
                        {
                            <td class="small" colspan="2">Dykker lokation ikke angivet</td>
                        }

                        <td class="small">@(item.Participants.Count + item.FixedParticipants) af @item.MinParticipants - @item.MaxParticipants</td>

                        <td>
                            <input type="checkbox" asp-for="@item.IsInternal" readonly disabled />
                        </td>
                        @*<td>
                                <input type="checkbox" asp-for="@item.IsFreeForDivepros" readonly disabled />
                            </td>*@
                        <td class="small">
                            @if (!item.IsCancelled)
                            {
                                <partial name="_EditDetailsDeleteButtonsPartial" model="@item.Id" />
                            }
                            else
                            {
                                <span class="text-danger"><i class="fas fa-ban"></i>&nbsp;Aflyst</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    }
    <div class="row">

        <div class="col-4">
            @if (ViewBag.IsClosedEvents)
            {
                <a class="btn btn-sm btn-outline-success" asp-action="Index" asp-route-eventtype="@ViewBag.EventType">Se aktive...</a>
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="ClosedEvents" asp-route-eventtype="@ViewBag.EventType">Se afsluttede...</a>
            }
        </div>

    </div>
</div>