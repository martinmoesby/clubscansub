@model ClubScansub.Areas.Admin.Controllers.EventController.PageModel
@{
    ViewData["Title"] = "Administrer begivenhed";
}

<partial name="_StatusMessage" model="@ViewBag.StatusMessage" />

<div class="container">
    <h1 class="display-4 mb-4">@(string.IsNullOrEmpty(Model.Event.Title) ? Model.Event.Divelocation.Name : Model.Event.Title) d. @Html.FormatValue(Model.Event.StartDateAndTime, "{0:d}")</h1>



    <div class="row mb-3">

        <div class="col-md-6 col-12">
            <h5><i class="fas fa-calendar-alt"></i>&nbsp;Detaljer</h5>

            <form method="post">
                <input type="hidden" asp-for="Event.Id" />
                <input type="hidden" asp-for="Event.DeeplinkId" />
                <input type="hidden" asp-for="Event.FixedParticipants" />

                <input type="hidden" asp-for="Event.Divelocation.Name" />
                <input type="hidden" asp-for="Event.Divelocation.MinDepth" />
                <input type="hidden" asp-for="Event.Divelocation.MaxDepth" />

                <input type="hidden" asp-for="Event.SecondaryDivelocation.Name" value="Ingen" />
                <input type="hidden" asp-for="Event.SecondaryDivelocation.MinDepth" value="1" />
                <input type="hidden" asp-for="Event.SecondaryDivelocation.MaxDepth" value="1" />


                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Type:</span>
                    </div>
                    <select class="form-control" asp-for="Event.EventType" asp-items="@Html.GetEnumSelectList<EventTypeEnum>()">
                    </select>
                    @*<input type="text" class="form-control" asp-for="Event.EventType" readonly />*@
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Til:</span>
                    </div>
                    <select class="form-control" asp-for="Event.Divelocation.Id" asp-items="Model.LocationsList">
                        <option value="">Dykkersted...</option>
                    </select>
                    @*<input type="text" class="form-control" data-style="btn btn-secondary" asp-for="Event.Divelocation.Name" readonly /> *@
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Og evt. til:</span>
                    </div>
                    <select class="form-control" asp-for="Event.SecondaryDivelocation.Id" asp-items="Model.LocationsList">
                        <option value="0">Sekundært Dykkersted...</option>
                    </select>
                    @*<input type="text" class="form-control" data-style="btn btn-secondary" asp-for="Event.Divelocation.Name" readonly /> *@
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Titel</span>
                    </div>
                    <input type="text" class="form-control" asp-for="Event.Title" id="title" autocomplete="off" />
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend align-content-start">
                        <span class="input-group-text" style="width:120px;">Detaljer</span>
                    </div>
                    <textarea class="form-control" asp-for="Event.Details" autocomplete="off" style="height:150px;"></textarea>
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend align-content-start">
                        <span class="input-group-text" style="width:120px;">Min. Certifikat</span>
                    </div>
                    <select class="form-control" type="text" asp-for="Event.RequiredCertificate.Id" asp-items="Model.CertificatesList">
                        <option value="">Vælg certificat...</option>
                    </select>
                </div>

                <div class="form-group input-group col-9">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Start:</span>
                    </div>
                    <input type="datetime-local" class="form-control" asp-for="Event.StartDateAndTime" placeholder="" />
                </div>

                <div class="form-group input-group col-9">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Slut:</span>
                    </div>
                    <input type="datetime-local" class="form-control" asp-for="Event.EndDateAndTime" placeholder="" />
                </div>

                <div class="form-group d-flex justify-content-between">

                    <div class="input-group  col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Min:</span>
                        </div>
                        <input type="number" class="form-control" asp-for="Event.MinParticipants" />
                    </div>

                    <div class="input-group mr-2 col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Max:</span>
                        </div>
                        <input type="number" class="form-control" asp-for="Event.MaxParticipants" />
                    </div>
                </div>

                <div class="form-group d-flex justify-content-between">
                    <div class="form-group input-group col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Pris:</span>

                        </div>
                        <input class="form-control" asp-for="Event.Price" asp-format="{0:N0}" id="NormalPrice" onchange="SynchWithControl('PremiumPrice')" />
                    </div>

                    <div class="form-group input-group col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Pris (Prem. medlemmer):</span>

                        </div>
                        <input class="form-control" asp-for="Event.PremiumPrice" asp-format="{0:N0}" id="PremiumPrice" />
                    </div>
                </div>

                <div class="form-group d-flex justify-content-between">
                    <div class="form-group input-group col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text">
                                <input type="checkbox" asp-for="Event.IsInternal" />
                            </span>
                        </div>
                        <label class="form-control" asp-for="Event.IsInternal"></label>
                    </div>
                    <div class="form-group input-group col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text">
                                <input type="checkbox" asp-for="Event.IsFreeForDivepros" />
                            </span>
                        </div>
                        <label class="form-control" asp-for="Event.IsFreeForDivepros"></label>
                    </div>


                </div>

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group col-12 d-flex justify-content-between mt-3">
                    <button class="btn btn-outline-success btn-sm" type="submit"><i class="fas fa-save"></i> &nbsp;Gem</button>
                    <a class="btn btn-outline-info btn-sm" asp-action="Index" asp-route-eventtype="@Model.Event.EventType"><i class="fas fa-times"></i> &nbsp;Annuller</a>
                </div>

            </form>

        </div>

        <div class="col-md-6 col-12">

            <div class="row">
                <div class="col">
                    <h5><i class="fas fa-user-plus mr-2"></i>Tilmeld bruger til tur</h5>

                    <form method="post" asp-action="AddUserToEvent" asp-route-eventId="@Model.Event.Id">

                        <div class="form-group input-group">
                            <select type="text" class="form-control selectpicker" name="userId" id="userId" asp-items="Model.UsersList" data-live-search="true" data-style="btn btn-outline-light text-dark border rounded" onchange="checkSelectedUserForEvent()">
                                <option value="-1">Vælg bruger...</option>
                            </select>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" name="doCreateAccountTransaction" type="checkbox" id="doCreateAccountTransaction_checkbox" value="true" />
                            <label class="form-check-label" for="doCreateAccountTransaction_checkbox">Træk beløb fra turkonto</label>
                        </div>

                        <div class="text-right my-3">
                            <button type="submit" id="addUserToEventButton" class="btn btn-sm btn-outline-success" disabled><i class="fas fa-user-plus"></i>&nbsp;Tilmeld bruger</button>
                        </div>

                    </form>

                </div>

            </div>

            <div class="row">
                <div class="col">

                    <h5><i class="fas fa-users"></i>&nbsp;Tilmeldinger</h5>

                    <a asp-action="FixedUser" asp-route-isadding="true" asp-route-eventid="@Model.Event.Id" class="btn btn-sm text-info" title="Spær en plads"><i class="fas fa-user-plus"></i></a>

                    <div class="card-group">

                        <div class="card">

                            <div class="card-header justify-content-between">
                                Reserveret
                            </div>

                            <div class="card-body">
                                @for (int i = 0; i < Model.Event.FixedParticipants; i++)
                                {
                                    <a asp-action="FixedUser" asp-route-isadding="false" asp-route-eventid="@Model.Event.Id" class="btn btn-outline-info btn-sm form-control mb-1 small text-left">
                                        <i class="fas fa-user-minus mr-2 "></i>Dk Diver
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="card">

                            <div class="card-header">Tilmeldte</div>

                            <div class="card-body">
                                @foreach (var item in Model.Event.Participants)
                                {
                                    <a class="btn btn-outline-danger btn-sm mb-1 form-control small text-left ellipsis" asp-action="RemoveUserFromEvent" asp-route-eventId="@Model.Event.Id" asp-route-userid="@item.ApplicationUserId" title="Fjern bruger fra tur og returner betaling">
                                        <i class="fas fa-user-minus mr-2"></i>@item.ApplicationUser.Name
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                </div>

            </div>



        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function checkSelectedUserForEvent() {

            var selectedUserId = $("#userId").val();

            document.getElementById("addUserToEventButton").disabled = selectedUserId == "-1";

        }

        function SynchWithControl(e, obj) {
            var control = $("#" + obj);
            if (control != undefined) {
                control.val = e.val;
            } else {
                console.log(obj + " is not found")
            }
        }
    </script>
}
