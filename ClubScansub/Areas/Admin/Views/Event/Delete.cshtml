@model Event
@{
    ViewData["Title"] = "Admin - Begivenhed - Annuler";
    var canBeDeleted = (Model.Participants.Count() == 0 && Model.ExternalClubMembers.Count() == 0);
}
<div class="container">
    <div class="row d-flex justify-content-between mb-2">
        <div class="col-6">
            <h3 class="display-4">Aflys begivenhed ?</h3>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row mb-3 p-3 d-flex justify-content-between">

            <div class="col-6">
                <h4>@Model.Title</h4>
                <small>@Model.StartDateAndTime.ToLongDateString() kl. @Model.StartDateAndTime.ToShortTimeString()</small>
                <br />
                <partial name="_SeatStatusPartial" model="@Model" />
                <div class="mt-3">@(string.IsNullOrEmpty(Model.Details) ? "Ingen beskrivelse" : Model.Details)</div>
            </div>
            <div class="col-4">
                 @await Component.InvokeAsync("Image", new { imageId = Model.Divelocation.Id, showThumbnail = true })
            </div>
@*            <div class="col-3">

                <ul class="list-group small">
                    <li class="list-group-item bg-light small"><h6 class="text-muted">Tilmeldte:</h6></li>
                    @foreach (var user in Model.Participants)
                    {
                        <li class="list-group-item">
                            <i class="fas fa-user-check text-success mr-2"></i>@user.ApplicationUser.ShortName
                        </li>
                    }
                    @foreach (var user in Model.ExternalClubMembers)
                    {
                        <li class="list-group-item">
                            <i class="fas fa-user-check text-success mr-2"></i>@user.ApplicationUser.ShortName
                        </li>
                    }
                </ul>

            </div>*@
        </div>
        <div class="row d-flex justify-content-between">
            <div class="col-auto">
                <a asp-action="Index" asp-route-eventtype="@Model.EventType" class="btn btn-outline-success form-control"><i class="fas fa-undo mr-2"></i>Tilbage</a>
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-outline-danger form-control"><i class="fas fa-times mr-2"></i>Aflys begivenhed</button>
            </div>

            <div class="col">
                @if (canBeDeleted) {
                    <a asp-action="CompleteDelete" asp-controller="Event" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-danger form-control"><i class="fas fa-trash mr-2"></i>Slet fra kalenderen</a>
                 }
            </div>


        </div>
    </form>
</div>

