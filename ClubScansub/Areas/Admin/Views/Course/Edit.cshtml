@model Course
@{
    ViewData["Title"] = "Administrer kursus";
}

<div class="justify-content-between">
    <h1 class="display-4">@Model.CourseName d. @Html.FormatValue(Model.StartDateAndTime, "{0:d}")</h1>
</div>


<div class="container">
    <div class="row">

        <div class="col-md-6 col-12">
            <h5><i class="fas fa-calendar-alt"></i>&nbsp;Detaljer</h5>

            <form method="post">

                <input type="hidden" asp-for="Id"/>
                <input type="hidden" asp-for="EventType" />
                <input type="hidden" asp-for="EndDateAndTime" />

                <div class="form-group input-group col-12 btn b">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Type:</span>
                    </div>
                    <input type="text" class="form-control" asp-for="CourseType" readonly />
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Titel</span>
                    </div>
                    <input type="text" class="form-control" asp-for="CourseName" id="title" autocomplete="off" />
                </div>

                <div class="form-group input-group col-9">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Start:</span>
                    </div>
                    <input type="date" class="form-control" readonly asp-for="StartDateAndTime" placeholder="" />
                </div>

                <div class="form-group d-flex justify-content-between">

                    <div class="input-group  col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Min:</span>
                        </div>
                        <input type="number" class="form-control" asp-for="MinParticipants" />
                    </div>

                    <div class="input-group mr-2 col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Max:</span>
                        </div>
                        <input type="number" class="form-control" asp-for="MaxParticipants" />
                    </div>
                </div>

                <div class="form-group input-group col-6">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Pris:</span>
                    </div>
                    <input class="form-control" asp-for="Price" />
                </div>

                <div class="form-group col-12 d-flex justify-content-between mt-3">
                    <button class="btn btn-outline-success" type="submit"><i class="fas fa-save"></i> &nbsp;Gem</button>
                    <a class="btn btn-outline-info" asp-action="Index" asp-route-eventtype="@Model.EventType"><i class="fas fa-times"></i> &nbsp;Annuller</a>
                </div>

            </form>
        </div>

        <div class="col-md-6 col-12">
            <div class="row justify-content-between mb-1">
                <div class="col">
                    <h5><i class="fas fa-users"></i>&nbsp;Tilmeldinger</h5>
                </div>
            </div>

            <ul class="list-group">
                @if (Model.Participants.Count() == 0 && Model.FixedParticipants == 0 && Model.Signups.Count() == 0)
                {
                    <li class="list-group-item m-1 col">
                        <span class="btn btn-outline-dark ">
                            <i class="fas fa-ban"></i>&nbsp;Ingen tilmeldinger
                        </span>
                    </li>

                }
                else
                {
                    <li class="list-group-item col">
                        Skrevet op:
                    </li>
                    foreach (var item in Model.Signups)
                    {
                        <li class="list-group-item col">
                            <a class="btn btn-outline-success btn-sm" asp-action="AddUserToCourse" asp-route-courseId="@Model.Id" asp-route-userid="@item.ApplicationUserId" title="Tilmeld bruger og træk betaling fra Kursus konto">
                                <i class="fas fa-user-plus"></i>&nbsp;@item.ApplicationUser.Name
                            </a>
                        </li>
                    }
                    <li class="list-group-item col">
                        Tilmeldte:
                    </li>
                    foreach (var item in Model.Participants)
                    {
                        <li class="list-group-item col">
                            <a class="btn btn-outline-danger btn-sm" asp-action="RemoveUserFromCourse" asp-route-courseId="@Model.Id" asp-route-userid="@item.ApplicationUserId" title="Fjern bruger fra kursus og returner betaling">
                                <i class="fas fa-user-minus"></i>&nbsp;@item.ApplicationUser.Name
                            </a>
                        </li>
                    }
                }
            </ul>

        </div>
    </div>
    <h5 class="mt-3 mb-2">Kursus dage</h5>
    @foreach (var item in Model.CourseSessions)
    {
<div class="row d-flex justify-content-between m-2 border-top">
    <div class="col-2 small">
            @item.DateTime.ToString("dd. MMMM yyyy") 
        <br />
        <p class="small text-muted">
            fra kl. @item.DateTime.ToString("HH:mm")
            til kl. @item.DateTime.Add(item.Duration).ToString("HH:mm") (ca.)
        </p>
    </div>
    <div class="col-2 small">
        @item.CourseSessionTemplate.Name<br />
        <span class="small text-muted"> @item.CourseSessionTemplate.Description</span>
    </div>
    <div class="col small">
        @if (item.Address != null)
        {
            @item.Address.Name
            <p class="small text-muted">
                @item.Address.Streetname<br />
                @item.Address.Zipcode  @item.Address.City <br />
                @item.Address.Country
            </p>
        }
        else
        {
            <p class="small">Ingen adresse angivet</p>
        }
    </div>

    <div class="col-4 pt-2">
        <p class="small text-muted">Instruktører:</p>
        <partial name="~/Areas/Divepro/Views/Shared/_InstructorSignups.cshtml" model="@item.SessionInstructors" />
    </div>
</div>
    }
</div>

