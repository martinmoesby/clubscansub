@model ClubScansub.Areas.Admin.Controllers.CourseController.PageModel
@{
    ViewData["Title"] = "Administrer kursus";
}

<partial name="_StatusMessage" model="@ViewBag.StatusMessage" />

<div class="container">
    <h1 class="display-4 mb-4">@Model.Course.CourseName d. @Html.FormatValue(Model.Course.StartDateAndTime, "{0:d}")</h1>

    <div class="row mb-3">

        <div class="col-md-6 col-12">
            <h5><i class="fas fa-info-circle"></i>&nbsp;Kursus</h5>

            <form method="post">

                <input type="hidden" asp-for="Course.Id" />
                <input type="hidden" asp-for="Course.EventType" />

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Type:</span>
                    </div>
                    <input type="text" class="form-control" asp-for="Course.CourseType" readonly />
                </div>

                <div class="form-group input-group col-12">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Titel</span>
                    </div>
                    <input type="text" class="form-control" asp-for="Course.CourseName" id="title" autocomplete="off" />
                </div>

                <div class="form-group input-group col-9">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Start:</span>
                    </div>
                    <input type="datetime-local" class="form-control" asp-for="Course.StartDateAndTime" placeholder="" />
                </div>
                
                <div class="form-group input-group col-9">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Slut:</span>
                    </div>
                    <input type="datetime-local" class="form-control" asp-for="Course.EndDateAndTime" placeholder="" />
                </div>

                <div class="form-group d-flex justify-content-between">

                    <div class="input-group  col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Min:</span>
                        </div>
                        <input type="number" class="form-control" asp-for="Course.MinParticipants" />
                    </div>

                    <div class="input-group mr-2 col-6">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="width:120px;">Max:</span>
                        </div>
                        <input type="number" class="form-control" asp-for="Course.MaxParticipants" />
                    </div>
                </div>

                <div class="form-group input-group col-6">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="width:120px;">Pris:</span>
                    </div>
                    <input class="form-control" asp-for="Course.Price" />
                </div>

                <div class="form-group col-12 d-flex justify-content-between mt-3">
                    <button class="btn btn-outline-success btn-sm" type="submit"><i class="fas fa-save"></i> &nbsp;Gem</button>
                    <a class="btn btn-outline-info btn-sm" asp-action="Index" asp-route-eventtype="@Model.Course.EventType"><i class="fas fa-times"></i> &nbsp;Annuller</a>
                </div>

            </form>
        </div>

        <div class="col-md-6 col-12">

            <div class="row">
                <div class="col">

                    <h5><i class="fas fa-user-plus"></i>&nbsp;Tilmeld bruger</h5>

                    <form method="post" asp-action="AddUserToCourse" asp-route-courseId="@Model.Course.Id">

                        <div class="form-group input-group">
                            <select type="text" class="form-control selectpicker" name="userId" id="userId" asp-items="Model.UsersList" data-live-search="true" data-style="btn btn-outline-light text-dark border rounded" onchange="checkSelectedUserForCourse()">
                                <option value="-1">Vælg bruger...</option>
                            </select>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" name="doCreateAccountTransaction" type="checkbox" id="doCreateAccountTransaction" value="true" />
                            <label class="form-check-label" for="doCreateAccountTransaction">Træk beløb fra kursuskonto</label>
                        </div>

                        <div class="text-right my-3">
                            <button type="submit" class="btn btn-sm btn-outline-success" disabled id="addUserToCourseButton"><i class="fas fa-user-plus mr-2"></i>Tilmeld bruger</button>
                        </div>
                    </form>
                </div>

            </div>

            <div class="row">
                <div class="col">
                    <h5><i class="fas fa-users"></i>&nbsp;Tilmeldinger</h5>
                    <div class="card-group">

                        <div class="card">

                            <div class="card-header">Skrevet op</div>

                            <div class="card-body">
                                @foreach (var item in Model.Course.Signups)
                                {
                                    <a class="btn btn-sm m-1 btn-outline-success" asp-action="AddUserToCourse" asp-route-doCreateAccountTransaction="true" asp-route-courseId="@Model.Course.Id" asp-route-userid="@item.ApplicationUserId" title="Tilmeld bruger og træk betaling fra Kursus konto">
                                        <i class="fas fa-user-plus"></i>&nbsp;@item.ApplicationUser.Name
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="card">

                            <div class="card-header">Tilmeldte</div>

                            <div class="card-body">
                                @foreach (var item in Model.Course.Participants)
                                {
                                    <a class="btn btn-sm m-1 btn-outline-danger" asp-action="RemoveUserFromCourse" asp-route-courseId="@Model.Course.Id" asp-route-userid="@item.ApplicationUserId" title="Fjern bruger fra kursus og returner betaling">
                                        <i class="fas fa-user-minus"></i>&nbsp;@item.ApplicationUser.Name
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="col-12 justify-content-between">
        <h5><i class="fas fa-calendar-alt mr-2"></i>Kursus dage</h5>
        <button class="btn btn-sm btn-outline-primary" onclick="addSession(@Model.Course.Id)"><i class="fas fa-plus mx-1"></i>Tilføj kursusdag</button>
    </div>

    @foreach (var item in Model.Course.CourseSessions.OrderBy(x=>x.DateTime))
    {
        <div class="row d-flex justify-content-between m-2 border-top">
            <div class="col-2 small">
                <p>
                    <i class="fas fa-calendar-day mr-2"></i>@item.DateTime.ToString("dd. MMMM yyyy")
                </p>
                <p class="small text-muted">
                    fra kl. @item.DateTime.ToString("HH:mm")
                    til kl. @item.DateTime.Add(item.Duration).ToString("HH:mm") (ca.)
                </p>
            </div>

            <div class="col-2 small">
                <p>@item.SessionName</p>
                <span class="small text-muted"> @item.SessionDescription</span>
            </div>

            <div class="col-2 small">
                <p>Adresse:</p>
                @if (item.Address != null)
                {
                    <p class="small text-muted">
                        @item.Address.Name
                        @item.Address.Streetname<br />
                        @item.Address.Zipcode  @item.Address.City <br />
                        @item.Address.Country
                    </p>
                }
                else
                {
                    <p class="small text-muted">Ingen adresse angivet</p>
                }
            </div>

            <div class="col-4 small">
                <p>Instruktører:</p>
                <partial name="~/Areas/Divepro/Views/Shared/_InstructorSignups.cshtml" model="@item.SessionInstructors" />
            </div>

            <div class="col pt-2 text-right">
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-sm btn-outline-primary" onclick="editSession(@item.Id)"><i class="fas fa-edit mx-1"></i></button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteSession(@item.Id)"><i class="fas fa-trash-alt mx-1"></i></button>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>

    function checkSelectedUserForCourse() {

        var selectedUserId = $("#userId").val();

        document.getElementById("addUserToCourseButton").disabled = selectedUserId == "-1";

    }

    var sessionDetails = '@Url.Action("GetSession", "Course", new { Area = "Admin" })';

        function addSession(id) {
        $.ajax({
            type: "GET",
            url: '@Url.Action("AddSession", "Course", new { Area = "Admin" })',
            contentType: "application/json;charset=utf-8",
            data: { "id": id },
            cache: false,
            datatype: "json",
            success: function (data) {
                $(".modal-header").removeClass("bg-danger").removeClass("bg-success").removeClass("bg-light").removeClass("bg-info").addClass("bg-success");
                $("#myModalTitle").text("Tilføj kursusdag");
                $("#myModalContent").html(data);
                $("#myModal").modal('show');
            },
            error: function () {
                $(".modal-header").removeClass("bg-danger").removeClass("bg-success").removeClass("bg-light").removeClass("bg-info").addClass("bg-danger");
                $("#myModalTitle").text("Fejl");
                $("#myModalContent").html("Der opstod en fejl. Prøv igen senere");
                $("#myModal").modal('show');
            }
        });
    }

    function editSession(id) {
        $.ajax({
            type: "GET",
            url: sessionDetails,
            contentType: "application/json;charset=utf-8",
            data: { "Id": id, "isDelete" : false },
            cache: false,
            datatype: "json",
            success: function (data) {
                $(".modal-header").removeClass("bg-danger").removeClass("bg-success").removeClass("bg-light").removeClass("bg-info").addClass("bg-info");
                $("#myModalTitle").text("Rediger kursusdag");
                $("#myModalContent").html(data);
                $("#myModal").modal('show');
            },
            error: function () {
                $(".modal-header").removeClass("bg-danger").removeClass("bg-success").removeClass("bg-light").removeClass("bg-info").addClass("bg-danger");
                $("#myModalTitle").text("Fejl");
                $("#myModalContent").html("Der opstod en fejl. Prøv igen senere");
                $("#myModal").modal('show');
            }
        });
    }

    function deleteSession(id) {
        $.ajax({
            type: "GET",
            url: sessionDetails,
            contentType: "application/json;charset=utf-8",
            data: { "Id": id, "isDelete": true },
            cache: false,
            datatype: "json",
            success: function (data) {
                $(".modal-header").removeClass("bg-danger").removeClass("bg-success").removeClass("bg-light").removeClass("bg-info").addClass("bg-danger");
                $("#myModalTitle").text("Slet kursus dag?");
                $("#myModalContent").html(data);
                $("#myModal").modal('show');

            },
            error: function () {
                $(".modal-header").removeClass("bg-danger").removeClass("bg-success").removeClass("bg-light").removeClass("bg-info").addClass("bg-danger");
                $("#myModalTitle").text("Fejl");
                $("#myModalContent").html("Der opstod en fejl. Prøv igen senere");
                $("#myModal").modal('show');
            }
        });
    }
    </script>
}