@model IEnumerable<Course>
@{
    ViewData["Title"] = "Admin - Kurser";
    var pageTitle = ViewBag.PageTitle;

}
<partial name="_StatusMessage" model="@ViewBag.StatusMessage" />
<div class="container">

    <h1 class="display-4 text-info mb-3 text-nowrap">@pageTitle</h1>

    @if (Model.Count() == 0)
    {
        <h4 class="text-info mb-3">Ingen Kurser</h4>
        <p>Brug <a asp-action="Planner" asp-controller="Home" asp-area="Admin" class="btn btn-sm btn-outline-primary mr-2"><i class="fas fa-calendar-alt mr-2"></i>Planner</a>for at planlægge et nyt kursus</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th class="align-top">
                        <label asp-for="@Model.First().Id"></label>
                    </th>
                    <th class="align-top">
                        <label asp-for="@Model.First().CourseName"></label>
                    </th>
                    <th class="align-top">
                        <label>Kursus start</label>
                    </th>
                    <th class="align-top">
                        <label>Kursus slut</label>
                    </th>
                    <th class="align-top">
                        <label>Tilmeldte</label>
                        <br />
                        <small>(skrevet op / tilmeldt)</small>
                    </th>
                    <th class="align-top"><label>Kursus dage</label></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(x => x.StartDateAndTime))
                {
                    <tr>
                        <td class="small">@item.Id</td>
                        <td class="small">@item.CourseName</td>
                        <td class="small">@item.StartDateAndTime.ToString("dd-MM-yyyy HH:mm")</td>
                        <td class="small">@item.EndDateAndTime.ToString("dd-MM-yyyy HH:mm")</td>
                        <td class="small">(@item.Signups.Count / @item.Participants.Count) af @item.MinParticipants - @item.MaxParticipants</td>
                        <td class="small">@item.CourseSessions.Count</td>
                        <td class="small">
                            @if (!item.IsCancelled)
                            {
                                <partial name="_EditDetailsDeleteButtonsPartial" model="@item.Id" />
                            }
                            else
                            {
                                <span class="text-danger"><i class="fas fa-ban"></i>&nbsp;Aflyst</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="row">

        <div class="col-4">
            @if (ViewBag.IsCompleteCourses)
            {
                <a class="btn btn-sm btn-outline-success" asp-action="Index" asp-route-coursetype="@ViewBag.CourseType">Se aktive...</a>
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="CompletedCourseIndex" asp-route-coursetype="@ViewBag.Coursetype">Se afsluttede...</a>
            }
        </div>

    </div>
</div>