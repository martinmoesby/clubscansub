@model IEnumerable<UserCertificat>
@{
    ViewData["Title"] = "Mine certifikater";
}
<div class="container">

    <h1 class="display-4 mb-3"><i class="fas fa-calendar"></i>&nbsp;@ViewData["Title"]</h1>

    <table class="table table-sm">
        <thead>
            <tr>
                <th class="small">Udstedt d.</th>
                <th class="small">Certifikat</th>
                <th class="small">Navn</th>
                <th class="small">Forside</th>
                <th class="small">Bagside</th>
                <th class="small"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cert in Model)
            {
                <tr>
                    <td class="small">@cert.IssuedDate.ToLongDateString()</td>
                    <td class="small">@cert.Certificate.ShortName</td>
                    <td class="small">@cert.Certificate.Name</td>
                    <td class="small">
                        @if (cert.FrontSideImage != null)
                        {
                            <img src="@( $"data:image;base64,{Convert.ToBase64String(cert.FrontSideImage)}")" class="img-fluid img-thumbnail rounded" style="height:100px;" />
                        }
                    </td>
                    <td class="small">
                        @if (cert.BackSideImage != null)
                        {
                            <img src="@( $"data:image;base64,{Convert.ToBase64String(cert.BackSideImage)}")" class="img-fluid img-thumbnail rounded" style="height:100px;" />
                        }
                    </td>
                    <td class="small">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-controller="Certificate" asp-area="Members" class="btn btn-outline-primary text-primary btn-sm" asp-route-id="@cert.Id.ToString()"><i class="fas fa-edit"></i></a>
                            @*<a asp-action="Details" class="btn btn-outline-success text-success" asp-route-id="@Model"><i class="fas fa-list-alt"></i></a>*@
                            <a asp-action="Delete" asp-controller="Certificate" asp-area="Members" class="btn btn-outline-danger text-danger btn-sm" asp-route-id="@cert.Id.ToString()"><i class="fas fa-trash-alt"></i></a>
                        </div>
                    </td>
                </tr>

            }
        </tbody>
    </table>

</div>
