@model IEnumerable<Event>  
@{
    ViewData["Title"] = "Mine kommende ture";
}
    <div class="container">

        <h1 class="display-4 mb-3"><i class="fas fa-calendar-alt"></i>&nbsp;@ViewData["Title"]</h1>

        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th><label asp-for="FirstOrDefault().StartDateAndTime"></label></th>
                    <th><label asp-for="FirstOrDefault().EndDateAndTime"></label></th>
                    <th><label asp-for="FirstOrDefault().Title"></label></th>
                    <th><label asp-for="FirstOrDefault().Price"></label></th>
                    <th><label>Tur status</label></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="small">@item.StartDateAndTime.ToShortDateString() kl. @item.StartDateAndTime.ToShortTimeString()</td>
                        <td class="small">@item.EndDateAndTime.ToShortDateString() kl. @item.EndDateAndTime.ToShortTimeString()</td>
                        <td>
                            <strong>@item.Title</strong><br />
                            <span class="small">@item.Details</span><br />
                            <partial name="_SeatStatusPartial" model="@item" />

                        </td>
                        <td class="small">@Html.FormatValue(item.Price, "{0:n2}")</td>
                        <td>
                            @if (item.RequiredSpots > 0)
                            {
                                <span class="badge badge-warning"><i class="fas fa-thumbs-down"></i>&nbsp;Ikke nok tilmeldte</span>
                            }
                            else
                            {
                                <span class="badge badge-success small"><i class="fas fa-thumbs-up"></i>&nbsp;Nok tilmeldte</span>
                            }
                            <br />
                            <span class="small">Deltagere: @(item.FixedParticipants + item.Participants.Count)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

