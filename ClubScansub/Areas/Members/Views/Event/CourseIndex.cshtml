@model IEnumerable<Course>
@using ClubScansub.Extensions
@{
    ViewData["Title"] = "Mine Kurser";
}
<div class="container">

    <h1 class="display-4 mb-3 text-info"><i class="fas fa-calendar-alt"></i>&nbsp;@ViewData["Title"]</h1>

    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th><label>Kursus navn</label></th>
                <th><label asp-for="FirstOrDefault().StartDateAndTime"></label></th>
                <th><label asp-for="FirstOrDefault().EndDateAndTime"></label></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <button class="btn btn-outline-primary btn-sm" type="button" aria-expanded="false" aria-controls="collapseExample"
                                data-toggle="collapse" data-target="@($"#collapse{item.Id.ToString()}")" title="Klik for at se yderligere detaljer">
                            <i class="fas fa-exclamation-circle"></i>
                        </button>
                        @if (item.Participants.Select(x => x.ApplicationUserId).Contains(User.GetIdentityId()))
                        {
                            <i class="mr-2 fas fa-user-check text-success" title="Du er blevet tilmeldt dette kursus"></i><strong>@item.CourseName</strong>
                        }
                        else
                        {
                            <i class="mr-2 fas fa-user text-warning" title="Du er blevet skrevet op til dette kursus"></i><strong>@item.CourseName</strong>
                        }

                    </td>
                    <td class="small">@item.CourseSessions.Min(x => x.DateTime).ToShortDateString() kl. @item.CourseSessions.Min(x => x.DateTime).ToShortTimeString()</td>
                    <td class="small">@item.CourseSessions.Max(x => x.DateTime).ToShortDateString() kl. @item.CourseSessions.Max(x => x.DateTime.Add(x.Duration)).ToShortTimeString()</td>
                </tr>
                <tr>
                    <td colspan="3" class="w-100">
                        <div class="card collapse" id="@($"collapse{item.Id.ToString()}")">
                            <div class="card-header text-muted">Kursus sessioner</div>
                            <div class="card-body">
                                @foreach (var session in item.CourseSessions)
                                {
                                    <div class="row mb-1 border-bottom p-2">
                                        
                                        <div class="col-md-6 col-12">

                                            <strong>@session.CourseSessionTemplate.Name</strong>
                                            <br />
                                            <span class="small text-muted">@session.CourseSessionTemplate.Description</span>
                                        
                                        </div>

                                        <div class="col-md-3 col-6 small text-muted ">

                                            <span class="text-dark"><strong>@session.CourseSessionTemplate.Address?.Name</strong></span>
                                            <br />
                                            <span class="text-muted">
                                                D. @session.DateTime.ToShortDateString() kl. @session.DateTime.ToShortTimeString() til @session.DateTime.Add(session.Duration).ToShortTimeString()
                                            </span>

                                        </div>
                                        @if (session.Sessiontype != ClubScansub.Utility.CourseSessionTypeEnum.AcademicSession)
                                        {
                                            <div class="col-md-2 col-6 small text-muted text-right"><a class="btn btn-sm btn-outline-info" asp-action="GetRoute" asp-route-CourseSessionId="@session.Id"><i class="fas fa-map-marked-alt"></i>&nbsp;Find rute</a></div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

