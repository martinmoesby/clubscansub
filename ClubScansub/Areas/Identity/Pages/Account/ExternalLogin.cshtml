@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>
<h4>Tilknyt din @Model.LoginProvider konto</h4>
<hr />

<p class="text-info">
    Du er blevet logget på med <strong>@Model.LoginProvider</strong>.
    Udfyld formularen  og tryk på 'Gem' for at færdiggøre din registrering
</p>

<div class="row">
    <div class="col-md-9">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row">

                <div class="col-4">

                    <div class="form-group row input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.UserName" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.UserName" readonly class="form-control" />
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>

                    <div class="form-group row input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.Email" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>

                    </div>

                    <div class="form-group row input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.PhoneNumber" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group row">
                        <div class="col-4 offset-4">
                            <img src="@Model.Input.PhotoUrl" class="border rounded rounded-circle" />
                            <input type="hidden" asp-for="Input.PhotoUrl" />
                        </div>
                    </div>

                </div>

                <div class="col-5">

                    <div class="form-group input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.Firstname" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.Firstname" class="form-control" />
                        <span asp-validation-for="Input.Firstname" class="text-danger"></span>
                    </div>

                    <div class="form-group input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.Lastname" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.Lastname" class="form-control" />
                        <span asp-validation-for="Input.Lastname" class="text-danger"></span>
                    </div>

                    <div class="form-group input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.Streetaddress" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.Streetaddress" class="form-control" />
                        <span asp-validation-for="Input.Streetaddress" class="text-danger"></span>
                    </div>

                    <div class="form-group input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.PostalCode" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.PostalCode" class="form-control" />
                        <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                    </div>

                    <div class="form-group input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.City" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.City" class="form-control" />
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>

                    <div class="form-group input-group">
                        <div class="input-group-prepend">
                            <label asp-for="Input.Country" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.Country" class="form-control" />
                        <span asp-validation-for="Input.Country" class="text-danger"></span>
                    </div>

                </div>

            </div>
            <div class="form-group">
                <div class="col-9 d-flex justify-content-end">
                    <a role="button" class="col-3 btn btn-outline-danger form-control" asp-action="Index" asp-controller="Home" asp-area=""><i class="fas fa-save"></i>&nbsp;Annuller</a>
                    <button type="submit" class="col-3 btn btn-outline-success form-control"><i class="fas fa-save"></i>&nbsp;Gem</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
