@page
@model RequestMembershipModel
@{
    ViewData["Title"] = "Bliv medlem";
}

<h1 class="display-4">@ViewData["Title"]</h1>

<div class="container">
    <form asp-route-returnUrl="@Model.ReturnUrl" method="post">


        <div class="row">

            <div class="col-md-8 col-12">

                <div class="form-group">
                    <h5 class="text-info">Personlige oplysninger</h5>
                </div>

                <div class="form-group form-group-sm">
                    <input asp-for="Input.Email" class="form-control form-control-sm" placeholder="Email adresse" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="form-group form-group-sm">
                            <input asp-for="Input.Firstname" class="form-control form-control-sm" placeholder="Fornavn(e)" />
                            <span asp-validation-for="Input.Firstname" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group form-group-sm">
                            <input asp-for="Input.Lastname" class="form-control form-control-sm" placeholder="Efternavn" />
                            <span asp-validation-for="Input.Lastname" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group form-group-sm">
                    <input asp-for="Input.Streetaddress" class="form-control form-control-sm" placeholder="Adresse" />
                    <span asp-validation-for="Input.Streetaddress" class="text-danger small"></span>
                </div>

                <div class="row">

                    <div class="col-4">
                        <div class="form-group form-group-sm">
                            <input asp-for="Input.PostalCode" class="form-control form-control-sm" placeholder="Postnr." />
                            <span asp-validation-for="Input.PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-8">
                        <div class="form-group form-group-sm">
                            <input asp-for="Input.City" class="form-control form-control-sm" placeholder="By" />
                            <span asp-validation-for="Input.City" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group form-group-sm">
                    <input asp-for="Input.Country" class="form-control form-control-sm" placeholder="Land" />
                    <span asp-validation-for="Input.Country" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-4">
                        <div class="form-group form-group-sm">
                            <input asp-for="Input.PhoneNumber" class="form-control form-control-sm" placeholder="Mobiltelefon" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group form-group-sm">
                            <input asp-for="Input.DayOfbirth" class="form-control form-control-sm" placeholder="Fødselsdag (yyyy-mm-dd)" type="date" title="Fødselsdato" />
                            <span asp-validation-for="Input.DayOfbirth" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="form-group form-group-sm">
                            <select asp-for="Input.Certificate" class="form-control form-control-sm" placeholder="Max. cert. dybde" type="text" >
                                <option value="0" selected>Max. cert. dybde</option>
                                <option value="12">Jr. OW. (12)</option>
                                <option value="18">Open Water (18)</option>
                                <option value="30">Adv. OW. (30)</option>
                                <option value="40">Deep (40)</option>
                                <option value="45">Ext. range (45)</option>
                                <option value="60">Tech. Ext. range (60)</option>
                                <option value="85">Hyp. Ext. range (85)</option>
                                <option value="100">Unlimited range (100+)</option>
                                </select>
                            <span asp-validation-for="Input.Certificate" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
                <div class="form-group form-group-sm">
                    <input type="checkbox" asp-for="Input.WithCopyToSelf" class="form-check form-check-inline" />
                    <label class="form-check-label small" asp-for="Input.WithCopyToSelf"></label>
                </div>

                <div class="form-group d-flex justify-content-between">

                    <button type="submit" class="btn btn-outline-success btn-sm form-control col-3"><i class="fas fa-envelope"></i>&nbsp;Send ansøgning</button>
                </div>
            </div>
        </div>


    </form>
    <p class="small text-black-50">
        Disse oplysninger er kun for at vi kan få dig korrekt oprettet i vores system. Dine oplysninger vil aldrig blive delt eller videresolgt til 3. part.<br />
        Oplysningerne vil blive brugt til at få dig oprettet i vores webshop på www.dkdiver.dk<br/>

    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
