@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Glemt kodeordet ??";
}
    <div class="container">
        <h1 class="display-4 mb-3">@ViewData["Title"]</h1>
        <h5 class="text-info"><i class="fas fa-envelope"></i>&nbsp;Skriv din email-adresse</h5>
        <p>- så sender vi dig en mail med information omkring hvordan du nulstiller dit kodeord.</p>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Input.Email"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-dark btn-sm"><i class="fas fa-mail-bulk"></i>&nbsp;Send information</button>
                </form>
            </div>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
    </div>