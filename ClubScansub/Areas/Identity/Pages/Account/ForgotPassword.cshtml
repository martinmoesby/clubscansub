@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Glemt kodeordet ??";
}
    <div class="container">
        <h1 class="display-4 mb-3">@ViewData["Title"]</h1>
        <h5 class="text-info"><i class="fas fa-envelope"></i>&nbsp;Skriv dit brugernummer</h5>
        <p>- så sender vi dig en mail med information omkring hvordan du nulstiller dit kodeord.</p>
        <hr />
        <div class="row">
            <div class="col-md-8">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group input-group form-group-sm form-group-sm">
                        <div class="input-group-prepend">
                            <label asp-for="Input.UserName" class="col-form-label input-group-text" style="width:150px;"></label>
                        </div>
                        <input asp-for="Input.UserName" class="form-control" autocomplete="off" />
                        <div class="input-group-append">
                            <label class="col-form-label input-group-text">@@scansub.dk</label>
                        </div>
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-dark btn-sm"><i class="fas fa-mail-bulk"></i>&nbsp;Send nulstilingsmail</button>
                </form>
            </div>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
    </div>