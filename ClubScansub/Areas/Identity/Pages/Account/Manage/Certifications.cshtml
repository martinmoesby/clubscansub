}

<div class="row justify-content-between">

    <h5><i class="fas fa-award"></i>&nbsp;Certificeringer</h5>
    @if (User.IsInRole(Userroles.User))
    {
        <a asp-action="Index" asp-controller="Certificate" asp-area="Members" class="btn btn-outline-info btn-sm"><i class="fas fa-award"></i>&nbsp;Certifikat-detaljer</a>
    }
</div>


<div class="row">

    <div class="form-group mt-4">
        <form method="post">
            <div class="input-group">
                <select class="form-control" asp-items="Model.Certificates" asp-for="SelectedCertificate"></select>
                <div class="input-group-append">
                    <button type="submit" class="btn btn-outline-info btn-sm input-group-btn"><i class="fas fa-plus mr-1"></i>Tilføj</button>
