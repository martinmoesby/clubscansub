@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
    <ul class="nav nav-pills flex-column w-75">
        <li class="nav-item mb-1"><a class="btn btn-outline-info nav-link text-left @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index" title="Håndtering af din profil"><i class="fas fa-user"></i>&nbsp;Profil</a></li>
        <li class="nav-item mb-1"><a class="btn btn-outline-info nav-link text-left @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword" title="Skifte kodeord - hvis du har en lokal konto"><i class="fas fa-key"></i>&nbsp;Kodeord</a></li>
        @if (hasExternalLogins)
        {
            <li id="external-logins" class="nav-item mb-1"><a id="external-login" class="btn btn-outline-info nav-link text-left @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins" title="Eksterne tilknyttede logins som Facebook eller Google+"><i class="far fa-handshake"></i>&nbsp;Eksterne konti</a></li>
        }
        @* <li class="nav-item mb-1"><a class="btn btn-outline-info nav-link text-left @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication" title="2 factor authentication"><i class="fas fa-user-lock"></i>&nbsp;Konto sikkerhed</a></li>*@
        <li class="nav-item mb-1"><a class="btn btn-outline-info nav-link text-left @ManageNavPages.CertificationsNavClass(ViewContext)" id="certifications-data" asp-page="./Certifications"><i class="fas fa-award"></i>&nbsp;Certificeringer</a></li>
        <li class="nav-item mb-1"><a class="btn btn-outline-info nav-link text-left @ManageNavPages.AccountBalanceNavClass(ViewContext)" id="accountbalance-data" asp-page="./AccountBalance" title="Se din turkonto balance og bevægelser "><i class="fas fa-coins"></i>&nbsp;Turkonto</a></li>
        <li class="nav-item mb-1"><a class="btn btn-outline-danger nav-link text-left @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData" title="Her kan du se de data vi har gemt og du kan slette din konto"><i class="fas fa-user-secret"></i>&nbsp;Slet konto?</a></li>

    </ul>
