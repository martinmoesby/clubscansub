@page
@model AccountBalanceModel
@{
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css" />
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row justify-content-between mb-3">
    <div class="col-5">
        <h5><i class="fas fa-coins"></i>&nbsp;Turkonto</h5>
    </div>
    <div class="col-5 text-right">
        <h6 class="btn btn-info btn-sm"><i class="fas fa-coins"></i>&nbsp;Balance: @Html.FormatValue(Model.ApplicationUser.Balance, "{0:n2}")</h6>
    </div>
</div>

<div class="overflow-auto">


    <table class="col-auto table small" id="transactionTable">
        <thead>
            <tr>
                <th>Dato</th>
                <th>Beskrivelse</th>
                <th>Fakt. nr.</th>
                <th>Tur/Begivenhed</th>
                <th>Beløb</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.AccountTransactions.OrderBy(x => x.PostingDate))
            {
                <tr>
                    <td>@Html.FormatValue(item.PostingDate.GetValueOrDefault(), "{0:yyyy-MM-dd}")</td>
                    <td>@item.Description</td>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.Event?.Title @item.Event?.StartDateAndTime</td>
                    <td>@item.Amount</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"></script>

    <script>

        $(document).ready(function () {
            $("#transactionTable").DataTable();
        });


    </script>
}