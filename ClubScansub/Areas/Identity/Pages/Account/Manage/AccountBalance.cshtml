@page
@model AccountBalanceModel
@{
}
<h5><i class="fas fa-coins"></i>&nbsp;Turkonto</h5>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="overflow-auto">
    @if (Model.AccountTransactions.Count() == 0)
    {
        <h6><i class="fas fa-coins"></i>&nbsp;Ingen transaktioner</h6>
        @if (!Model.ApplicationUser.OldAccountImported)
        {
            <a class="btn btn-outline-info nav-link text-left @ManageNavPages.ImportOldAccountNavClass(ViewContext)" id="importoldaccount-data" asp-page="./ImportAccount" title="Her kan du importere din turkonto fra den gamle kalender"><i class="fas fa-user-secret"></i>&nbsp;Importer turkonto</a>
        }
    }
    else
    {
        <table class="col-auto table small">
            <thead>
                <tr>
                    <td colspan="3">
                        <h6 class="btn btn-info btn-sm"><i class="fas fa-coins"></i>&nbsp;Balance: @Html.FormatValue(Model.ApplicationUser.Balance, "{0:n2}")</h6>
                    </td>
                </tr>
                <tr>
                    <th>Dato</th>
                    <th>Beskrivelse</th>
                    <th>Beløb</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.AccountTransactions)
                {
                    <tr>
                        <td>@item.PostingDate</td>
                        <td>@item.Description</td>
                        <td>
                            @item.Amount
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>