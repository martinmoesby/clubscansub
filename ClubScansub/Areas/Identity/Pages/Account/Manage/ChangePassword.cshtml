@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Skift kodeord";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h5 class="text-black"><i class="fas fa-key"></i>&nbsp;Kodeord</h5>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6 col-12">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group small">
                <label asp-for="Input.OldPassword"></label>
                <input asp-for="Input.OldPassword" class="form-control form-control-sm" />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
            <div class="form-group small">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" class="form-control form-control-sm" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group small">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control form-control-sm" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="col-auto btn btn-outline-success btn-sm"><i class="fas fa-save"></i>&nbsp;Opdater</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}