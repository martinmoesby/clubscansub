@page
@model IndexModel
@{
    ViewData["Title"] = "Min profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h5><i class="fas fa-user"></i>&nbsp;@ViewData["Title"]</h5>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row justify-content-between">

        <div class="form-group form-group-sm col-4 order-0">
            <label asp-for="Input.UserName" class="col-form-label-sm"></label>
            <input asp-for="Input.UserName" class="form-control form-control-sm text-black-50" readonly />
        </div>

        <div class="form-group form-group-sm col-4 order-0">
            @if (Model.IsEmailConfirmed)
            {
                <label class="col-form-label-sm" asp-for="Input.Email"></label>

                <div class="input-group">
                    <input asp-for="Input.Email" class="form-control form-control-sm" />
                    <span class="input-group-addon" aria-hidden="true"><span class="glyphicon glyphicon-ok text-success"></span></span>
                </div>
            }
            else
            {
                <label class="col-form-label-sm" asp-for="Input.Email"></label><button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link btn-sm">Send bekræftelses email</button>
                <div class="input-group">
                    <input asp-for="Input.Email" class="form-control form-control-sm" />
                </div>
                @**@
            }
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-6 order-5">

            @if (Model.IsPhoneNumberConfirmed)
            {
                <label asp-for="Input.PhoneNumber" class="col-form-label-sm"></label>
                <input asp-for="Input.PhoneNumber" class="form-control form-control-sm" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            }
            else
            {
                <label asp-for="Input.PhoneNumber" class="col-form-label-sm"></label><button id="phone-verification" type="submit" asp-page-handler="SendPhonenumberVerification" class="btn btn-link btn-sm">Send SMS</button>
                <input asp-for="Input.PhoneNumber" class="form-control form-control-sm" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            }


        </div>

        <div class="form-group form-group-sm col-4 order-0">
            <label asp-for="Input.AccountNumber" class="col-form-label-sm"></label>
            <input asp-for="Input.AccountNumber" class="form-control form-control-sm" />
            <span asp-validation-for="Input.AccountNumber" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-6 order-1">
            <label asp-for="Input.Firstname" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.Firstname" class="form-control form-control-sm" />
            <span asp-validation-for="Input.Firstname" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-6 order-1">
            <label asp-for="Input.Lastname" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.Lastname" class="form-control form-control-sm" />
            <span asp-validation-for="Input.Lastname" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-12 order-2">
            <label asp-for="Input.Streetaddress" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.Streetaddress" class="form-control form-control-sm" />
            <span asp-validation-for="Input.Streetaddress" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-4 order-3">
            <label asp-for="Input.PostalCode" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.PostalCode" class="form-control form-control-sm" />
            <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-8 order-3">
            <label asp-for="Input.City" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.City" class="form-control form-control-sm" />
            <span asp-validation-for="Input.City" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-12 order-4">
            <label asp-for="Input.Country" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.Country" class="form-control form-control-sm" />
            <span asp-validation-for="Input.Country" class="text-danger"></span>
        </div>

        <div class="form-group form-group-sm col-6 order-6">
            <label asp-for="Input.DayOfbirth" class="col-form-label-sm" style="width:150px;"></label>
            <input asp-for="Input.DayOfbirth" class="form-control form-control-sm" />
            <span asp-validation-for="Input.DayOfbirth" class="text-danger"></span>
        </div>
        <div class="form-group form-group-sm col-12 order-12 ">

            <button id="update-profile-button" type="submit" class="col-2 btn btn-outline-success btn-sm"><i class="fas fa-save"></i>&nbsp;Gem</button>

        </div>

    </div>

    <div class="row justify-content-between">
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}