@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsent" class="alert alert-info alert-dismissible fade show" role="alert">
        
        Vi bruger cookies for at kunne give dig den bedste oplevelse at sitet. Læs mere om vores cookie-politik <a asp-area="" asp-controller="Home" asp-action="Privacy">her</a>.
        
        <button type="button" id="cookie-decline" class="accept-policy close" data-dismiss="alert" aria-label="Close" data-cookie-string="@cookieString">
            <span aria-hidden="true"><i class="far fa-thumbs-up"></i></span>
        </button>

    </div>
    <script>
        (function () {
            var button = document.querySelector("#cookieConsent button[data-cookie-string]");
            button.addEventListener("click", function (event) {
                document.cookie = button.dataset.cookieString;
            }, false);

            //var declineButton = document.getElementById("cookie-decline");
            //declineButton.addEventListener("click", function () {
            //    window.Location = "https://www.duckduckgo.com";
            //}, false);

        })();


    </script>
}
