@model Event
@using Microsoft.EntityFrameworkCore;
@inject ClubScansub.Data.ApplicationDbContext db;
@{
    var currentUser = await db.ApplicationUsers
        .Include(x => x.Certificates).ThenInclude(x => x.Certificate)
        .Include(x => x.AccountTransactions)
        .FirstOrDefaultAsync(x => x.Id == User.GetIdentityId());
    bool isEligable = Model.RequiredCertificate == null;
    bool hasFunds = currentUser?.Balance >= Model.Price;
    var certName = "";
    if (currentUser != null && (Model.RequiredCertificate != null && currentUser.Certificates.Any(x => x.Certificate.Id == Model.RequiredCertificate.Id)))
    {
        isEligable = true;
        certName = Model.RequiredCertificate.ShortName;
    }

    var paymentNote = "";
    var paymentPrice = Model.Price;

    if (User.IsInRole(Userroles.Divepro) && Model.IsFreeForDivepros)
    {
        paymentNote = "(gratis for Divepros)";
        paymentPrice = 0;
    }
    else if (User.IsInRole(ClubScansub.Utility.Userroles.Member)) // (Model.EventType == EventTypeEnum.Other || Model.EventType == EventTypeEnum.Klubture) &&
    {
        paymentNote = "(Pris for Prem. medl.)";
        paymentPrice = Model.PremiumPrice;
    }
}
<div class="row mb-3">

    <div class="col-auto mr-3">
        <div class="d-flex justify-content-start flex-column">
            <h4 class="text-info small"><i class="far fa-calendar-alt"></i>&nbsp;@Model.StartDateAndTime.ToString("d MMM yyyy")</h4>
            <h4 class="text-info small"><i class="far fa-clock"></i>&nbsp;@Model.StartDateAndTime.ToString("HH:mm")</h4>
            <h4 class="text-info small"><i class="fas fa-coins"></i>&nbsp;&nbsp;@Html.FormatValue(paymentPrice, "{0:n2}") @paymentNote</h4>
            <h4 class="text-info small"><i class="fas fa-award"></i>&nbsp;@(Model.RequiredCertificate != null ? Model.RequiredCertificate.ShortName : "Ikke krævet")</h4>
            <h4>
                @if (Model.Participants.Count + Model.FixedParticipants == 0 || Model.IsCancelled)
                {
                <i class="fas fa-flag-checkered text-danger" title="Ingen tilmeldte"></i>
                }
                else if (Model.Participants.Count + Model.FixedParticipants < Model.MinParticipants)
                {
                <i class="fas fa-flag-checkered text-warning" title="Ikke nok tilmeldte"></i>
                }
                else
                {
                <i class="fas fa-flag-checkered text-success" title="Tilmeldte OK"></i>
                }
            </h4>

        </div>
    </div>

    <div class="col p-2">

        <div class="row mb-2">
            <div class="col-6">
                <h4>
                    @*<button data-toggle="collapse" data-target="#collapse" class="btn btn-outline-info d-inline" title="Klik for at se yderligere detaljer" type="button"><i class="fas fa-exclamation-circle"></i></button>*@
                    @Model.Divelocation?.Name
                </h4>
                <p>Dybde: @Model.Divelocation.MinDepth til @Model.Divelocation.MaxDepth m.</p>
                <div class="text-black-50 text-truncate font-weight-light small" style="max-width:250px;">@Model.Divelocation.Description</div>
            </div>
            <div class="col-4">
                @{if (Model.Divelocation.Image != null)
                    {
                        var imgSource = $"data:image;base64,{Convert.ToBase64String(Model.Divelocation.Image)}";
                    <img class="img-fluid rounded" src="@(imgSource)" alt="" />
                    }
                    else
                    {
                    <p class="small">Intet billede indlæst</p>
                    }
                }
            </div>
        </div>


        <div class="row">
            <span class="small text-info font-weight-light">Pladsstatus:</span>
        </div>

        <div class="row">
            <div class="badge badge-pill bg-light p-2">
                <partial name="_SeatStatusPartial" model="@Model" />

            </div>
        </div>

    </div>

    <div class="col-auto col-lg-auto text-right">
        @if (Model.IsCancelled)
        {
        <span class="rounded border border-secondary text-black-50 p-2 small">
            <i class="fas fa-ban mr-2" title="Turen er aflyst"></i>Turen er aflyst
        </span>

        }
        else if (Model.StartDateAndTime < DateTime.Now)
                {
        <span class="rounded border border-secondary text-black-50 p-2 small">
            <i class="fas fa-flag-checkered mr-2" title="Turen ar afsluttet"></i>Turen er afsluttet
        </span>
        } else if (User.Identity.Name != null && User.IsInRole(ClubScansub.Utility.Userroles.User))
            {

    if (Model.FreeSpots <= 0)
                {
        <span class="rounded border small border-dark text-black-50 p-2">
            <i class="fas fa-lightbulb mr-2" title="Turen er fyldt op"></i>Ikke flere pladser
        </span>
                }
                else if (Model.Participants.FirstOrDefault(x => x.ApplicationUserId == User.GetIdentityId()) != null)
                {
        <span class="rounded border border-success text-success p-2 small">
            <i class="fas fa-user-check mr-2" title="Du er tilmeldt denne tur - rigtig god fornøjelse"></i>Allerede tilmeldt
        </span>
                }
                else if (User.IsInRole(Userroles.Divepro) && Model.IsFreeForDivepros)
                {
        <a asp-action="Signup" class="btn btn-outline-success btn-sm" asp-route-id="@Model.Id" title="Tilmeld dig gratis">
            <i class="fas fa-user-plus mr-2"></i>Tilmeld dig gratis
        </a>
                @*}
                else if (Model.EventType == EventTypeEnum.Klubture && User.IsInRole(Userroles.Member))
                {
        <a asp-action="Signup" class="btn btn-outline-success btn-sm" asp-route-id="@Model.Id" title="Tilmeld dig gratis">
            <i class="fas fa-user-plus mr-2"></i>Gratis for Premium medlemmer
        </a>*@
                }
                else if (!hasFunds)
                {
        <span class="rounded border border-warning text-warning p-2 small">
            <i class="fas fa-exclamation-triangle mr-2" title="Du har ikke penge nok på din turkonto."></i>Lav turkonto
        </span>
                }

                else if (Model.Participants.FirstOrDefault(x => x.ApplicationUserId == User.GetIdentityId()) == null)
                {
                    if (!isEligable)
                    {
        <span><i class="rounded-circle bg-warning text-white p-2 fas fa-award" title="Du mangler det krævede certifikat"></i>&nbsp; @certName</span>
        <a asp-action="Signup" class="btn btn-outline-warning btn-sm small" asp-route-id="@Model.Id" title="Advarsel - du har ikke det krævede certifikat til denne tur, men tilmeld dig denne tur, hvis du har penge på turkontoen">
            <i class="fas fa-user-plus mr-2"></i>Certifikat mangler
        </a>
                    }
                    else
                    {
        <a asp-action="Signup" class="btn btn-outline-success btn-sm small" asp-route-id="@Model.Id" title="Tilmeld dig">
            <i class="fas fa-user-plus mr-2"></i>Tilmeld
        </a>
                    }
                }
                else
                {
        <span class="rounded border border-dark text-black-50 small p-2">
            <i title="Kan ikke afgøre tilstand" class="fas fa-question mr-2"></i>Ukendt tilstand
        </span>
                }
            }
            else
            {
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-info btn-sm small">
             <i title="Du skal være logget ind og medlem for at tilmelde dig" class="fas fa-sign-in-alt mr-2"></i>Login for at tilmelde
        </a>
            }
    </div>

</div>

<div class="mt-3 w-100">
    <div class="row d-flex justify-content-between mb-2">

        <div class="col-12 col-lg-4 order-lg-1">

            <div class="card">
                <div class="card-header">Mødetid og sted:</div>
                <div class="card-body small">

                    @Model.StartDateAndTime.ToLongDateString() kl. @Model.StartDateAndTime.ToShortTimeString()
                    <hr />
                    @if (@Model.Divelocation.MeetingLocation != null)
                    {
                    @Model.Divelocation.MeetingLocation.Name<br />
                    @Model.Divelocation.MeetingLocation.Streetname<br />

                    <span>@Model.Divelocation.MeetingLocation.Zipcode</span>

                    <span class="ml-2">@Model.Divelocation.MeetingLocation.City</span>

                    <input type="hidden" value="@Model.Divelocation.MeetingLocation.Latitude" id="latitude" />
                    <input type="hidden" readonly value="@Model.Divelocation.MeetingLocation.Longitude" id="longitude" />
                    }
                    else
                    {
                    <p>Ikke angivet mødested for Dykkerlokation</p>
                    }

                    <div id="meetLocationMap" class="rounded border map mt-2" style="height:300px;"></div>
                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4 order-lg-3">
            <div class="card">
                <div class="card-header">Deltagere:</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(User.Identity.Name))
                    {
                        if (Model.Participants.Count > 0 || Model.FixedParticipants > 0)
                        {
                            for (int i = 0; i < Model.FixedParticipants; i++)
                            {
                    <span class="p-2 small text-info"><i class="fas fa-user-check"></i>&nbsp;Dk Diver</span>
                    <br />
                            }

                            foreach (var user in Model.Participants)
                            {
                    <div class="row small justify-content-between">
                        <div class="col-6 text-success ellipsis">
                            <i class="fas fa-user-check"></i>&nbsp;@user.ApplicationUser.Name
                        </div>
                        @if (User.IsInRole(Userroles.Divepro))
                                    {
                        <div class="col-6 text-info ellipsis">
                            <i class="fas fa-phone mr-1"></i>@user.ApplicationUser.PhoneNumber
                        </div>
                                    }
                    </div>
                            }
                        }
                        else
                        {
                    <span class="p-2 text-danger small"><i class="fas fa-sad"></i>&nbsp;Ingen tilmeldte endnu</span>
                        }
                    }
                    else
                    {
                    <span class="p-2 text-info small"><i class="fas fa-sign-in-alt"></i>&nbsp;Log ind for at se tilmeldte</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8 order-lg-2">
            <div class="card">
                <div class="card-header">@Model.Divelocation.Name</div>
                <div class="card-body small">
                    @Model.Details<hr />

                    @Model.Divelocation.Description

                </div>
            </div>
            @if (User.IsInRole(Userroles.Administrator))
            {
            <div class="card mt-3">
                <div class="card-header">Deeplink</div>
                <div class="card-body small">
                    <input hidden type="text" id="deeplink" value="@Url.AbsoluteContent(Url.Action("DL", "Home", new { id = Model.DeeplinkId }))" readonly disabled />
                    <button class="btn btn-sm btn-outline-secondary mt-2" onclick="copyDeeplink()"><i class="fas fa-copy mr-2"></i>Kopier link</button>
                </div>
            </div>
            }
        </div>

    </div>
</div>

<script>
    function copyDeeplink() {
        /* Get the text field */
        var copyText = document.getElementById("deeplink");

        /* Select the text field */
        copyText.select();
        copyText.setSelectionRange(0, 99999); /*For mobile devices*/

        /* Copy the text inside the text field */
        document.execCommand("copy");


        /* Alert the copied text */
        alert("Copied the text: " + copyText.value);

        copyText.blur();

        if (window.getSelection) { // All browsers, except IE <=8
            window.getSelection().removeAllRanges();
        } else if (document.selection) { // IE <=8
            document.selection.empty();
        }

    }
</script>