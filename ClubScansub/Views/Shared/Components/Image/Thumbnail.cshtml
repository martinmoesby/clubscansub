@model ClubScansub.Models.DivelocationImage
@{
    var imgSource = $"data:image;base64,{Convert.ToBase64String(Model.ImageData)}";
    var imageId = Model.Id;
}

<div class="text-center">
    <img class="img rounded w-100 h-100" src="@imgSource" alt="Skjul billede" height="0" onclick="imageClick(@imageId)" style="cursor:zoom-in" />
</div>