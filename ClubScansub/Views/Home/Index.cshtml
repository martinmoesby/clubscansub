@model HomeIndexViewModel
@{
    ViewData["Title"] = "Klub kalender";
}

<link href='~/lib/fullCalendar/core/main.css' rel='stylesheet' />
<link href="~/lib/fullCalendar/bootstrap/main.css" rel="stylesheet" />
<link href='~/lib/fullCalendar/daygrid/main.css' rel='stylesheet' />
<link href="~/lib/fullCalendar/timegrid/main.css" rel="stylesheet" />
<link href="~/lib/fullcalendar/list/main.css" rel="stylesheet" />

<div class="container-fluid">
    <partial name="_StatusMessage" model="Model.Statusmessage" />

    <div class="row">
        <div class="d-inline-flex justify-content-start mb-3 mr-1 p-3 col">

                @*<div class="form-check form-check-inline p-2 rounded small">
                    <input class="form-check-input" type="checkbox" id="allevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="allcheckedChanged('events')">
                    <label class="form-check-label" for="allevents">Alle</label>
                </div>*@

                <div class="form-check form-check-inline bg-boat p-2 rounded small">
                    <input class="form-check-input events" type="checkbox" id="boatevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="eventsCheckedChanged('boat')">
                    <label class="form-check-label" for="boatevents">Bådture</label>
                </div>

                <div class="form-check form-check-inline bg-beach p-2 rounded small">
                    <input class="form-check-input events" type="checkbox" id="beachevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="eventsCheckedChanged('beach')">
                    <label class="form-check-label" for="beachevents">Stranddyk</label>
                </div>

                <div class="form-check form-check-inline bg-club p-2 rounded small">
                    <input class="form-check-input events" type="checkbox" id="clubevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="eventsCheckedChanged('club')">
                    <label class="form-check-label" for="clubevents">Klubture</label>
                </div>

                <div class="form-check form-check-inline bg-other p-2 rounded small">
                    <input class="form-check-input events" type="checkbox" id="otherevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="eventsCheckedChanged('other')">
                    <label class="form-check-label" for="otherevents">Andet</label>
                </div>

                @*</div>

        <div class="d-flex justify-content-start mb-3 mr-1 p-3 border rounded col-2">*@
                <div class="form-check form-check-inline bg-travel p-2 rounded small">
                    <input class="form-check-input events" type="checkbox" id="travelevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="eventsCheckedChanged('travel')">
                    <label class="form-check-label" for="travelevents">Rejser</label>
                </div>

                <div class="form-check form-check-inline bg-liveaboard p-2 rounded small">
                    <input class="form-check-input events" type="checkbox" id="liveaboardevents" @(Model.CalendarType == "trips" ? "checked" : "") onchange="eventsCheckedChanged('liveaboard')">
                    <label class="form-check-label" for="liveaboardevents">Liveaboards</label>
                </div>

        </div>

        <div class="d-flex justify-content-start mb-3 p-3 col">

            @*<div class="form-check form-check-inline p-2 rounded small">
                <input class="form-check-input" type="checkbox" id="allcourses" @(Model.CalendarType == "courses" ? "checked" : "") onchange="allcheckedChanged('courses')">
                <label class="form-check-label" for="allcourses">Alle</label>
            </div>*@

            <div class="form-check form-check-inline bg-basecourse p-2 border rounded small">
                <input class="form-check-input courses" type="checkbox" id="basecoursesevents" @(Model.CalendarType == "courses" ? "checked" : "") onchange="eventsCheckedChanged('basecourses')">
                <label class="form-check-label" for="basecoursesevents">Kurser</label>
            </div>

            <div class="form-check form-check-inline bg-speccourse p-2 border rounded small">
                <input class="form-check-input courses" type="checkbox" id="specialcoursesevents" @(Model.CalendarType == "courses" ? "checked" : "") onchange="eventsCheckedChanged('specialcourses')">
                <label class="form-check-label" for="specialcoursesevents">Specialer</label>
            </div>

            <div class="form-check form-check-inline bg-techcourse p-2 border rounded small">
                <input class="form-check-input courses" type="checkbox" id="techcoursesevents" @(Model.CalendarType == "courses" ? "checked" : "") onchange="eventsCheckedChanged('techcourses')">
                <label class="form-check-label" for="techcoursesevents">Tech-kurser</label>
            </div>

            <div class="form-check form-check-inline bg-procourse p-2 border rounded small">
                <input class="form-check-input courses" type="checkbox" id="procoursesevents" @(Model.CalendarType == "courses" ? "checked" : "") onchange="eventsCheckedChanged('procourses')">
                <label class="form-check-label" for="procoursesevents">Pro-kurser</label>
            </div>
        </div>

        @if (User.IsInRole(Userroles.Divepro))
        {
            <div class="d-flex justify-content-between mb-3 p-3">
                <div class="form-check form-check-inline bg-internal p-2 border rounded small">
                    <input class="form-check-input" type="checkbox" id="internalevents" onchange="eventsCheckedChanged('internal')">
                    <label class="form-check-label" for="internalevents">Kun for Divepros</label>
                </div>
            </div>
        }

            </div>
            <div id="calendar"></div>

            <div>
                <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog-centered modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header bg-light text-black-50 justify-content-between">
                                <h5 class="modal-title" id="myModalTitle"></h5>
                                <button class="btn btn-outline-danger btn-sm" data-dismiss="modal"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="modal-body" id="myModalContent">


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

@section Scripts {
    <script src="~/lib/fullcalendar/core/main.js"></script>
    <script src="~/lib/fullcalendar/bootstrap/main.js"></script>
    <script src="~/lib/fullcalendar/daygrid/main.min.js"></script>
    <script src="~/lib/fullcalendar/interaction/main.js"></script>
    <script src="~/lib/fullcalendar/timegrid/main.js"></script>
    <script src="~/lib/fullcalendar/list/main.js"></script>
    <script src="~/lib/fullcalendar/core/locales/da.js"></script>

    <script>
        /// Documenttation on fullCalendar plugin :
        /// https://fullcalendar.io/docs

        var calendarType = "@Model.CalendarType";



        var eventDetails = '@Url.Action("GetEventdetails","Home")';
        var eventsUrl = '@Url.Action("GetEvents", "Home")';
        var internalsUrl = '@Url.Action("GetInternalEvents", "Home")';
        var coursesUrl = '@Url.Action("GetCourses","Home")';
        var holidayUrl = '@Url.Action("GetHolidays","Home")';

        var boatSource = {
            // Bådture
            id: "boat",
            url: eventsUrl,
            cache: false,
            extraParams: { eventtype: '@EventTypeEnum.Bådtur' },
        };
        var beachSource =
        {
            id: "beach",
            //strandture
            url: eventsUrl,
            extraParams: { eventtype: '@EventTypeEnum.Stranddyk' },
        };

        var travelSource = {
            //rejser
            id: "travel",
            url: eventsUrl,
            extraParams: { eventtype: '@EventTypeEnum.Rejse' },
        };
        var liveaboardSource =
        {
            //liveaboards
            id: "liveaboard",
            url: eventsUrl,
            extraParams: { eventtype: '@EventTypeEnum.Liveaboard' },
        };
        var clubSource = {
            //klubture
            id: "club",
            url: eventsUrl,
            extraParams: { eventtype: '@EventTypeEnum.Klubture' },
        };
        var otherSource = {
            //Andre ture
            id: "other",
            url: eventsUrl,
            extraParams: { eventtype: '@EventTypeEnum.Other' },
        };

        var baseCourse = {
            //Kurser
            id: "basecourses",
            url: coursesUrl,
            extraParams: { coursetype: '@CourseTypeEnum.BaseCourse' }
        };
        var specCourse = {
            //Kurser
            id: "specialcourses",
            url: coursesUrl,
            extraParams: { coursetype: '@CourseTypeEnum.SpecialtyCourse' }
        };
        var techCourse = {
            //Kurser
            id: "techcourses",
            url: coursesUrl,
            extraParams: { coursetype: '@CourseTypeEnum.TechCourse' }
        };
        var proCourse = {
            //Kurser
            id: "procourses",
            url: coursesUrl,
            extraParams: { coursetype: '@CourseTypeEnum.ProCourse' }
        };

        var internals = {
            //Kurser
            id: "internal",
            url: internalsUrl
        };

        var tripSources = [
            boatSource,
            beachSource,
            clubSource,
            travelSource,
            liveaboardSource,
            otherSource
        ];

        var coursesSource = [
            baseCourse,
            specCourse,
            techCourse,
            proCourse
        ];

        var defaultSources = [
            boatSource,
            beachSource,
            clubSource,
            baseCourse,
            specCourse
        ];

        var defaultEventSources = [
            {
                url: holidayUrl,
                allDay: true,
                rendering: 'background',
            }
        ];


        switch (calendarType) {
            case "trips":
                tripSources.forEach(function (item) {
                    defaultEventSources.push(item);
                });
                break;
            case "courses":
                coursesSource.forEach(function (item) {
                    defaultEventSources.push(item);
                });
                
                break;
            default:
                defaultSources.forEach(function (item) {
                    defaultEventSources.push(item);
                });
                break;
        }

        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            plugins: ['interaction', 'dayGrid', 'timeGrid', 'bootstrap', 'list'],
            themeSystem: 'bootstrap',
            defaultView: 'dayGridMonth',
            //defaultDate: '2017-06-07',
            header: {
                right: 'today prev,next',
                left: 'title',
                center: 'dayGridMonth timeGridWeek'
            },
            locale: 'da',
            eventSources: defaultEventSources,
            eventLimit: 4,
            displayEventTime: false,
            eventTimeFormat:
            { // like '14:30:00'
                hour: '2-digit',
                minute: '2-digit'
            },
            /// Other options
            height: "parent",
            contentHeight: "auto",
            handleWindowResize: true,
            aspectRatio: 2,
            views: {
                ListOneYear: {
                    type: 'list',
                    duration: { years: 1 },
                    buttonText: 'År'
                },
                dayGrid: {
                    titleFormat: { year: 'numeric', month: 'long' }
                },
                //timeGrid: {

                //},
                //week: {

                //},
                //day: {

                //}
            },
            weekLabel: "Uge",
            businessHours: [
                {
                    daysOfWeek: [1, 2, 3, 4, 5],
                    startTime: '8:00',
                    endTime: '22:00'
                },
                {
                    daysOfWeek: [6,7],
                    startTime: '8:00',
                    endTime: '18:00'
                }
            ],
            slotDuration: '01:00:00',
            slotLabelInterval: '02:00:00',
            minTime: '00:00:00',
            maxTime: '23:59:59',
            showNonCurrentDates: true,
            fixedWeekCount: false,
            windowResizeDelay: 500,
            weekNumbers: true,
            weekNumbersWithinDays: false,
            //eventRender: function (info) {
            //    var tooltip = new Tooltip(info.el, {
            //        title: info.event.extendedProps.description,
            //        placement: 'top',
            //        trigger: 'hover',
            //        container: 'body'
            //    });
            //},
            //dateClick: function (info) {
            //    //alert(info.dateStr);
            //    $('#exampleModal').modal({ show: true, backdrop: false });
            //},

            eventClick: function (info) {
                var eventObj = info.event;
                var id = eventObj.id; //('id');
                var title = eventObj.title; //.event('title');

                $.ajax({
                    type: "GET",
                    url: eventDetails,
                    contentType: "application/json;charset=utf-8",
                    data: { "Id": id },
                    cache: false,
                    datatype: "json",
                    success: function (data) {
                        $("#myModalTitle").text(title);
                        $("#myModalContent").html(data);
                        $("#myModal").modal('show');
                        console.log("Before calling GetMap");
                        GetMap(false);
                    },
                    error: function () {
                        $(".modal-header").removeClass("bg-info").addClass("bg-danger");
                        $("#myModalTitle").text("Fejl");
                        $("#myModalContent").html("Der opstod en fejl. Prøv igen senere");
                        $("#myModal").modal('show');
                    }
                });
            }

        });

        document.addEventListener('DOMContentLoaded', function () {

            calendar.render();

        });

        function eventsCheckedChanged(eventtype) {


            var checkedEL = document.getElementById(eventtype + "events");

            var isChecked = checkedEL.checked;

            if (!isChecked) {

                var eventSource = calendar.getEventSourceById(eventtype);

                eventSource.remove();

                //calendar.getEventSourceById(eventtype).remove();

            } else {

                var eventsource = {};

                switch (eventtype) {
                    case 'boat':
                        eventsource = boatSource;
                        break;
                    case 'beach':
                        eventsource = beachSource;
                        break;
                    case 'travel':
                        eventsource = travelSource;
                        break;
                    case 'liveaboard':
                        eventsource = liveaboardSource;
                        break;
                    case 'club':
                        eventsource = clubSource;
                        break;
                    case 'other':
                        eventsource = otherSource;
                        break;
                    case 'basecourses':
                        eventsource = baseCourse;
                        break;
                    case 'specialcourses':
                        eventsource = specCourse;
                        break;
                    case 'techcourses':
                        eventsource = techCourse;
                        break;
                    case 'procourses':
                        eventsource = proCourse;
                        break;
                    case 'internal':
                        eventsource = internals;
                        break;
                    default:
                        break;
                }

                calendar.addEventSource(eventsource);
            }

        }

        function allcheckedChanged(eventgroup) {

            var ischecked = document.getElementById("all" + eventgroup).checked;

            var checkboxes = $("." + eventgroup);

            checkboxes.attr("checked", ischecked);

            for (let key in checkboxes) {

                var item = checkboxes[key];

                if (item.id !== undefined) {
                    var eventtype = item.id.replace("events", "");
                    eventsCheckedChanged(eventtype);
                }
            }

        }

    </script>

    <script src="~/js/bingmap.js"></script>

}
