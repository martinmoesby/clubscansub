@model Event
@{

    var heading = Model.GetType() == typeof(Event) ? "Tur beskrivelse" : "Kursus detaljer";
    var partialViewName = Model.GetType() == typeof(Event) ? "_EventDetailsPartial" : "_CourseDetailsPartial";
}

<div class="container mt-4">

    <div class="row align-content-start justify-content-between">

        <div class="col-12 mb-4">
            <h1 class="text-info display-4">@heading</h1>

        </div>
        <div class="col-8">
            <partial name="@partialViewName" model="@Model" />
        </div>

    </div>
</div>
@section Scripts {

    <script src="~/js/bingmap.js"></script>

}
