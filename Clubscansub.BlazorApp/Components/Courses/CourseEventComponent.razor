@using ClubScansub.Utility

@if(isLoading) {
    <RadzenStack Style="height:580px;" >
        <WaitLoadingComponent />
    </RadzenStack>
} else
{

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem" Class="rz-p-4">
    <RadzenStack Style="max-width:50%">
        @if (course.CourseTemplate?.Image != null)
        {
            <img src="@ImageUtils.GetImageSrc(course.CourseTemplate?.Image)" alt="@course.CourseName" class="img rounded w-100" />

        }
        else
        {
            <RadzenImage Path="/images/no_location_image.png" class="img rounded w-100" />
        }
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" Style="width:50%" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Stretch">

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">

            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="calendar_month"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="@course.StartDateAndTime.ToString()" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="alarm_off"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="@course.EndDateAndTime.ToString()" />
                </RadzenStack>

            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="payments"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@course.Price?.ToString("C2")</RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="event_seat"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@course.FreeSpots of @course.MaxParticipants</RadzenText>
                </RadzenStack>

            </RadzenStack>


        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Normal">
                <RadzenText TextStyle="TextStyle.Body2">@courseBrief</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">
            <SeatComponent Event="course" ShowText="false" />
        </RadzenStack>

    </RadzenStack>


</RadzenStack>


<RadzenStack Gap="0">
    <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="0" TabPosition="TabPosition.Top">
        <Tabs>
            <RadzenTabsItem Text="Kursusplan" Icon="school">
                <CourseSessionDetailsComponent Sessions="@(course.CourseSessions.OrderBy(x=>x.StartDateAndTime).ToList())" />
            </RadzenTabsItem>
            <AuthorizeView Roles="Administrator, Owner, Divepro">

                    <RadzenTabsItem Text="Tilmeldte" Icon="social_leaderboard">

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="50" JustifyContent="JustifyContent.SpaceBetween" Visible="@(course.FreeSpots > 0)" class="rz-mb-5">

                            <RadzenStack Orientation="Orientation.Horizontal" Style="flex:1" Gap="5">
                                <RadzenDropDown AllowFiltering="true"
                                                AllowClear="true"
                                                AllowSelectAll="false"
                                                Data="@filteredUsers"
                                                @bind-Value="@selectedUser"
                                                TextProperty="@nameof(ApplicationUser.Name)"
                                                ValueProperty="@nameof(ApplicationUser.Id)"
                                                LoadData="@OnLoadExistingUsers">

                                </RadzenDropDown>
                                <RadzenButton Click="@enrollExistingUser" Text="Enroll user" Icon="person_check" ButtonStyle="ButtonStyle.Success" Shade="Shade.Lighter" Disabled="@(string.IsNullOrEmpty(selectedUser))" />
                            </RadzenStack>

                            <RadzenButton Text="Add user" ButtonStyle="ButtonStyle.Primary" Shade="Shade.Lighter" Icon="person_add" Click="addNewStudent_Click" />

                        </RadzenStack>

                    <RadzenDataGrid TItem="EventUser" Data="@enrolledUsers" LoadData="OnLoadEnrolledUsers">
                            <Columns>
                                <RadzenDataGridColumn Title="Kontonummer" Width="120px">
                                    <Template Context="item">
                                        <RadzenText Text="@item.ApplicationUser?.AccountNumber" TextStyle="TextStyle.Body1" />
                                    </Template>
                                </RadzenDataGridColumn>
                            
                                <RadzenDataGridColumn Title="Navn">
                                <Template Context="item">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" >
                                            @($"{item.ApplicationUser?.Firstname} {@item.ApplicationUser?.Lastname}")
                                    </RadzenText>
                                </Template>
                            </RadzenDataGridColumn>
                            
                            <RadzenDataGridColumn Title="Alder" TextAlign="TextAlign.Center" Width="60px">
                                <Template Context="item">
                                        <RadzenText Text="@((new DateTime((DateTime.Now - item.ApplicationUser.DayOfbirth).Ticks).Year-1).ToString())" TextStyle="TextStyle.Body1" />
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn Title="Telefon" TextAlign="TextAlign.Center" Width="120px">
                                <Template Context="item">
                                        <RadzenText Text="@item.ApplicationUser?.PhoneNumber" TextStyle="TextStyle.Body1" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Width="40px">
                                <Template Context="item">
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Shade="Shade.Lighter" Click="@(() => removeUserFromCourse(item.ApplicationUser))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    
                    </RadzenDataGrid>
                </RadzenTabsItem>
            </AuthorizeView>

        </Tabs>

    </RadzenTabs>

</RadzenStack>

}