@using ClubScansub.Utility

@if(isLoading) {
    <RadzenStack Style="height:580px;" >
        <WaitLoadingComponent />
    </RadzenStack>
} else
{

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem" Class="rz-p-4">
    <RadzenStack Style="max-width:50%">
        @if (course.CourseTemplate?.Image != null)
        {
            <img src="@ImageUtils.GetImageSrc(course.CourseTemplate?.Image)" alt="@course.CourseName" class="img rounded w-100" />

        }
        else
        {
            <RadzenImage Path="/images/no_location_image.png" class="img rounded w-100" />
        }
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" Style="width:50%" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Stretch">

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">

            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.CALENDAR"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="@course.StartDateAndTime.ToString()" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.END_TIME"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="@course.EndDateAndTime.ToString()" />
                </RadzenStack>

            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@course.Price?.ToString("C2")</RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.SLOTS"></RadzenIcon>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@course.FreeSpots of @course.MaxParticipants</RadzenText>
                </RadzenStack>

            </RadzenStack>


        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Normal">
                <RadzenText TextStyle="TextStyle.Body2">@courseBrief</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">
            <SeatComponent Event="course" ShowText="false" />
        </RadzenStack>

    </RadzenStack>


</RadzenStack>


<RadzenStack Gap="0">
    <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="0" TabPosition="TabPosition.Top">
        <Tabs>

            <RadzenTabsItem Text="Kursusplan" Icon="@IconsTextsAndColors.Icons.EDUCATION">
                <CourseSessionDetailsComponent Sessions="@(course.CourseSessions.OrderBy(x=>x.StartDateAndTime).ToList())" />
            </RadzenTabsItem>

            <AuthorizeView Roles="Administrator, Owner, Divepro">

                <RadzenTabsItem Text="Tilmeldte" Icon="@IconsTextsAndColors.Icons.ENROLLED">

                    <EventUserActionsComponent AddNewUser="addNewStudent" AddExistingUser="enrollExistingUser" Visible="@(course.FreeSpots > 0 || course.StartDateAndTime> DateTime.Now)" ShowAddNewUser="true" />
                    <EventUserListComponent EventUsers="enrolledUsers" OnRemoveUser="removeUserFromCourse" />

                </RadzenTabsItem>
            </AuthorizeView>

        </Tabs>

    </RadzenTabs>

</RadzenStack>

}