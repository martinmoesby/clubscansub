
<RadzenFormField Style="width:100%">
    <Start>
        <RadzenIcon Icon="search" />
    </Start>
    <ChildContent>
        <RadzenTextBox @bind-Value="@searchFilter" Change="onSearchFilterChanged" />
    </ChildContent>
    <End>
        <RadzenIcon Icon="close" @onclick="resetSearchFilter" Style="cursor:pointer" />
    </End>
</RadzenFormField>

