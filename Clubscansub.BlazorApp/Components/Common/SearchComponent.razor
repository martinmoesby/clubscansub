@using ClubScansub.Utility

<RadzenFormField Style="width:100%">
    <Start>
        <RadzenIcon Icon="@IconsTextsAndColors.Icons.SEARCH" />
    </Start>
    <ChildContent>
        <RadzenTextBox @bind-Value="@searchFilter" Change="onSearchFilterChanged" />
    </ChildContent>
    <End>
        <RadzenIcon Icon="@IconsTextsAndColors.Icons.CLOSE" @onclick="resetSearchFilter" Style="cursor:pointer" />
    </End>
</RadzenFormField>

