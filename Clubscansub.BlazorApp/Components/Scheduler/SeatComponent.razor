@using ClubScansub.Utility
@if (ShowText)
{
    <RadzenText Text="@Text" TextStyle="TextStyle.Caption" />
}
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%">
    <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Light" Variant="Variant.Outlined" Style="width:100%">
        @for (int i = 0; i < Event.FixedParticipants; i++)
        {
            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER" IconStyle="IconStyle.Info" />

        }

        @foreach (var user in Event.Participants)
        {
            @if (user.ApplicationUser != null)
            {
                <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_CHECK" IconStyle="IconStyle.Success" title="@user.ApplicationUser?.Firstname" />
            }
            else
            {
                <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_CHECK" IconStyle="IconStyle.Success" title="Plads optaget" />
            }
        }


        @for (int i = 0; i < Event.RequiredSpots % 10; i++)
        {
            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER" IconStyle="IconStyle.Warning" title="1 påkrævet plads" />

        }


        @for (int i = 0; i < Event.RequiredSpots / 10; i++)
        {
            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_10" IconStyle="IconStyle.Warning" title="10 påkrævede plads" />

        }

        @for (int i = 0; i < (Event.FreeSpots - Event.RequiredSpots) % 10; i++)
        {
            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER" IconStyle="IconStyle.Dark" title="Ledig plads" />

        }

        @for (int i = 0; i < (Event.FreeSpots - Event.RequiredSpots) / 10; i++)
        {
            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_10" IconStyle="IconStyle.Dark" title="10 ledige plads" />

        }
    </RadzenBadge>
</RadzenStack>
