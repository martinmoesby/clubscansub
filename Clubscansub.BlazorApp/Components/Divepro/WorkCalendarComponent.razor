@using ClubScansub.Extensions
@using ClubScansub.Service
@using Nager.Date

<RadzenStack Style="min-width:1200px;width:100%;height:100%;display:flex;background-color:var(--rz-base)">

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%;" class="rz-p-4">
        <RadzenButton Click="prevMonth" Icon="chevron_backward" />
        <RadzenText Text="@Start.ToString("MMMM yyyy")" TextAlign="TextAlign.Center" TextStyle="TextStyle.Subtitle1" />
        <RadzenButton Click="nextMonth" Icon="chevron_forward" />
    </RadzenStack>

    <RadzenStack Style="width:100%;flex:1;border:1px solid; background-color:var(--rz-base-400)" class="rz-border-color-base-400" Gap="0">
        <RadzenRow AlignItems="AlignItems.Center" Gap="0">
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Monday</RadzenColumn>
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Tuesday</RadzenColumn>
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Wednesday</RadzenColumn>
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Thursday</RadzenColumn>
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Friday</RadzenColumn>
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Saturday</RadzenColumn>
            <RadzenColumn Style="height:100%;flex:1;text-align:center">@DayOfWeek.Sunday</RadzenColumn>
        </RadzenRow>
        @if (isLoading)

        {   <RadzenStack Style="width:100%;flex:1" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Secondary" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText Text="Loading available courses..." TextStyle="TextStyle.Body2" />
            </RadzenStack>
        } else {

        
        @foreach (var item in weeks)
        {

            <RadzenRow style="flex:1;border-top:1px solid;" class="rz-border-color-base-400" Gap="0">
                @foreach (var day in EachDay(item.Start, item.End))
                {
                    string bgClass = "rz-background-color-base-100 rz-border-color-base-400";
                    string borderStyle = "border-right:1px solid";
                    if (Nager.Date.DateSystem.IsWeekend(day, CountryCode.DK))
                    {
                        bgClass = "rz-background-color-warning-lighter rz-border-color-base-400";
                    }
                    if (day.DayOfWeek == DayOfWeek.Sunday)
                    {
                        borderStyle = "border-right:none;";
                    }
                    if (day.Month == Start.Month)
                    {
                        <RadzenColumn Style=@($"flex:1;height:100%;display:flex;flex-direction:column;{borderStyle}") class="@bgClass">
                            <RadzenText TextStyle="TextStyle.Caption" Text="@day.Day.ToString()" />
                            <RadzenStack Style="flex:1;padding:1px">
                                @foreach (var session in GetSessionsForDay(day).OrderBy(x=>x.StartDateAndTime))
                                {
                                    <WorkCalendarSessionComponent Session="session"  
                                        OnRetractInstructor ="(args)=>retractInstructor(args.Item1, args.Item2) " 
                                        OnApproveInstructor = "(args)=>approveInstructor(args.Item1, args.Item2) "
                                                                      OnUnaproveInstructor="(args)=>unApproveInstructor(args.Item1, args.Item2) "
                                                                      OnSignUpInstructor="(args) => signupInstructor(args.Item1, args.Item2)" 
                                        ReadOnly="(day < DateTime.Now)" />
                                }
                            </RadzenStack>

                        </RadzenColumn>
                    }
                    else
                    {
                        <RadzenColumn Style="height:100%;flex:1;border-right:1px solid" class="rz-background-color-base-200 rz-border-color-base-400" />
                    }
                }
            </RadzenRow>
        }
        }

    </RadzenStack>
</RadzenStack>
@code {
    [Inject]
    AuthenticationStateProvider authenticationStateProvider { get; set; }

    [Inject]
    CourseService courseService { get; set; }
    private IList<CourseSession> sessions = new List<CourseSession>();

    private DateTime Start;
    private DateTime End;
    private DateTime calendarStart;
    private DateTime calendarEnd;
    private double daysInCalendarView;
    private double weeksInCalendarView;
    private IList<Week> weeks = new List<Week>();
    private bool isLoading = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Start = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        End = Start.AddMonths(1).AddDays(-1);
        calculateInternalVariables();


    }

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        await base.OnParametersSetAsync();
        if (firstrender)
        {
            await refreshSessions();
        }
    }

    private async void nextMonth()
    {

        Start = Start.AddMonths(1);
        End = Start.AddMonths(1).AddDays(-1);
        calculateInternalVariables();

        await refreshSessions();
    }
    private async void prevMonth()
    {

        Start = Start.AddMonths(-1);
        End = Start.AddMonths(1).AddDays(-1);
        calculateInternalVariables();

        await refreshSessions();

    }

    private async Task refreshSessions()
    {
        isLoading = true;
        sessions = await courseService.GetCourseSessionsByMonth(Start);
        isLoading = false;
        StateHasChanged();
    }

    private void calculateInternalVariables()
    {
        weeks.Clear();
        int daysInFirstWeekOfMonth = Start.DayOfWeek == DayOfWeek.Sunday ? 1 : 7 - (int)Start.DayOfWeek + 1;
        int daysInLastWeekOfMonth = (int)End.DayOfWeek;
        calendarStart = Start.AddDays(-(7 - daysInFirstWeekOfMonth));
        calendarEnd = End.AddDays(7 - daysInLastWeekOfMonth);
        daysInCalendarView = (calendarEnd - calendarStart).TotalDays + 1;
        weeksInCalendarView = daysInCalendarView / 7;
        for (int i = 0; i < weeksInCalendarView; i++)
        {
            var newWeek = new Week()
                {
                    Start = calendarStart.AddDays(i * 7),
                    End = calendarStart.AddDays(i * 7).AddDays(6)
                };
            if (newWeek.Start.Month == Start.Month || newWeek.End.Month == Start.Month)
            {
                weeks.Add(newWeek);
            }
        }

    }

    private async void retractInstructor(CourseSession session, ApplicationUser instructor)
    {

        // var item = sessions.FirstOrDefault(x => x.Id == session.Id); //.FirstOrDefault(x => x.InstructorId == instructor);
        // var sessionInstructor = item.SessionInstructors.FirstOrDefault(x => x.InstructorId == instructor.Id);
        // if (sessionInstructor != null) {
        //     sessionInstructor.InstructorRetracted = true;
        //     sessionInstructor.InstructorApproved = false;
        // }
        await courseService.RetractSessionInstructor(session, instructor);

        await refreshSessions();
    }
    private async void unApproveInstructor(CourseSession session, ApplicationUser instructor)
    {
        // var item = sessions.FirstOrDefault(x => x.Id == session.Id); //.FirstOrDefault(x => x.InstructorId == instructor);
        // var sessionInstructor = item.SessionInstructors.FirstOrDefault(x => x.InstructorId == instructor.Id);
        // if (sessionInstructor != null)
        // {
        //     sessionInstructor.InstructorRetracted = false;
        //     sessionInstructor.InstructorApproved = true;
        // }
        await courseService.ApproveSessionInstructor(session, instructor, false);

        await refreshSessions();

    }

    private async void approveInstructor(CourseSession session, ApplicationUser instructor)
    {
        // var item = sessions.FirstOrDefault(x => x.Id == session.Id); //.FirstOrDefault(x => x.InstructorId == instructor);
        // var sessionInstructor = item.SessionInstructors.FirstOrDefault(x => x.InstructorId == instructor.Id);
        // if (sessionInstructor != null)
        // {
        //     sessionInstructor.InstructorRetracted = false;
        //     sessionInstructor.InstructorApproved = true;
        // }
        await courseService.ApproveSessionInstructor(session, instructor);

        await refreshSessions();

    }
    private async void signupInstructor(CourseSession session, ApplicationUser instructor)
    {
        // var item = sessions.FirstOrDefault(x => x.Id == session.Id); //.FirstOrDefault(x => x.InstructorId == instructor);
        // item.SessionInstructors.Add(new CourseSessionInstructor() { CourseSession = session, Instructor= instructor, CourseSessionId = session.Id, InstructorId = instructor.Id, InstructorApproved = false, InstructorRetracted = false });
        // if (sessionInstructor != null)
        // {
        //     sessionInstructor.InstructorRetracted = false;
        //     sessionInstructor.InstructorApproved = false;
        // }
        await courseService.SignupSessionInstructor(session, instructor);

        await refreshSessions();

    }

    private class Week
    {
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
    }

    private IEnumerable<CourseSession> GetSessionsForDay(DateTime date)
    {
        var daysSessions = sessions.Where(x => x.DateTime.Date == date.Date);

        if (daysSessions.Count() > 0)
            return daysSessions;

        return daysSessions;
    }

    private IEnumerable<DateTime> EachDay(DateTime from, DateTime thru, int interval = 1)
    {
        for (var day = from; day <= thru; day = day.AddDays(interval))
            yield return day;
    }

}