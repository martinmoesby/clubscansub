
<RadzenStack Orientation="@Orientation" JustifyContent="@Justify" AlignItems="@Alignment" Gap="10px">

    <RadzenText Text="@LabelText" TextStyle="TextStyle.Button" class="rz-mt-2" Visible=@ShowLabel></RadzenText>

    <RadzenToggleButton Disabled=@IsLoading Change="@onMemberRolesChanged" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary" ToggleButtonStyle="ButtonStyle.Success" @bind-Value=@showOwner Shade="Shade.Lighter" ToggleShade="Shade.Default" Text="Owners" Icon="radio_button_unchecked" ToggleIcon="task_alt" />
    <RadzenToggleButton Disabled=@IsLoading Change="@onMemberRolesChanged" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary" ToggleButtonStyle="ButtonStyle.Success" @bind-Value=@showAdmin Shade="Shade.Lighter" ToggleShade="Shade.Default" Text="Admins" Icon="radio_button_unchecked" ToggleIcon="task_alt" />
    <RadzenToggleButton Disabled=@IsLoading Change="@onMemberRolesChanged" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary" ToggleButtonStyle="ButtonStyle.Success" @bind-Value=@showDivepro Shade="Shade.Lighter" ToggleShade="Shade.Default" Text="Pros" Icon="radio_button_unchecked" ToggleIcon="task_alt" />
    <RadzenToggleButton Disabled=@IsLoading Change="@onMemberRolesChanged" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary" ToggleButtonStyle="ButtonStyle.Success" @bind-Value=@showMember Shade="Shade.Lighter" ToggleShade="Shade.Default" Text="Prem." Icon="radio_button_unchecked" ToggleIcon="task_alt" />
    <RadzenToggleButton Disabled=@IsLoading Change="@onMemberRolesChanged" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary" ToggleButtonStyle="ButtonStyle.Success" @bind-Value=@showUser Shade="Shade.Lighter" ToggleShade="Shade.Default" Text="Basic" Icon="radio_button_unchecked" ToggleIcon="task_alt" />
    <RadzenToggleButton Disabled=@IsLoading Change="@onMemberRolesChanged" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary" ToggleButtonStyle="ButtonStyle.Success" @bind-Value=@showStudent Shade="Shade.Lighter" ToggleShade="Shade.Default" Text="Students" Icon="radio_button_unchecked" ToggleIcon="task_alt" />

</RadzenStack>