@using ClubScansub.Models.DTO;

<RadzenTemplateForm Data="@Member" TItem="ApplicationUser" Submit="@((ApplicationUser member) => UpdateUserCallback.InvokeAsync(member))" InvalidSubmit="@onInvalidSubmit">

    <RadzenRow>
        <RadzenColumn Size="10">
            <RadzenFieldset Text="@($"Account number: {Member.AccountNumber}")">
@*                <HeaderTemplate>
                    <RadzenStack Style="width:100%" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
                        <RadzenText Text="@Member.AccountNumber" TextStyle="TextStyle.Overline" />
                        <RadzenText Text="@Member.UserName" TextStyle="TextStyle.Overline" />
                        <RadzenText Text="@Member.Balance.ToString("C2")" TextAlign="TextAlign.Right" TextStyle="TextStyle.Overline" />
                    </RadzenStack>
                </HeaderTemplate>*@
                <ChildContent>
                    <RadzenRow Style="margin-bottom:20px" AlignItems="AlignItems.Stretch">
                        <RadzenColumn Size="12">
                            <RadzenLabel Component="LockedOutDate" Text="Locked out until:"  />
                            <RadzenText Text="@Member.LockoutEnd.ToString()"  TextStyle="TextStyle.Caption" TextAlign="TextAlign.Right" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="First name(s)" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.Firstname" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Last name" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.Lastname" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Address" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.Streetaddress" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Postcode" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.PostalCode" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="8">
                            <RadzenFormField Text="City" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.City" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Phone" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.PhoneNumber" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Email" Variant="Variant.Text" Style="width:100%">
                                <RadzenTextBox @bind-Value="@Member.Email" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenFormField Text="Birthday" Variant="Variant.Text" Style="width:100%">
                                <RadzenDatePicker @bind-Value="@Member.DayOfbirth" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </ChildContent>
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn Size="2">
            <RadzenFieldset Text="Roles" Style="height:100%">
                @if (Member.Roles != null)
                {
                    <MemberRolesComponent Orientation="Orientation.Vertical" MemberRolesChanged="@onSetUserRoles" InitialRoles="@Member.Roles" ShowLabel="false" Alignment="AlignItems.Stretch" Justify="JustifyContent.Stretch" />
                }
            </RadzenFieldset>

        </RadzenColumn>
    </RadzenRow>

  
   <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-4">
        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
        <RadzenButton ButtonType="ButtonType.Button" Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="deleteUserClick" Size="ButtonSize.Small" />
    </RadzenStack>
</RadzenTemplateForm>

<style>
    .rz-custom-header {
        width: 100% !important
    }
</style>