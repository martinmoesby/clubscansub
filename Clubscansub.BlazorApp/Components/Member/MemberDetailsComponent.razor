@using ClubScansub.Models.DTO;

<RadzenTemplateForm Data="@Member" TItem="MemberDTO" Submit="@((MemberDTO member) => UpdateUserCallback.InvokeAsync(member))" InvalidSubmit="@onInvalidSubmit">

    <RadzenFieldset Text="@Member.UserName">

        <RadzenStack Style="width:100%" JustifyContent="JustifyContent.End" AlignItems="AlignItems.End">
            <RadzenText Text="@Member.Balance.ToString("C2")" TextAlign="TextAlign.Right" TextStyle="TextStyle.Caption" />
        </RadzenStack>
        
        <RadzenRow>
            <RadzenColumn Size="6">
                <RadzenFormField Text="First name(s)" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.Firstname" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Last name" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.Lastname" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenFormField Text="Address" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.Streetaddress" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Postcode" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.PostalCode" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="8">
                <RadzenFormField Text="City" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.City" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Phone" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.PhoneNumber" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Email" Style="width:100%">
                    <RadzenTextBox @bind-Value="@Member.Email" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Birthday" Style="width:100%">
                    <RadzenDatePicker @bind-Value="@Member.DayOfbirth" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

    </RadzenFieldset>
    <RadzenFieldset Text="membership Roles" >
        @if (Member.Roles != null)
        {
            <MemberRolesComponent MemberRolesChanged="@onSetUserRoles" InitialRoles="@Member.Roles" LabelText="Roles" />
        }
    </RadzenFieldset>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-4">
        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" />
        <RadzenButton ButtonType="ButtonType.Button" Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="deleteUserClick" />
    </RadzenStack>
</RadzenTemplateForm>