<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
    <RadzenIcon Icon="@profileIcon" Style="font-size:1rem" IconStyle="@profileIconStyle" MouseEnter="@(args=> ShowTooltip(args, "profile"))"/>
    <RadzenIcon Icon="@phoneIcon" Style="font-size:1rem" IconStyle="@phoneIconStyle" MouseEnter="@(args=> ShowTooltip(args, "phone"))" />
    <RadzenIcon Icon="@emailIcon" Style="font-size:1rem" IconStyle="@emailIconStyle" MouseEnter="@(args=> ShowTooltip(args, "email"))" />
</RadzenStack>
