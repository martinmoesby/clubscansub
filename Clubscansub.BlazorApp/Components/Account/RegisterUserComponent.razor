@using ClubScansub.Models.DTO
@using System.Text.Json;

<RadzenTemplateForm TItem="RegisterUserDTO" Data=@newUser Submit=@onSubmit InvalidSubmit=@invalidSubmit>

    <RadzenFieldset>
        <HeaderTemplate>
            <RadzenText TextStyle="TextStyle.Overline" Text="User information" />
        </HeaderTemplate>
        <ChildContent>

            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Outlined" Text="Account NUmber" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.AccountNumber />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Filled" Text="Email" Style="width:100%">
                        <RadzenTextBox Name="Email" @bind-Value=@newUser.Email />
                        <RadzenRequiredValidator Component="Email" Text="Please enter your email,,," Style="position:absolute" Popup="true" />
                        <RadzenEmailValidator Component="Email" Text="This is not a valid email" Popup="true" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Filled" Text="Phone" Style="width:100%">
                        <RadzenMask Mask="**** ****" CharacterPattern="[0-9]" Name="Phone" @bind-Value=@newUser.PhoneNumber Placeholder="0000 0000"  />
                        <RadzenRequiredValidator Component="Phone" Text="*" Style="position:absolute" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

@*            
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFormField Variant="Variant.Filled" Text="Password" Style="width:100%">
                        <RadzenPassword Name="Password" @bind-Value=@newUser.Password/>
                        <RadzenRequiredValidator Component="Password" Text="Please enter a password" Style="position:absolute" Popup="true" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="6">
                    <RadzenFormField Variant="Variant.Filled" Text="Confirm password" Style="width:100%">
                        <RadzenPassword @bind-value=@newUser.ConfirmPassword Name="RepeatPassword" />
                        <RadzenRequiredValidator Component="RepeatPassword" Text="Please confirm your password" Style="position:absolute" />
                        <RadzenCompareValidator Visible=@(!string.IsNullOrEmpty(newUser.ConfirmPassword)) Value=@newUser.Password Component="RepeatPassword" Text="Passwords should be the same" Popup="true" Style="position: absolute" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
*@

        </ChildContent>

    </RadzenFieldset>

    <RadzenFieldset>
        <HeaderTemplate>
            <RadzenText TextStyle="TextStyle.Overline" Text="Contact Information" />
        </HeaderTemplate>
        <ChildContent>
            <RadzenRow Gap="50">
                <RadzenColumn Size="6">
                    <RadzenFormField Variant="Variant.Outlined" Text="Firts name(s)" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Firstname />
                    </RadzenFormField>

                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Variant="Variant.Outlined" Text="Last name" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Lastname />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Outlined" Text="Adress" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Street />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="50">
                <RadzenColumn Size="4">
                    <RadzenFormField Variant="Variant.Outlined" Text="Zip/Postal code" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.PostalCode />
                    </RadzenFormField>

                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenFormField Variant="Variant.Outlined" Text="City" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.City />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Outlined" Text="Country" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Country />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

        </ChildContent>
    </RadzenFieldset>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Text="Cancel" />
        <RadzenButton ButtonType="ButtonType.Submit" Variant=Variant.Filled ButtonStyle=ButtonStyle.Success Text="Register" Icon="person_add" />
    </RadzenStack>



</RadzenTemplateForm>
