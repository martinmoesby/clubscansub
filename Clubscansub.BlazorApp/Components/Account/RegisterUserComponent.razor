    <RadzenFieldset>
        <HeaderTemplate>
            <RadzenText TextStyle="TextStyle.Overline" Text="Contact Information" />
        </HeaderTemplate>
        <ChildContent>
            
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Outlined" Text="Nickname" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Nickname />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Outlined" Text="Adress" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Street />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="50">
                <RadzenColumn Size="4">
                    <RadzenFormField Variant="Variant.Outlined" Text="Zip/Postal code" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.PostalCode />
                    </RadzenFormField>

                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenFormField Variant="Variant.Outlined" Text="City" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.City />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Variant.Outlined" Text="Country" Style="width:100%">
                        <RadzenTextBox @bind-value=@newUser.Country />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

        </ChildContent>
    </RadzenFieldset>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Text="Cancel" />
        <RadzenButton ButtonType="ButtonType.Submit" Variant=Variant.Filled ButtonStyle=ButtonStyle.Success Text="Register" Icon="person_add" />
    </RadzenStack>



</RadzenTemplateForm>

@code {
    class Model
    {
        public string Password { get; set; }
        public string RepeatPassword { get; set; }
    }

    bool popup = true;
    

    Model model = new Model();


    void Log(string eventName, string value)
    {
        Console.WriteLine($"{eventName}: {value}");
    }

    void OnSubmit(Model model)
    {
        Log("Submit", JsonSerializer.Serialize(model, new JsonSerializerOptions() { WriteIndented = true }));
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
        Log("InvalidSubmit", JsonSerializer.Serialize(args, new JsonSerializerOptions() { WriteIndented = true }));
    }
}