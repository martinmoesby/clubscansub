@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<RadzenTabs TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client">
    <Tabs>
        <RadzenTabsItem Text="Name">
            <RadzenTemplateForm Data="@Divesite"
                                TItem="Divelocation"
                                Submit="@((Divelocation divelocation) => UpdateDivesiteCallback.InvokeAsync(divelocation))"
                                InvalidSubmit="@onInvalidSubmit">
                <RadzenRow>
                    <RadzenColumn Size="7">
                        <RadzenFieldset  Text="@($"Divesite {Divesite.Name}")">
                            <ChildContent>
                                <RadzenRow Style="margin-bottom:20px" AlignItems="AlignItems.Stretch">
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Name" Variant="Variant.Text" Style="width:100%">
                                            <RadzenTextBox @bind-Value="@Divesite.Name"/>
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow Style="margin-bottom:20px" AlignItems="AlignItems.Stretch">
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Description" Variant="Variant.Text" Style="width:100%">
                                            <RadzenTextArea @bind-Value="@Divesite.Description" Rows="5" >

                                            </RadzenTextArea>
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow>
                                    <RadzenColumn Size="4">
                                        <RadzenFormField Text="Min. Depth" Variant="Variant.Text" Style="width:100%">
                                            <RadzenNumeric @bind-Value="@Divesite.MinDepth" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="4">
                                        <RadzenFormField Text="Max. Depth" Variant="Variant.Text" Style="width:100%">
                                            <RadzenNumeric @bind-Value="@Divesite.MaxDepth" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                            </ChildContent>
                        </RadzenFieldset>
                    </RadzenColumn>
                    <RadzenColumn Size="5">
                        <RadzenFieldset Text="Image" class="rz-p-1">
                            <img src="@getImageSrc(Divesite.Image)" alt="@Divesite.Name" class="img rounded w-100 rz-mb-2" @onclick="@onImageClick"/>   
                            <RadzenUpload MaxFileCount="1" ChooseText="Select new image"   />
                        </RadzenFieldset>
                    </RadzenColumn>
                </RadzenRow>

            </RadzenTemplateForm>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Details">

        </RadzenTabsItem>

@*         <RadzenTabsItem Text="Map">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">

                <RadzenGoogleMap ApiKey="@googleMapsAPIKey" MapId="@googleMapsMapId"
                                 Style="height:400px;width:400px;"
                                 Options=@googleMapOptions
                                 Zoom=8
                                 Center=@divesitePosition
                                 MapClick=@onMapClick MarkerClick=@onMarkerClick>
                                 <Markers>
                                     <RadzenGoogleMapMarker Position="@divesitePosition" Label="Divesite" />
                                     <RadzenGoogleMapMarker Position="@meetinLocationPosition" Label="Meeting point" />
                                 </Markers>
                             </RadzenGoogleMap>

                <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start">
                    <RadzenText Text="Latitude" />
                    <RadzenText Text="@Divesite.Latitude.ToString()" />
                    <RadzenText Text="Longitude" />
                    <RadzenText Text="@Divesite.Longitude.ToString()" />

                </RadzenStack>
            </RadzenStack>
        </RadzenTabsItem> *@

        <RadzenTabsItem Text="Meeting Location">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">

                <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start" Gap="5">
                    <RadzenText Text="Meeting location" />
                    
                    <RadzenTemplateForm Data="@Divesite.MeetingLocation" TItem="Address" Style="width:100%" >
                        <RadzenFormField Style="width:100%" Variant="Variant.Text" Text="Select existing meeting spots">
                            <RadzenDropDown Data="@meetingLocations" TValue="Address" Value="@Divesite.MeetingLocation?.Id" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                        </RadzenFormField>

                        <RadzenRow class="rz-mt-5">
                            <RadzenColumn Size="12">
                                <RadzenFormField Variant="Variant.Text" Text="Short name" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Name" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenFormField Variant="Variant.Text" Text="Streetname" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Streetname" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow Gap="4">
                            <RadzenColumn Size="4">
                                <RadzenFormField Variant="Variant.Text" Text="Postcode" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Zipcode" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenFormField Variant="Variant.Text" Text="City" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@divesiteMeetingLocation.City" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenFormField Variant="Variant.Text" Text="Streetname" Style="width:100%">
                                    <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Country" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenTemplateForm>

                </RadzenStack>
                <RadzenGoogleMap ApiKey="@googleMapsAPIKey" MapId="@googleMapsMapId" @ref=@map
                                 Style="height:360px;width:400px;"
                                 Options=@googleMapOptions
                                 Zoom=11
                                 MapClick="@onMapClick"
                                 MarkerClick="@onMarkerClick"
                                 FitBoundsToMarkersOnUpdate="@fitBoundsToMarkers"
                                 Center=@(meetinLocationPosition ?? divesitePosition)>
                    <Markers>
                        @foreach (var item in markers)
                        {
                            <RadzenGoogleMapMarker Position="@item.Position" Title="@item.Title" />
                        }
                    </Markers>
                </RadzenGoogleMap>

            </RadzenStack>
        </RadzenTabsItem>
    </Tabs>

</RadzenTabs>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-4">
    <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
    <RadzenButton ButtonType="ButtonType.Button" Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="deleteDivesiteClick" Size="ButtonSize.Small" />
</RadzenStack>
