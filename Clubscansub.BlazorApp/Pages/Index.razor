@page "/"
@using ClubScansub.Models.Interface;
@using ClubScansub.Utility;

<PageTitle>Club Scansub Calendar</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Stretch" Style="height:100%">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">


        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenLabel Text="All events" Component="eventswitch" Style="font-size:0.8rem; margin-top:6px" />
                <RadzenSwitch Value="@showAllEvents" Change="setAllEventFilter" Name="eventswitch" />
            </RadzenStack>
            <RadzenStack>
                <EventTypeToggleButtonsComponent InitialFilters="eventTypeFilters" OnFilter="setEventFilters" />
            </RadzenStack>

        </RadzenStack>


        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenLabel Text="All courses" Style="font-size:0.8rem; margin-top:6px" Component="courseswitch" />
                <RadzenSwitch Value="@showAllCourses" Change="setAllCourseFilter" Name="courseswitch" />
            </RadzenStack>
            <RadzenStack>
                <CourseTypeToggleButtonsComponent OnFilter="setCourseFilters" InitialFilters="courseTypeFilters" />
            </RadzenStack>

        </RadzenStack>

    </RadzenStack>
    <RadzenScheduler @ref="@scheduler"
        TItem="ICalendarEvent"
                     Data="@filteredData"
                     StartProperty="StartDateAndTime"
                     EndProperty="EndDateAndTime"
                     TextProperty="Title"
                     AppointmentRender="OnAppointmentRender"
                     AppointmentSelect="OnAppointmentClick"
                     AppointmentMouseEnter="OnMouseOverAppointment"
                     AppointmentMouseLeave="OnMouseLeaveAppointment"
                     SlotRender="OnSlotRender"
                     SelectedIndex="1"
                     LoadData="OnLoadData"
                     style="height: 100%">

        <Template Context="context" >
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.NoWrap">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
                    <RadzenIcon Icon="@(getAppointmentIcon(context))"  />
                    @if (context is CourseSession)
                    {
                        <RadzenIcon Icon="@(getCourseSessionIcon(context))" />
                    }
                </RadzenStack>
                <span style="white-space: nowrap;  overflow: hidden;  text-overflow: ellipsis; font-size:0.9rem;">@context.Title</span>

            </RadzenStack>

        </Template>
        <ChildContent>

            <RadzenWeekView Text="@IconsTextsAndColors.Texts.SCHEDULER_WEEK" TimeFormat="HH:mm" MinutesPerSlot="15" />
            <RadzenMonthView MaxAppointmentsInSlot="4" Text="@IconsTextsAndColors.Texts.SCHEDULER_MONTH" MoreText="More..." />
            <RadzenYearView Text="@IconsTextsAndColors.Texts.SCHEDULER_YEAR" />
            <RadzenYearPlannerView Text="@IconsTextsAndColors.Texts.SCHEDULER_PLANNER" />
            <RadzenYearTimelineView Text="@IconsTextsAndColors.Texts.SCHEDULER_TIMELINE" />

        </ChildContent>

    </RadzenScheduler>

</RadzenStack>

<style>
    .holiday {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .holiday:after {
            text-align:end;
            font-size:0.7rem;
            text-decoration: underline;
            font-style:italic;
            content: attr(after-text);
            margin-left:2px;
            margin-top:2px;
        }
</style>