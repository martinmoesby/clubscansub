<style>
    .holiday {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .holiday:after {
            text-align:end;
            font-size:0.7rem;
            text-decoration: underline;
            font-style:italic;
            content: attr(after-text);
            margin-left:2px;
            margin-top:2px;
        }
