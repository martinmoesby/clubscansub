@page "/account/login"
@page "/login"
@using ClubScansub.Models.DTO

<PageTitle>Club Scansub Login </PageTitle>

<RadzenStack Gap="20" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height:100%">
    <RadzenCard Class="rz-shadow-1 rz-border-radius-6 rz-p-6">

        <RadzenText TextStyle="TextStyle.DisplayH4">Login</RadzenText>

        <RadzenTemplateForm Data=@("LoginUserDTO")>
            <RadzenLogin FormFieldVariant="Variant.Outlined"
                         Login="@(args => onLogin(args))"
                         Register="@onRegister"
                         AllowResetPassword="false"
                         ResetPassword="@onRegister"
                         ResetPasswordText="Forgot your password??"
                         AllowRememberMe="true"
                         RememberMe="false"
                         RememberMeText="Remember me"
                         AllowRegister="true"
                         RegisterText="Create membership request"
                         RegisterMessageText="Not member yet? - create member request here..."
                         AutoComplete="false">

            </RadzenLogin>

        </RadzenTemplateForm>

    </RadzenCard>
</RadzenStack>
