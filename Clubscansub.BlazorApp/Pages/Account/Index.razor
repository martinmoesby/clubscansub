@page "/profile"
@using ClubScansub.Extensions
@using ClubScansub.Service
<AuthorizeView>
    <NotAuthorized>
        <Redirect ToPage="account/login" />
    </NotAuthorized>
</AuthorizeView>

<PageTitle>Club Scansuib My Profile</PageTitle>
<RadzenText TextStyle="TextStyle.DisplayH6" Text="Profile management" />
@if (IsLoading)
{
    <RadzenStack Style="height:100%;width:100%" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle=" TextStyle.Overline" Text="Loading..." />
    </RadzenStack>
}
else
{



    <RadzenTabs TabPosition="TabPosition.Top" SelectedIndex="0" >

        <Tabs>
            <RadzenTabsItem Text="My Profile" Icon="@IconsTextsAndColors.Icons.USER">
                <ProfileDetailsComponent User="@currentUser" UserRoles="@roles" OnSaveChanges="saveUserProfile"/>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Balance" Icon="@IconsTextsAndColors.Icons.AMOUNT" >
                <ProfileAccountBalanceComponent Entries="@currentUser.AccountTransactions" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Certificeringer" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_PRO_COURSE" >
                <ProfileCertificatesComponent Certificates="@currentUser.Certificates" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Eksterne konti" Visible="false" />
            <RadzenTabsItem Text="Password" Icon="@IconsTextsAndColors.Icons.USER_CHECK">
                <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start">
                    <RadzenTemplateForm TItem="ChangePasswordModel" Data=@changePassword Submit=@onChangePasswordSubmitAsync InvalidSubmit=@onInvalidSubmit>

                    <RadzenFormField Variant="Variant.Outlined" Text="Current Password" Style="width:100%">
                            <RadzenPassword @bind-Value="@changePassword.CurrentPassword" />
                    </RadzenFormField>

                    <RadzenFormField Variant="Variant.Outlined" Text="New Password" Style="width:100%">
                            <RadzenPassword @bind-Value="@changePassword.NewPassword" Name="newPasswordComponent" />
                    </RadzenFormField>

                    <RadzenFormField Variant="Variant.Outlined" Text="Repeat new password" Style="width:100%">
                            <RadzenPassword @bind-Value="@changePassword.RepeatPassword" Name="repeatPasswordComponent" />
                            <RadzenCompareValidator Visible="true" Component="repeatPasswordComponent" Value="@changePassword.NewPassword" Text="New Password does not match" ValidateOnComponentValueChange="true" />
                    </RadzenFormField>
                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Text="Change Password" class="rz-mt-3" />
                    </RadzenTemplateForm>

                </RadzenStack>
                @* <ProfileResetPasswordComponent /> *@
            </RadzenTabsItem>
            <RadzenTabsItem Text="Slet konto" Icon="delete" Style="color:var(--rz-color-danger)" />
        </Tabs>
    </RadzenTabs>
}


@code {
    [Inject]
    AuthenticationStateProvider authenticationStateProvider { get; set; }

    [Inject]
    MemberService memberService { get; set; }

    [Inject]
    UserService userService { get; set; }

    [Inject]
    NotificationService notificationService { get; set; }

    ApplicationUser currentUser = new();

    IList<string> roles = new List<string>();

    bool IsLoading = true;

    private ChangePasswordModel changePassword = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity.IsAuthenticated)
            {
                currentUser = await memberService.GetAsync(authState.User.GetIdentityId());
                roles = await userService.GetRolesByUserId(currentUser);


                IsLoading = false;
                StateHasChanged();

            }
        }
    }

    private async void saveUserProfile(ApplicationUser user)
    {
        try
        {
            user.Roles = roles.ToArray();
            currentUser = await memberService.UpdateAsync(user);
            notificationService.Notify(new NotificationMessage() {  
                Detail =  $"Profile '{currentUser.Name}' has been updated",
                Severity = NotificationSeverity.Info,
            });
            StateHasChanged();

        }
        catch (Exception ex)
        {
            notificationService.Notify(new NotificationMessage()
                {
                    Summary = $"Profile '{currentUser.Name}' has NOT been updated",
                    Detail = ex.Message,
                    Severity = NotificationSeverity.Error,
                });

        }
    }

    private async Task onChangePasswordSubmitAsync(ChangePasswordModel model)
    {
        var result = await userService.ChangePassordAsync(currentUser, model.CurrentPassword, model.NewPassword);
        if (result.Succeeded)
        {
            notificationService.Notify(new NotificationMessage()
                { 
                    Severity = NotificationSeverity.Success,
                    Detail = "Your password has succesfully been changed",
                    Summary = "Password Changed"
                });
            return;
        }
        NotificationMessage errorMessage = new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Password not changed"
            };
        foreach (var item in result.Errors)
        {
            errorMessage.Detail += item.Description + "\n";
        }
        notificationService.Notify(errorMessage);
    }

    private void onInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
        
    }
    private class ChangePasswordModel
    {
        public string CurrentPassword { get; set; }
        public string NewPassword { get; set; }
        public string RepeatPassword { get; set; }

    }
}