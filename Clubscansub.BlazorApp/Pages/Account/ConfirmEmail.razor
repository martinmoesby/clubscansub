@page "/account/confirmemail"


<RadzenStack Gap="0" Class="rz-my-auto rz-mx-auto rz-border-radius-1 rz-shadow-1" Style="width: 480px;">
    <RadzenCard Class="rz-shadow-0 rz-border-radius-0 rz-p-6" style="text-align: center;">
        <RadzenText TextStyle="TextStyle.DisplayH4">Email confirmed</RadzenText>
        
        <RadzenText TextStyle="TextStyle.Body1">
            Thank you for confirming your email address. 
        </RadzenText>
        <RadzenLink Icon="login" Path="/account/login">
            Procedd to login
        </RadzenLink>

    </RadzenCard>
</RadzenStack>