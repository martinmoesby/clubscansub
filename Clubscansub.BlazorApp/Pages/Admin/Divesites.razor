@page "/admin/events"
<PageTitle>Club Scansub Event management</PageTitle>
<RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Stretch" Style="height:100%">

    <RadzenStack>
        <RadzenText TextStyle="TextStyle.DisplayH6" Text="Divesite management" />
    </RadzenStack>

    <RadzenTabs TabPosition="TabPosition.Top">
        <Tabs>
            <RadzenTabsItem Text="Active events">
                <DivesiteEventsListComponent ActiveEventsOnly="true" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Completed events">
                <DivesiteEventsListComponent CompletedEventsOnly="true" ActiveEventsOnly="false" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Divesites">
                <DivesiteListComponent />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

</RadzenStack>
