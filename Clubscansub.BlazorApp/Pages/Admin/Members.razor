@page "/admin/members"
<PageTitle>Member management</PageTitle>
<RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Stretch" Style="height:100%">
    <RadzenStack>
        <RadzenText TextStyle="TextStyle.DisplayH6" Text="Member management" />
        <SearchComponent Reset="@resetSearchFilter" Search="@applySearchFilter" />
    </RadzenStack>
    <RadzenDataGrid Data="@members"
                    @ref=@grid
                    @bind-Value=@selectedMembers
                    TItem="ApplicationUser"
                    AllowVirtualization="true"
                    AllowAlternatingRows="false"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowFiltering="false"
                    AllowColumnPicking="true"
                    ShowPagingSummary="true"
                    FilterMode="FilterMode.Simple"
                    LogicalFilterOperator="LogicalFilterOperator.Or"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    PageSize="15"
                    Style="width:100%;height:100%;"
                    SelectionMode="DataGridSelectionMode.Single"
                    ColumnsText="Optional info..."
                    RowDoubleClick="@onRowDblCLick"
                    CellContextMenu="@onCellContextMenu">
        <HeaderTemplate>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%;" Gap="5" AlignItems="AlignItems.Center">

                <MemberRolesComponent MemberRolesChanged="setRoleFilter" ShowStatusFilter="true" MemberStatusFilterChanged="setStatusFilter" Orientation="Orientation.Horizontal" IsLoading=@isLoading InitialRoles="@roleFilter" ShowLabel="true" Alignment="AlignItems.Center" Justify="JustifyContent.SpaceBetween" />

                <RadzenButton Icon="person_add" Click="onCreateNewMemberClick" Size="ButtonSize.Small" class="rz-mr-4" />

            </RadzenStack>

        </HeaderTemplate>

        <LoadingTemplate>
            <RadzenProgressBarCircular />
        </LoadingTemplate>

        <Columns>
            <RadzenDataGridColumn Pickable="false" TItem="ApplicationUser" Title="Profile status" Filterable=false Width="120px" MinWidth="120px" Frozen="true">
                <Template Context="member">
                    <ProfileStatusComponent Profile="@member" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Pickable="false" TItem="ApplicationUser" Title="Acc. number" Property="AccountNumber" Width="100px" MinWidth="100px" Frozen="true"></RadzenDataGridColumn>
            <RadzenDataGridColumn Pickable="false" TItem="ApplicationUser" Title="Name" Property="Name" Width="200px" Frozen="true"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="true" TItem="ApplicationUser" Title="Address" Property="Streetaddress" Filterable=false MinWidth="240px"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="false" TItem="ApplicationUser" Title="Postcode" Property="PostalCode" Filterable=false Width="120px"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="false" TItem="ApplicationUser" Title="City" Property="City" Filterable=false Width="180px"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="true" TItem="ApplicationUser" Title="Phone" Property="PhoneNumber" Filterable=false Width="120px"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="true" TItem="ApplicationUser" Title="Mail" Property="Email" Filterable=false MinWidth="120px"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="false" TItem="ApplicationUser" Title="Birthday" Property="DayOfbirth" Filterable=false FormatString="{0:d}" Width="120px" MinWidth="120px"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible="true" TItem="ApplicationUser" Title="Balance" Property="Balance" Filterable=false FormatString="{0:c2}" TextAlign="TextAlign.Right" Width="120px"></RadzenDataGridColumn>

        </Columns>

    </RadzenDataGrid>
</RadzenStack>

<style>
    .rz-custom-header {
        width: 100% !important
    }
</style>