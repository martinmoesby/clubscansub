@page "/admin/members"
@using ClubScansub.Models.DTO;
<h3>Members</h3>
@*   style="height:500px"   Data="@members"
    TItem="MemberDTO"
    AllowVirtualization="true"
    AllowPaging="true"
    AllowFiltering = "true"
    LoadData="@loadData"
    Count="@count"*@
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Stretch" AlignItems="AlignItems.Start">


    <RadzenDataGrid Data="@members" PageSize="15" TItem="MemberDTO"
                    AllowPaging="true"
                    AllowVirtualization="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    ShowPagingSummary="true"
                    FilterMode="FilterMode.Simple"
                    LogicalFilterOperator="LogicalFilterOperator.Or"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    AllowAlternatingRows=false
                    SelectionMode="DataGridSelectionMode.Single"
                    RowDoubleClick="@onRowDblCLick" Style="width:100%" >
        <HeaderTemplate>
            <div style="width:100%;border:1px solid red;margin:10px; padding:10px;">

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%">
                
                <RadzenButton Icon="person_add" Text="Add member" Click="onCreateNewMemberClick" />

                    <Clubscansub.BlazorApp.Components.Member.MemberRolesComponent MemberRolesChanged="setRoleFilter" Orientation="Orientation.Horizontal" IsLoading=@isLoading InitialRoles="@roleFilter" LabelText="Minimum Role membership" />

            </RadzenStack>

            </div>
        </HeaderTemplate>
        <LoadingTemplate>
            <RadzenProgressBarCircular />
        </LoadingTemplate>
        <Columns>
            <RadzenDataGridColumn Filterable=true Property="AccountNumber" TItem="MemberDTO" Title="Acc. number" Width="100px" MinWidth="100px" Frozen="true"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="Full name" Property="Name" Frozen="true" MinWidth="150px"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="Address" Property="Streetaddress" Filterable=false Width ="240px"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="Postcode" Property="PostalCode" Filterable=false Width="120px"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="City" Property="City" Filterable=false Width ="180px"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="Balance" Property="Balance" Filterable=false FormatString ="{0:c2}" Width="80px"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="Birthday" Property="DayOfbirth" Filterable=false FormatString ="{0:d}" Width="120px" MinWidth="120px"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberDTO" Title="Profile status" Filterable=false Width="180px" MinWidth="120px">
                <Template Context="member">
                    <Clubscansub.BlazorApp.Components.Member.ProfileStatusComponent Profile="@member" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
 
</RadzenStack>