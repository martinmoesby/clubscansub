@page "/admin/courses"
<AuthorizeView Roles="Administrator">
    <NotAuthorized>
        <Redirect ToPage="profile"/>
    </NotAuthorized>
</AuthorizeView>

<PageTitle>Club Scansub Course Management</PageTitle>
<RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Stretch" Style="height:100%">

    <RadzenStack>
        <RadzenText TextStyle="TextStyle.DisplayH6" Text="Course management" />
    </RadzenStack>

    <RadzenTabs RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Text="Active courses">
                <CourseListComponent ActiveCoursesOnly="true" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Completed courses">
                <CourseListComponent ActiveCoursesOnly="false" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Course templates">
                <CourseTemplatesComponent />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>


</RadzenStack>