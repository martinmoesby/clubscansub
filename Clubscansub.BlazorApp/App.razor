@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <CascadingValue Value="this">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@this.LayoutType">
                    <NotAuthorized>
                        <LoginDisplay />
                    </NotAuthorized>
                </AuthorizeRouteView>
            </CascadingValue>
        </Found>
        <NotFound>
            @*<Redirect />*@
            <PageTitle>OOPS - 404 Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <RadzenRow>
                    <RadzenColumn Size="12" style="margin-top: 5rem; margin-bottom: 5rem">
                        <RadzenText Text="Page not found" TextStyle="TextStyle.DisplayH1" style="margin: 0; margin-bottom: 2rem" TextAlign="TextAlign.Center" />
                        <RadzenText Text="Sorry, but there's nothing here!" TextStyle="TextStyle.H6" style="margin: 0" TextAlign="TextAlign.Center" TagName="TagName.P" />
                    </RadzenColumn>
                </RadzenRow>
            </LayoutView> 
        </NotFound>
    </Router>

</CascadingAuthenticationState>

@code {
    [CascadingParameter]
    private HttpContext httpContext { get; set; }

    [Inject]
    private ThemeService ThemeService { get; set; }

    private Type LayoutType = typeof(MainLayout);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var theme = "standard";
        ThemeService.SetTheme(theme);
    }

    public async void SetLayout(Type layout)
    {
        if (layout != LayoutType)
        {
            this.LayoutType = layout;
            StateHasChanged();
        }
    }


