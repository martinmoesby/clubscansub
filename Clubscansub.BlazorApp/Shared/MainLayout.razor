@using ClubScansub.Utility;
@inherits LayoutComponentBase
@* <RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu /> *@
<RadzenComponents />

<RadzenLayout style="grid-template-areas: 'rz-header' 'rz-sidebar rz-body' 'rz-sidebar rz-footer';">

    <RadzenHeader>
        <RadzenRow JustifyContent="JustifyContent.Start" Gap="0">

            <RadzenColumn Size="12">
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">

                    <RadzenStack JustifyContent="JustifyContent.Start" class="rz-pr-4" Orientation="Orientation.Horizontal">
                        <RadzenSidebarToggle Click="@SidebarToggleClick" Icon="menu"></RadzenSidebarToggle>
                        <RadzenLink Path="/">
                            <RadzenImage Path="@logoFilename" Style="height:55px;margin-bottom:10px"></RadzenImage>
                        </RadzenLink>
                    </RadzenStack>

                    <RadzenStack JustifyContent="JustifyContent.End" class="rz-pr-4" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <LoginDisplay />
                        <RadzenAppearanceToggle ButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Lighter" ToggleButtonStyle="ButtonStyle.Info" />
                    </RadzenStack>

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    <RadzenBody>
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-0" Style="width: 100%;height:100%">
            <RadzenColumn Size="12">
                <CascadingValue TValue="bool" Name="IsDarkTheme" Value="@isDarkTheme">
                    @Body
                </CascadingValue>
            </RadzenColumn>
        </RadzenRow>

    </RadzenBody>

    <RadzenSidebar @bind-Expanded=@sidebarExpanded Responsive=false style="z-index: 2; display: flex; flex-direction:column">

        <RadzenPanelMenu DisplayStyle="MenuItemDisplayStyle.Text">
            <RadzenPanelMenuItem Text="Calendar" Path="" Icon="calendar_month" />

            <AuthorizeView Roles="@Userroles.Member">
                <RadzenPanelMenuItem Text="Profile" Path="/profile/" Icon="person" />
            </AuthorizeView>

            <AuthorizeView Roles="@Userroles.Divepro">
                <RadzenPanelMenuItem Text="Workcalender" Path="/divepro/workcalendar" Icon="engineering" />
            </AuthorizeView>

            <AuthorizeView Roles="@adminroles">
                <RadzenPanelMenuItem Icon="admin_panel_settings" Text="Administration" Path="/admin/">
                    <RadzenPanelMenuItem Icon="groups" Text="Members" Path="/admin/members" />
                    <RadzenPanelMenuItem Icon="place" Text="Events" Path="/admin/events" />
                    <RadzenPanelMenuItem Icon="school" Text="Courses" Path="/admin/courses" />
                    <RadzenPanelMenuItem Icon="engineering" Text="Work" Path="/admin/work" />
                </RadzenPanelMenuItem>
            </AuthorizeView>

        </RadzenPanelMenu>

    </RadzenSidebar>


    <RadzenFooter>
        <RadzenRow>
            <RadzenColumn Size="2">
                <RadzenText Text="Klub Scansub" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            </RadzenColumn>
            <RadzenColumn Size="8">

            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenText Text="©2023 Martin Moesby" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            </RadzenColumn>
        </RadzenRow>

    </RadzenFooter>

</RadzenLayout>

@code {
    [Inject]
    private IServiceProvider serviceProvider { get; set; }

    private ThemeService themeService;

    private string logoFilename = "";
    private bool isDarkTheme = false;

    protected override void OnInitialized()
    {
        themeService = serviceProvider.GetService<ThemeService>();
        if (themeService != null )
        {
            themeService.ThemeChanged += OnThemeChanged;
            setLogoFileName();
        }
    }

    private void OnThemeChanged()
    {
        setLogoFileName();
        StateHasChanged();
    }

    private void setLogoFileName()
    {

        if (themeService.Theme.Contains("dark"))
        {
            isDarkTheme = true;
            logoFilename = "images/logo_neg.png";
        }
        else
        {
            isDarkTheme = false;
            logoFilename = "images/logo.png";
        }
    }

}