@using ClubScansub.Utility;
@inherits LayoutComponentBase
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<RadzenLayout style="grid-template-areas: 'rz-header' 'rz-sidebar rz-body' 'rz-footer';">
    
    <RadzenHeader>
        <RadzenRow JustifyContent="JustifyContent.Start"  Gap="0">

            <RadzenColumn Size="12">
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">

                    <RadzenStack JustifyContent="JustifyContent.Start" class="rz-pr-4" Orientation="Orientation.Horizontal">
                        <RadzenSidebarToggle Click="@SidebarToggleClick" Icon="menu"></RadzenSidebarToggle>
                        <RadzenImage Path="images/logo.png"></RadzenImage>
                    </RadzenStack>

                    <RadzenStack JustifyContent="JustifyContent.End" class="rz-pr-4">
                        <LoginDisplay />
                    </RadzenStack>

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>

    <RadzenBody Expanded="@sidebarExpanded">
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-0" Style="width: 100%;">
            <RadzenColumn Size="12">
            @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>

    <RadzenSidebar Expanded="@sidebarExpanded" style="z-index: 2; display: flex; flex-direction:column">

@*         <RadzenStack AlignItems="Radzen.AlignItems.Center" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
            <RadzenText Text="Clubscansub.BlazorApp" TextStyle="Radzen.Blazor.TextStyle.Subtitle1" class="rz-mb-0" style="color: var(--rz-sidebar-color);" />
        </RadzenStack> *@

        <RadzenPanelMenu Style="text-align: left; flex-grow:1">
            <RadzenPanelMenuItem Text="Calendar" Path="" Icon="calendar_month" />
            @*            <RadzenPanelMenuItem Icon="persons" Text="Members" Path="/admin/members" />*@
            <AuthorizeView Roles="@Userroles.Member">
                <RadzenPanelMenuItem Text="Profile" Path="/profile/" Icon="person"/>
            </AuthorizeView>

            <AuthorizeView Roles="@adminroles">
                <RadzenPanelMenuItem Text="Administration" Path="/admin/" Icon="admin_panel_settings">
                    <RadzenPanelMenuItem Icon="persons" Text="Member management" Path="/admin/members" />
                    <RadzenPanelMenuItem Icon="place" Text="Site management" Path="/admin/divesites" />
                    <RadzenPanelMenuItem Icon="school" Text="Course management" Path="/admin/coursemanagement" />
                    <RadzenPanelMenuItem Icon="engineering" Text="Work management" Path="/admin/workmanagement" />
                </RadzenPanelMenuItem>
            </AuthorizeView>

        </RadzenPanelMenu>



    </RadzenSidebar>


    <RadzenFooter>
        <RadzenRow>
            <RadzenColumn Size="2" >
                <RadzenText Text="Klub Scansub" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            </RadzenColumn>
            <RadzenColumn Size="8">

            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenText Text="©2023 Martin Moesby" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            </RadzenColumn>
        </RadzenRow>
@*         <RadzenStack AlignItems="Radzen.AlignItems.Center" Gap="0" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding);">
        </RadzenStack>
 *@    </RadzenFooter>
</RadzenLayout>

@code {
    string adminroles = $"{Userroles.Administrator},{Userroles.Owner}";
}