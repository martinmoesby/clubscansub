@using ClubScansub.Utility;
@inherits LayoutComponentBase
<RadzenComponents />

<RadzenLayout style="grid-template-areas: 'rz-header' 'rz-sidebar rz-body' 'rz-footer';">

    <RadzenHeader>
        <RadzenRow JustifyContent="JustifyContent.Start" Gap="0">

            <RadzenColumn Size="12">
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">

                    <RadzenStack JustifyContent="JustifyContent.Start" class="rz-pr-2" Orientation="Orientation.Horizontal">
                        <RadzenSidebarToggle Click="@SidebarToggleClick" Icon="menu"></RadzenSidebarToggle>
                        <RadzenLink Path="/">
                            <RadzenImage Path="@logoFilename" Style="height:55px;margin-bottom:10px"></RadzenImage>
                        </RadzenLink>
                    </RadzenStack>

                    <RadzenStack JustifyContent="JustifyContent.End" class="rz-pr-4" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10">
                        <AuthorizeView>
                            <RadzenStack JustifyContent=JustifyContent.Start Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                                <RadzenLabel Text="Select your preferred look" class="rz-mb-2" />
                            <RadzenDropDown 
                                Name="themeSelector" 
                                TValue="string" 
                                Value="@themeService.Theme" 
                                ValueChanged="changeTheme" 
                                Data="@Themes.Free"
                                            TextProperty=@nameof(Theme.Text) ValueProperty=@nameof(Theme.Value) />
                            <RadzenAppearanceToggle ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
                            </RadzenStack>
                        </AuthorizeView>
                        <LoginDisplay />
                    </RadzenStack>

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    <RadzenBody>
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-0" Style="width: 100%;height:100%">
            <RadzenColumn Size="12">
                <CascadingValue TValue="bool" Name="IsDarkTheme" Value="@isDarkTheme">
                    @Body
                </CascadingValue>
            </RadzenColumn>
        </RadzenRow>

    </RadzenBody>

    <RadzenSidebar @bind-Expanded=@sidebarExpanded Responsive=true ResponsiveMaxWidth="1024px" style="@($"z-index: 2; display: flex; flex-direction:column;width:{selectedMenuWidth}")" Position="SidebarPosition.Start">
        @*                 ButtonStyle="ButtonStyle.Base" 
                ToggleButtonStyle="ButtonStyle"
 *@
        <RadzenPanelMenu DisplayStyle="@menuItemDisplayStyle" ShowArrow="false" >
            <RadzenToggleButton 
                Size="ButtonSize.ExtraSmall" 
                Click="setMenuState" 
                Variant="Variant.Text" 
                Icon="chevron_left" 
                                ToggleIcon="chevron_right"
                Style="width:100%;text-align:end" />

            <RadzenPanelMenuItem Text="Calendar" Path="" Icon="calendar_month" />
            <AuthorizeView Roles="@Userroles.Member">
                <RadzenPanelMenuItem Text="Profile" Path="/profile/" Icon="person" />
            </AuthorizeView>

            <AuthorizeView Roles="@Userroles.Divepro">
                <RadzenPanelMenuItem Text="Work" Path="/divepro/workcalendar" Icon="engineering" />
            </AuthorizeView>

            <AuthorizeView Roles="@adminroles">
                <RadzenPanelMenuItem Icon="admin_panel_settings" Text="Administration">
                    <RadzenPanelMenuItem Icon="groups" Text="Members" Path="/admin/members" />
                    <RadzenPanelMenuItem Icon="place" Text="Events" Path="/admin/events" />
                    <RadzenPanelMenuItem Icon="school" Text="Courses" Path="/admin/courses" />
                    <RadzenPanelMenuItem Icon="engineering" Text="Work" Path="/admin/work" />
                </RadzenPanelMenuItem>
            </AuthorizeView>

        </RadzenPanelMenu>

    </RadzenSidebar>


    <RadzenFooter>
        <RadzenRow>
            <RadzenColumn Size="2">
                <RadzenText Text="Klub Scansub" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            </RadzenColumn>
            <RadzenColumn Size="8">

            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenText Text="©2023 Martin Moesby" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            </RadzenColumn>
        </RadzenRow>

    </RadzenFooter>

</RadzenLayout>

