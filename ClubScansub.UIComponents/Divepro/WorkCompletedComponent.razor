@using ClubScansub.Service

<RadzenDataGrid 
    AllowGrouping 
    AllowSorting
    Data="@instructorWork" 
    TItem="InstructorWork" 
    AllowFiltering 
    AllowAlternatingRows="false"
    Render="OnRender" 
    FilterMode="FilterMode.CheckBoxList" 
    HideGroupedColumn="false" 
    AllGroupsExpanded="false" 
    Style="flex:1" 
>

    <GroupHeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenText TextStyle="TextStyle.Body2">
                @($"{context.Data.Key}")
            </RadzenText>
            <RadzenText Text="@($"Total hours: {GetTotal(context).ToString("N2")}")" TextStyle="TextStyle.Body2" />
        </RadzenStack>
    </GroupHeaderTemplate>

    <Columns>

        <RadzenDataGridColumn Title="Instructor name" GroupProperty="@nameof(InstructorWork.InstructorName)" Width="200px" Filterable FilterProperty="@nameof(InstructorWork.InstructorName)" Property="@nameof(InstructorWork.InstructorName)">
            <Template Context="item">
                <RadzenText Text="@item.InstructorName" />
            </Template>
            <GroupFooterTemplate>
                @context.Data.Key - total:<b>@(String.Format("{0:n2}", context.Data.Items.Cast<InstructorWork>().Sum(x => x.Hours)))</b>
            </GroupFooterTemplate>

        </RadzenDataGridColumn>

        <RadzenDataGridColumn Title="Year" GroupProperty="@nameof(InstructorWork.Year)" Width="100px" Filterable FilterProperty="@nameof(InstructorWork.Year)" Property="@nameof(InstructorWork.Year)">
            <Template Context="item">
                <RadzenText Text="@item.Year.ToString()" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Title="Month" GroupProperty="@nameof(InstructorWork.Month)" Width="140px" SortProperty="@nameof(InstructorWork.MonthNumber)" Filterable Property="@nameof(InstructorWork.Month)">
            <Template Context="item">
                <RadzenText Text="@item.Month" />
            </Template>
        </RadzenDataGridColumn>


        <RadzenDataGridColumn Title="Course Name" GroupProperty="@nameof(InstructorWork.CourseName)" MinWidth="240px" Filterable="false">
            <Template Context="item">
                <RadzenText Text="@($"{item.CourseName} (Students: {item.Participants})")" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn GroupProperty="@nameof(InstructorWork.SessionName)" Width="240px" Title="Session" Filterable="false">
            <Template Context="item">
                <RadzenText Text="@item.SessionName" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Title="Date and duration" Groupable="false" Filterable="false">
            <Template Context="item">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Style="flex:1">
                    <RadzenText Text="@item.StartDate.ToString()" TextStyle="TextStyle.Caption" />
                    <RadzenText Text="@item.EndDate.ToString()" TextStyle="TextStyle.Caption" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Property="@nameof(InstructorWork.Hours)" FormatString="{0:N2}" TextAlign="TextAlign.Right" Title="Total Hours" Filterable="false">

        </RadzenDataGridColumn>


    </Columns>
</RadzenDataGrid>

@code {
    [Inject]
    public CourseService courseService { get; set; }

    private IEnumerable<InstructorWork> instructorWork;

    private bool isLoading = true;
    private int count = 0;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        // Console.WriteLine("OnInitializedAsync:" + (instructorWork == null).ToString());
        // var data = await courseService.GetCourseSessionInstructorAsync();
        // instructorWork = data.Select(x => new InstructorWork()
        //     {
        //         CourseId = x.CourseSession.Course.Id,
        //         CourseName = x.CourseSession.Course.CourseName,
        //         SessionId = x.CourseSessionId,
        //         SessionName = x.CourseSession.SessionName,
        //         InstructorId = x.InstructorId,
        //         InstructorName = x.Instructor.Name,
        //         StartDate = x.CourseSession.StartDateAndTime,
        //         EndDate = x.CourseSession.EndDateAndTime,
        //         Duration = x.CourseSession.Duration
        //     }).AsQueryable();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        Console.WriteLine("OnAfterRenderAsync:" + (instructorWork == null).ToString());
        if (firstRender)
        {
            var data = await courseService.GetCourseSessionInstructorAsync();
            instructorWork = data.Where(x=>x.InstructorApproved == true).Select(x => new InstructorWork()
                {
                    CourseId = x.CourseSession.Course.Id,
                    CourseName = x.CourseSession.Course.CourseName,
                    Participants = x.CourseSession.Course.Participants.Count + (x.CourseSession.Course.FixedParticipants ?? 0),
                    SessionId = x.CourseSessionId,
                    SessionName = x.CourseSession.SessionName,
                    InstructorId = x.InstructorId,
                    InstructorName = x.Instructor.Name,
                    StartDate = x.CourseSession.StartDateAndTime,
                    EndDate = x.CourseSession.EndDateAndTime,
                    Duration = x.CourseSession.Duration
                }).AsQueryable().Where(x=>x.Participants != 0);

            StateHasChanged();
        }
    }


    void OnRender(DataGridRenderEventArgs<InstructorWork> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Groups.Add(new GroupDescriptor() { Property = nameof(InstructorWork.InstructorName), SortOrder = SortOrder.Descending, Title = "Instructor" });
            args.Grid.Groups.Add(new GroupDescriptor() { Property = nameof(InstructorWork.Year), SortOrder = SortOrder.Descending, Title = "Year" });
            args.Grid.Groups.Add(new GroupDescriptor() { Property = nameof(InstructorWork.Month), Title = "Month" });
            args.Grid.CollapseAll();

            args.Grid.Sorts.Add(new SortDescriptor() { Property = nameof(InstructorWork.InstructorName), SortOrder = SortOrder.Ascending });
            args.Grid.Sorts.Add(new SortDescriptor() { Property = nameof(InstructorWork.Year), SortOrder = SortOrder.Ascending });
            args.Grid.Sorts.Add(new SortDescriptor() { Property = nameof(InstructorWork.MonthNumber), SortOrder = SortOrder.Ascending });

            StateHasChanged();
        }
    }

    private double GetTotal(Group group)
    {
        try
        {
            Console.WriteLine("Current Level:" + group.Level + ", Current Descriptor:" + group.GroupDescriptor.GetTitle());
            var data = group.Data.Items.Cast<InstructorWork>();
            return data.Sum(x => x.Hours);
            // return 0;

        }
        catch (Exception ex)
        {
            Console.WriteLine(group.Data.Key);
            Console.WriteLine(group.Data.Items.Cast<InstructorWork>().Count().ToString());
            Console.WriteLine(ex.Message);
            return 0;
        }
    }

    private void loadColumnFilterData(DataGridLoadColumnFilterDataEventArgs<InstructorWork> args)
    {
        // Get the property name in OData format. Sub-properties are separated by /.
        var property = args.Column.GetFilterProperty();

        if (property == "InstructorName")
        {
            var result = instructorWork.Select(x => x.InstructorName).Distinct();
            args.Count = result.Count();
            args.Data = result;

        }

        if (property == nameof(InstructorWork.Year))
        {
            var result = instructorWork.Select(x => x.Year).Distinct();
            args.Count = result.Count();
            args.Data = result;
        }

        args.Count = 0;
        args.Data = null;
    }

    private class InstructorWork
    {
        public string CourseName { get; set; }
        public int CourseId { get; set; }
        public int Participants { get; set; }
        public string SessionName { get; set; }
        public int SessionId { get; set; }
        public string InstructorId { get; set; }
        public string InstructorName { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public TimeSpan Duration { get; set; }

        public int Year => StartDate.Year;
        public string Month => StartDate.ToString("MMMM");
        public int MonthNumber => StartDate.Month;
        public double Hours => Duration.TotalHours;


    }
}
