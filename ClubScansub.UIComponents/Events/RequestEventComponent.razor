@using ClubScansub.Service
@using System.Threading.Tasks
<RadzenStack orientation="Orientation.Vertical" Style="width:100%;height:100%;">

    <RadzenStack Orientation="Orientation.Horizontal" Gap="10px">

        <RadzenStack Style="width:50%">
            <RadzenText TextStyle="TextStyle.Body1">Select proposed dates for the event:</RadzenText>
            <RadzenDatePicker TValue="DateTime" Style="width:100%;" Placeholder="Propose date..." ShowTime="false" Change="@((args) => addProposedDate(args))" />
        </RadzenStack>

        <RadzenStack Style="width:50%">

            <RadzenText TextStyle="TextStyle.Body1">Select divers to invite:</RadzenText>
            <RadzenDropDown @bind-Value="selectedDivers" Data="@diverSelections" TextProperty="Name" ValueProperty="Name" Multiple AllowFiltering FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterAutoCompleteType="AutoCompleteType.On">
            </RadzenDropDown>
        </RadzenStack>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal">

        <RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" Text="Proposed dates:" />
            <RadzenListBox Data="proposedDates" TValue="string" Style="height:140px;" />
        </RadzenStack>

        <RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" Text="Divers:" />
            <RadzenText Text="@string.Join(", ", selectedDivers)" />
        </RadzenStack>

    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton Text="Send Request" Icon="send" Style="margin-top:10px;" Click="@OnSubmitRequest" Size="ButtonSize.Small" />
    </RadzenStack>

</RadzenStack>

@code {
    [Inject]
    private UserService UserService { get; set; }

    [Parameter]
    public Divelocation Divesite { get; set; }

    [Parameter]
    public EventCallback<Models.DTO.RequestEventDTO> OnRequestSubmitted { get; set; }

    private Models.DTO.RequestEventDTO requestEvent;

    private IEnumerable<DiverSelection> diverSelections = [];

    private class DiverSelection
    {
        public string Id { get; set; }
        public string Name { get; set; }
    }


    private async Task<IEnumerable<DiverSelection>> GetDivers()
    {
        // Fetch divers from the UserService
        var users = await UserService.GetUsersByRolesAsync(Userroles.Member);
        return users.Select(x => new DiverSelection
        {
            Id = x.Id,
            Name = x.Name
        }).ToList().AsEnumerable();
    }

    private List<string> selectedDivers = new List<string>();
    private DateTime selectedDate;

    private string[] divers = [];
    private DateOnly[] proposedDates = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            diverSelections = await GetDivers();
            StateHasChanged();
        }
    }

    private void addProposedDate(DateTime? value)
    {
        if (value != null)
        {
            proposedDates = [.. proposedDates, DateOnly.FromDateTime(value!.Value)];
        }
    }

    private void OnSubmitRequest()
    {
        divers = selectedDivers.ToArray();
        requestEvent = new Models.DTO.RequestEventDTO(Divesite.Id, proposedDates, divers);
        // Logic to handle the event request submission
        OnRequestSubmitted.InvokeAsync(requestEvent);
    }

    private void removeItemFromList(string listName, object item)
    {

    }
}
