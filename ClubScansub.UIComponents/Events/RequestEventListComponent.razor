<RadzenStack Gap="5">

    <RadzenDataGrid TItem="EventRequest" Data="@Requests" RowRender="onRowRender">
        <Columns>

            <RadzenDataGridColumn Title="Divesite" Visible="@(DivesiteId == -1)" Width="360px;">
                <Template>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
                        <RadzenStack Style="width:160px;height:80px;overflow:hidden;position:relative">
                            <img src="@ImageUtils.GetImageSrc(context.Divelocation.Image?.ImageData)" class="img rounded h-100" style="object-fit:cover" />
                        </RadzenStack>
                    <RadzenText TextStyle="TextStyle.H6" Text="@context.Divelocation.Name" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Title="Request message">
                <Template>
                    <RadzenText TextStyle="TextStyle.Body1" Text="@context.Notes" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Title="Requested by" Width="180px;">
                <Template>
                    <RadzenText TextStyle="TextStyle.Caption">@context.Requester?.Name</RadzenText>
                </Template>
            </RadzenDataGridColumn>

            <AuthorizeView Roles="@Userroles.Administrator" Context="adminsContext">
                <RadzenDataGridColumn Title="with" Width="240px;">
                    <Template>
                        <RadzenListBox PageSize="1" Data="@GetUsers(context).ToList()" TValue="ApplicationUser" TextProperty="@nameof(ApplicationUser.Name)" Style="width:100%" />
                    </Template>
                </RadzenDataGridColumn>
            </AuthorizeView>

            <RadzenDataGridColumn Title="Requested Dates" Width="140px">
                <Template>
                    <RadzenDropDown Data="@context.Dates" TValue="DateOnly" Value="@context.Dates.FirstOrDefault()" Change="@((args) => setSelectedDate(context.Id, args))" />
                </Template>
            </RadzenDataGridColumn>

            <AuthorizeView Roles="@Userroles.Administrator" Context="adminsContext">
                <RadzenDataGridColumn MaxWidth="80px" Width="80px">
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                            <RadzenButton Variant="Variant.Text" Icon="thumb_up" IconColor="@Colors.Success" Click="@(() => processRequest(context, true))"  Size="ButtonSize.Small"/>
                            <RadzenButton Variant="Variant.Text" Icon="thumb_down" IconColor="@Colors.Danger" Click="@(() => processRequest(context, false))" Size="ButtonSize.Small" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </AuthorizeView>

            <AuthorizeView Roles="@Userroles.Member" Context="adminsContext">
                <RadzenDataGridColumn Width="60px">
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenButton Variant="Variant.Text" Icon="@IconsTextsAndColors.Icons.USER_ADD" IconColor="@Colors.Primary" Click="@(() => signMeUp(context))" Visible="@(!context.AdditionalParticipants.Any(x=> x== currentUser.Id))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </AuthorizeView>
        </Columns>

    </RadzenDataGrid>

    <RadzenButton Click="@(() => OnProcessedComplete.InvokeAsync(Requests))" Icon="close" ButtonStyle="ButtonStyle.Success" Text="Close" Visible="@OnProcessedComplete.HasDelegate" />

</RadzenStack>
@code {
    [Inject]
    UserService UserService { get; set; }

    [Inject]
    DialogService dialogService { get; set; }

    [Inject]
    EventService eventservice { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    [Parameter]
    public int DivesiteId { get; set; } = -1;

    [Parameter]
    public EventCallback<List<EventRequest>> OnProcessedComplete { get; set; }

    private Dictionary<int, DateOnly?> selectedDates = new Dictionary<int, DateOnly?>();
    private List<EventRequest> Requests = [];
    private ApplicationUser currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        if (user != null && user.Identity.IsAuthenticated)
        {
            var userId = user.GetIdentityId();
            currentUser = await UserService.GetUserAsync(new Guid(userId));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (DivesiteId != -1)

                Requests = await eventservice.GetEventRequestsForDivesiteAsync(DivesiteId);
            else
                Requests = (await eventservice.GetEventRequestsAsync()).Where(x => x.RequestProcessed == false).ToList();

            selectedDates = Requests.ToDictionary(r => r.Id, r => (DateOnly?)null);
            StateHasChanged();
        }
        
    }

    private DateOnly getSelectedDate(int requestId)
    {
        if (selectedDates.TryGetValue(requestId, out var date))
        {
            return date ?? default;
        }
        return default;
    }

    private void setSelectedDate(int requestId, object date)
    {
        if (date is DateOnly)
            selectedDates[requestId] = (DateOnly)date;
    }

    private async void signMeUp(EventRequest request)
    {
        request.AdditionalParticipants.Add(currentUser.Id);
        Requests =  await eventservice.UpdateEventRequestsAsync(request);
        StateHasChanged();
    }

    private IEnumerable<ApplicationUser> GetUsers(EventRequest request)
    {
        foreach (var item in request.AdditionalParticipants)
        {
            yield return UserService.GetUser(Guid.Parse(item));
        }

    }

    private void onRowRender(RowRenderEventArgs<EventRequest> args)
    {
        if (args.Data.Requester != null)
        {
            setSelectedDate(args.Data.Id, args.Data.Dates.FirstOrDefault());
        }
    }   

    private async void processRequest(EventRequest request, bool approved)
    {
        if (approved)
        {
            DateOnly selectedDate = getSelectedDate(request.Id);
            var @event = await eventservice.CreateEventFromRequest(request, selectedDate);
            request.EventId = @event.Id;
            await eventservice.ApproveEventRequest(request, @event);

        }
        else
        {
            await eventservice.DenyEventRequest(request);
        }

        Requests = await eventservice.GetEventRequestsForDivesiteAsync(DivesiteId);
        selectedDates = Requests.ToDictionary(r => r.Id, r => (DateOnly?)null);
        StateHasChanged();

    }

}
