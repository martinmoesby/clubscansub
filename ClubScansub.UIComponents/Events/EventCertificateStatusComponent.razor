@if (Certificate != null)
{
    <RadzenStack Gap="3">

        <RadzenText Text="Certificate requirement" TextStyle="TextStyle.Subtitle2" Style="" />

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Normal">

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal" Gap="5">
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Shade="Shade.Default" Variant="Variant.Text">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Style="padding: 0 0.25rem 0 0; text-transform: none;">
                        <RadzenIcon Icon="license" IconColor="@Colors.Info" IconStyle="IconStyle.Info" />
                        <RadzenText Text="@(Certificate.ShortName)" TextStyle="TextStyle.Body1" class="rz-color-info" />
                    </RadzenStack>
                </RadzenBadge>
            </RadzenStack>

            <RadzenStack Visible=@(currentUser != null)>
                @if (currentUser.Certificates != null && (currentUser.Certificates.Any(c => c.Id == Certificate.Id) || currentUser.Certificates.Any(x => x.Certificate?.DepthLimit > Event.Divelocation.MinDepth)))
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Shade="Shade.Light" Variant="Variant.Text">
                        <RadzenIcon Icon="thumb_up" IconColor="@Colors.Success" IconStyle="IconStyle.Success" title="You are certified" />
                    </RadzenBadge>
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Shade="Shade.Light" Variant="Variant.Text">
                        <RadzenIcon Icon="thumb_down" IconColor="@Colors.Warning" IconStyle="IconStyle.Warning" title="You are not certified?" />
                    </RadzenBadge>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenStack>
}

@code {

    [Parameter]
    public Event Event { get; set; }

    [Parameter]
    public Certificate Certificate { get; set; }

    [Parameter]
    public ApplicationUser currentUser { get; set; }

}
