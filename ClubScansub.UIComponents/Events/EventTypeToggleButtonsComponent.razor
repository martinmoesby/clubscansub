@using ClubScansub.Utility
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="@Alignment" AlignItems="AlignItems.Center" Style="width:100%" Gap="5">
    @Start
    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.Bådtur)" ToggleShade="Shade.Dark"    ToggleButtonStyle="ButtonStyle.Success" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_BOAT" Value="getEventFilter(EventTypeEnum.Bådtur)" Change="@((args) => setEventFilter(EventTypeEnum.Bådtur))" />
    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.Klubture)" ToggleShade="Shade.Default" ToggleButtonStyle="ButtonStyle.Success" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_CLUB" Value="getEventFilter(EventTypeEnum.Klubture)" Change="@((args) => setEventFilter(EventTypeEnum.Klubture))" />
    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.Stranddyk)" ToggleShade="Shade.Light"   ToggleButtonStyle="ButtonStyle.Success" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_BEACH" Value="getEventFilter(EventTypeEnum.Stranddyk)" Change="@((args) => setEventFilter(EventTypeEnum.Stranddyk))" class="rz-mr-2" />

    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.Other)" ToggleShade="Shade.Dark" ToggleButtonStyle="ButtonStyle.Info" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_OTHER" Value="getEventFilter(EventTypeEnum.Other)" Change="@((args) => setEventFilter(EventTypeEnum.Other))" />
    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.Rejse)" ToggleShade="Shade.Default" ToggleButtonStyle="ButtonStyle.Info" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_TRAVEL" Value="getEventFilter(EventTypeEnum.Rejse)" Change="@((args) => setEventFilter(EventTypeEnum.Rejse))" />
    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.Liveaboard)" ToggleShade="Shade.Light"   ToggleButtonStyle="ButtonStyle.Info" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_LIVEABOARD" Value="getEventFilter(EventTypeEnum.Liveaboard)" Change="@((args) => setEventFilter(EventTypeEnum.Liveaboard))" class="rz-mr-2" />

    <RadzenToggleButton Size="ButtonSize.Small" Visible="@isActive(EventTypeEnum.NotAnEvent)" ToggleShade="Shade.Default" ToggleButtonStyle="ButtonStyle.Danger" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_NOT_EVENT" Value="getEventFilter(EventTypeEnum.NotAnEvent)" Change="@((args) => setEventFilter(EventTypeEnum.NotAnEvent))" />

    @End
</RadzenStack>

@code {
    [Parameter]
    public bool SingleSelect { get; set; } = false;

    [Parameter]
    public RenderFragment? Start { get; set; }

    [Parameter]
    public JustifyContent Alignment { get; set; } = JustifyContent.Normal;

    [Parameter]
    public Dictionary<EventTypeEnum, bool> InitialFilters { get; set; } = new Dictionary<EventTypeEnum, bool>() {
            {    EventTypeEnum.Klubture, true },
            {    EventTypeEnum.Stranddyk, true },
            {    EventTypeEnum.Bådtur, true },
            {    EventTypeEnum.Liveaboard, false },
            {    EventTypeEnum.Rejse, false },
            {    EventTypeEnum.Other, false },
            {    EventTypeEnum.NotAnEvent, false }
        };

    [Parameter]
    public RenderFragment? End { get; set; }

    [Parameter]
    public EventCallback<Dictionary<EventTypeEnum, bool>> OnFilter { get; set; }

    private bool getEventFilter(EventTypeEnum type)
    {
        bool value = true;
        InitialFilters.TryGetValue(type, out value);
        return value;
    }

    private void setEventFilter(EventTypeEnum type)
    {
        bool typeExisits = InitialFilters.Any(x=>x.Key == type);

        if (SingleSelect)
        {
            foreach (var item in InitialFilters)
            {
                if (item.Key != type)
                    InitialFilters[item.Key] = false;
            }
        }
        if (typeExisits)
            InitialFilters[type] = !InitialFilters[type];
        OnFilter.InvokeAsync(InitialFilters);
    }

    private bool isActive(EventTypeEnum type)
    {
        return InitialFilters.Any(x => x.Key == type);
    }
}
