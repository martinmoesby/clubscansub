@using ClubScansub.Utility
@if (isLoading)
{
    <RadzenStack Style="height:580px;">
        <WaitLoadingComponent />
    </RadzenStack>
}
else
{
    <RadzenStack Gap="25" Style="height:500px;">

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="10" Style="flex:3">
            <RadzenStack Style="flex:1;">
                @if (Event.Divelocation?.Image != null)
                {
                    <img src="@ImageUtils.GetImageSrc(Event.Divelocation.Image.ImageData)" alt="@Event.Divelocation.Name" class="img rounded w-100" />

                }
                else
                {
                    <RadzenImage Path="/images/no_location_image.png" class="img rounded w-100" />
                }
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" Style="flex:2;" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal" Gap="25">
                <RadzenStack Gap="20">

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="" Gap="5">

                        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start">

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                                <RadzenIcon Icon="@IconsTextsAndColors.Icons.START_TIME" IconColor="@Colors.Success"></RadzenIcon>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@Event.StartDateAndTime.ToString("dd. MMMM yyyy kl. HH:mm")" />
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                                <RadzenIcon Icon="@IconsTextsAndColors.Icons.END_TIME" IconColor="@Colors.Danger"></RadzenIcon>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@Event.EndDateAndTime.ToString("dd. MMMM yyyy kl. HH:mm")" />
                            </RadzenStack>

                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start">

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                                <RadzenIcon Icon="vertical_align_top" IconColor="@Colors.InfoLight"></RadzenIcon>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@(Event.Divelocation?.MinDepth.ToString() + " meter")" />
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                                <RadzenIcon Icon="vertical_align_bottom" IconColor="@Colors.InfoDark"></RadzenIcon>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@(Event.Divelocation?.MaxDepth.ToString() + " meter")" />
                            </RadzenStack>

                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.End" AlignItems="AlignItems.End">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Stretch">
                                @if (isUserDivepro && Event.IsFreeForDivepros)
                                {
                                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT" IconColor="@Colors.SuccessDark"></RadzenIcon>
                                    <RadzenText TextStyle="TextStyle.Subtitle2">Free of Charge</RadzenText>
                                }
                                else if (isUserPremium)
                                {
                                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT" IconColor="@Colors.SuccessLight"></RadzenIcon>
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@Event.PremiumPrice?.ToString("C2")</RadzenText>
                                }
                                else
                                {
                                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT" IconColor="@Colors.SuccessDarker"></RadzenIcon>
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@Event.Price?.ToString("C2")</RadzenText>
                                }
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                                <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER"></RadzenIcon>
                                <RadzenText TextStyle="TextStyle.Subtitle2">@Event.FreeSpots of @Event.MaxParticipants</RadzenText>
                            </RadzenStack>

                        </RadzenStack>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Normal">
                        <SeatComponent Event="@Event" ShowText="true" Text="Seat status" Size="Utility.Enums.IconSizeEnum.Medium" />
                        <EventCertificateStatusComponent Certificate="Certificate" currentUser="@currentUser" Event="@Event" />
                    </RadzenStack>

                </RadzenStack>

            </RadzenStack>

        </RadzenStack>

        <RadzenStack Style="flex:5" AlignItems="AlignItems.Start">
            <RadzenTabs RenderMode="TabRenderMode.Server" SelectedIndex="0" TabPosition="TabPosition.Top" Style="width:100%;height:100%;">
                <Tabs>
                    <RadzenTabsItem Text="Description" Icon="@IconsTextsAndColors.Icons.INFORMATION">
                        <RadzenText TextStyle="TextStyle.Body2">@(Event?.Divelocation?.Description)</RadzenText>
                    </RadzenTabsItem>
                    <AuthorizeView Roles="Administrator, Owner, Divepro">
                        <RadzenTabsItem Text="Tilmeldte" Icon="@IconsTextsAndColors.Icons.ENROLLED">
                            @if (Event.StartDateAndTime > DateTime.Now)
                            {
                                <AuthorizeView Roles="Administrator, Owner" Context="action_buttons">
                                    <EventUserActionsComponent AddExistingUser="enrollExistingUser" ShowAddNewUser="false" Visible="Event.FreeSpots > 0 && !Event.IsCancelled" />
                                </AuthorizeView>
                            }
                            <EventUserListComponent EventUsers="@enrolledUsers" OnRemoveUser="removeUserFromEvent" OnReleaseSpot="releaseReservedSpot" Event="Event" />
                        </RadzenTabsItem>
                    </AuthorizeView>
                </Tabs>
            </RadzenTabs>
        </RadzenStack>

        <RadzenStack Style="flex:1;" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.End">
            @if (Event.StartDateAndTime > DateTime.Now)
            {
                <AuthorizeView Roles="Administrator">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenButton Click="cancelEvent" ButtonStyle="ButtonStyle.Danger" Shade="Shade.Dark" Size="ButtonSize.Small" Icon="cancel" Text="Cancel Event" Visible="!Event.IsCancelled" />
                        <RadzenButton Click="reactivateEvent" ButtonStyle="ButtonStyle.Success" Shade="Shade.Dark" Size="ButtonSize.Small" Icon="refresh" Text="Reactivate Event" Visible="Event.IsCancelled" />
                    </RadzenStack>
                </AuthorizeView>
            }

            <EventSignupButtons Event="@Event" currentUser="@currentUser" isUserDivepro=@isUserDivepro isUserPremium=@isUserPremium isUserSignedUp=@isUserSignedUp OnEnrollExistingUser="enrollExistingUser" />
        </RadzenStack>
    </RadzenStack>
}