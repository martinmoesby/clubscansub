@using ClubScansub.Models.Interface
@using ClubScansub.Service
@using ClubScansub.Utility
@using System.Globalization
@using Nager.Date
@using Nager.Date.Model

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="height:100%;">

    <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start" Style="flex:1;">
        <RadzenStack Style="flex:1">

            <RadzenStack Orientation="Orientation.Vertical" Style="flex:1;width:100%;" JustifyContent="JustifyContent.SpaceBetween">
                <EventTypeToggleButtonsComponent InitialFilters="initialEventTypeFilter" OnFilter="filterSitesList" SingleSelect="false">
                    <End>
@*                         <RadzenText Text="Divetype filter:" TextStyle="TextStyle.Caption" /> *@
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Style="flex:1" AlignItems="AlignItems.Center" Gap="5">
                            <RadzenToggleButton Size="ButtonSize.Small" title="Show pool/confined water locations" Change="changeDiveTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.PoolDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.PoolDive)" />
                            <RadzenToggleButton Size="ButtonSize.Small" title="Show nature/muck dive locations " Change="changeDiveTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.NatureDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.NatureDive)" />
                            <RadzenToggleButton Size="ButtonSize.Small" title="Show wreck dive locations" Change="changeDiveTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.WreckDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.WreckDive)" />
                            <RadzenToggleButton Size="ButtonSize.Small" title="Show Technical dive locations"  Change="changeDiveTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.TechDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.TechDive)" />
                        </RadzenStack>
                    </End>
                </EventTypeToggleButtonsComponent>
                <RadzenRadioButtonList Style="flex:1;width:100%;" class="rz-p-4 rz-border rz-border-color-base-700 rz-overflow-auto rz-border-radius-2" Data="@filteredDivesites" TValue="Divelocation" TextProperty="@nameof(Divelocation.Name)" Orientation="Orientation.Vertical" Value="selectedLocation" Change="@(args => setSelectedSite(args))" />
            </RadzenStack>

            <RadzenStack>

                <RadzenText Text="New Events to be created" TextStyle="TextStyle.Subtitle2" />
                <RadzenDataGrid Data="@newEvents" TItem="Event" @ref=eventsGrid AllowAlternatingRows="false">
                    <Columns>
@*                         <RadzenDataGridColumn Property="@nameof(Event.StartDateAndTime)" Title="Start Date" MinWidth="40px" Width="80px" FormatString="{0:dd-MM-yy}"/>
                        <RadzenDataGridColumn Property="@nameof(Event.EndDateAndTime)" Title="End Date" MinWidth="40px" Width="80px" FormatString="{0:dd-MM-yy}" />
 *@                        <RadzenDataGridColumn Title="Date" MinWidth="120px" Width="160px">
                            <Template Context="item">
                                <RadzenStack Orientation="Orientation.Vertical">
                                    <RadzenStack JustifyContent="JustifyContent.Start" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" >
                                        <RadzenIcon Icon="event_available" IconColor="@Colors.Success" Style="font-size:0.8rem" />
                                        <RadzenText Text="@item.StartDateAndTime.ToString("dd-MM-yy HH:mm")" TextStyle="TextStyle.Caption" />
                                    </RadzenStack>

                                    <RadzenStack JustifyContent="JustifyContent.Start" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="event_busy" IconColor="@Colors.Danger" Style="font-size:0.8rem" />
                                        <RadzenText Text="@item.EndDateAndTime.ToString("dd-MM-yy HH:mm")" TextStyle="TextStyle.Caption" />
                                    </RadzenStack>

                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Event" MinWidth="60px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                              <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Start">       
                                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Click="@(() => removeNewEvent(item))" />
                                    <RadzenText Text="@item.Title" TextStyle="TextStyle.Body2" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%" class="rz-mb-2">
            <RadzenButton ButtonStyle="ButtonStyle.Success" Shade="Shade.Light" Click="commitEvents" Text="Save events" Icon="save" Size="ButtonSize.Small" Variant="Variant.Text" />
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Shade="Shade.Light" Click="resetEvents" Text="Reset" Icon="cancel" Size="ButtonSize.Small" Variant="Variant.Text"/>
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start" Style="flex:3;">
        <PlannerComponent OnSlotClicked="addSelectedLocationAsEvent" DoReloadData="doReloadData" NewItems="eventsList" />
    </RadzenStack>
</RadzenStack>
<style>
    .scheduler-slot {
    }

        .scheduler-slot:hover {
            cursor: pointer;
            background-color: var(--rz-secondary-lighter) !important;
        }
</style>

@code {
    [Inject]
    EventService eventService { get; set; }

    [Inject]
    SiteService siteService { get; set; }

    [Inject]
    TooltipService tooltipService { get; set; }

    private RadzenDataGrid<Event> eventsGrid;

    private Divelocation? selectedLocation;
    private IList<Divelocation> divesites = new List<Divelocation>();
    private IList<Divelocation> filteredDivesites = new List<Divelocation>();


    private IList<Event> newEvents = new List<Event>();
    private IList<ICalendarEvent> eventsList = [];
    private bool doReloadData = false;

    private Dictionary<DiveTypeEnum, bool> diveTypeFilter = new Dictionary<DiveTypeEnum, bool>
    {
        { DiveTypeEnum.PoolDive, true },
        { DiveTypeEnum.NatureDive, true },
        { DiveTypeEnum.WreckDive, true },
        { DiveTypeEnum.TechDive, false },
    };
    private Dictionary<EventTypeEnum, bool> initialEventTypeFilter = new Dictionary<EventTypeEnum, bool>()
    {
        { EventTypeEnum.Bådtur, true},
        { EventTypeEnum.Stranddyk, true},
        { EventTypeEnum.Klubture, true},
        { EventTypeEnum.Rejse, false},
        { EventTypeEnum.Other, false}
    };


    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            divesites = await siteService.GetAllAsync();

            eventsList = [];
            filterSitesList(initialEventTypeFilter);
        }
    }

    private void setSelectedSite(Divelocation site)
    {
        selectedLocation = site;
    }

    private void filterSitesList(Dictionary<EventTypeEnum, bool> eventTypes)
    {
        var selectedEventtype = eventTypes.Where(x => x.Value == true).Select(x => x.Key);
        var selectedDiveTYpes = diveTypeFilter.Where(x => x.Value == true).Select(x => x.Key);
        filteredDivesites = divesites.Where(x => selectedEventtype.Contains(x.DefaultEventType) && selectedDiveTYpes.Contains(x.DiveType)).ToList();
        StateHasChanged();
    }

    private void changeDiveTypeFilter()
    {
        filterSitesList(initialEventTypeFilter);
    }

    private void addSelectedLocationAsEvent(SchedulerSlotSelectEventArgs args)
    {
        if (selectedLocation == null)
            return;
        if (args.Start < DateTime.Now)
            return;

        args.PreventDefault();
        DateTime start = args.Start.Date.Add(selectedLocation.DefaultStartTime);
        int days = selectedLocation.DefaultDays > 0 ? selectedLocation.DefaultDays - 1 : 0;
        DateTime end = start.Add(selectedLocation.DefaultDuration).AddDays(days);

        var newEvent = new Event()
            {
                Title = selectedLocation.Name,
                Divelocation = selectedLocation,
                StartDateAndTime = start, //args.Start.Date.Add(selectedLocation.DefaultStartTime),
                EndDateAndTime = end, // args.Start.Date.Add(selectedLocation.DefaultStartTime).Add(selectedLocation.DefaultDuration).AddDays(selectedLocation.DefaultDays-1),
                EventType = selectedLocation.DefaultEventType,
                Details = selectedLocation.Description,
                MinParticipants = selectedLocation.MinParticipants,
                MaxParticipants = selectedLocation.MaxParticipants,
                Price = selectedLocation.Price,
                PremiumPrice = selectedLocation.Price,
                Address = selectedLocation.MeetingLocation,
                RequiredCertificate = selectedLocation.Certificate,
                FixedParticipants = 0
            };
        newEvents.Add(newEvent);
        InvokeAsync(eventsGrid.RefreshDataAsync);

        eventsList = newEvents.ToList<ICalendarEvent>();

        StateHasChanged();
    }




    private void removeNewEvent(Event item)
    {
        newEvents.Remove(item);
        InvokeAsync(eventsGrid.RefreshDataAsync);

        eventsList = newEvents.ToList<ICalendarEvent>();

    }

    private async void commitEvents()
    {
        await eventService.CreateEventsAsync(newEvents);
        doReloadData = true;
        resetEvents();
        // await courseService.AddAsync(newCourses);
        // existingCourses = await courseService.GetAllAsync();
        // resetCourses();
    }
    private void resetEvents()
    {
        newEvents = [];
        eventsList = [];
        // scheduler.Reload();
        StateHasChanged();
    }
}
