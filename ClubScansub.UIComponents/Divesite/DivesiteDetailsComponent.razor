@using ClubScansub.Utility
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<RadzenTemplateForm Data="@Divesite"
                    TItem="Divelocation"
                    Submit="@((Divelocation divelocation) => UpdateDivesiteCallback.InvokeAsync(divelocation))"
                    InvalidSubmit="@onInvalidSubmit">
    <RadzenRow class="rz-mb-4">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Divesite name" Variant="Variant.Outlined" Style="width:100%;">
                <RadzenTextBox @bind-Value="@Divesite.Name" Style="font-size:1.6rem;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Style="height:375px">
        <RadzenColumn Size="12">
            <RadzenTabs RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Top">
                <Tabs>
                    <RadzenTabsItem Text="Info" Icon="@IconsTextsAndColors.Icons.INFORMATION">
                        <RadzenRow>


                            <RadzenColumn Size="7">
                                <RadzenRow AlignItems="AlignItems.Stretch">
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width:100%">
@*                                             <RadzenHtmlEditor @bind-Value="@Divesite.Description" ShowToolbar="false" Style="height:300px" >

                                            </RadzenHtmlEditor> *@
                                            <RadzenTextArea @bind-Value="@Divesite.Description" Rows="12" Style="width:100%;">

                                            </RadzenTextArea>
                                           
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                            </RadzenColumn>

                            <RadzenColumn Size="5">

                                <img src="@ImageUtils.GetImageSrc(Divesite.Image?.ImageData)" alt="@Divesite.Name" class="img rounded w-100 rz-mb-2" @onclick="@onImageClick" />
                                <RadzenUpload MaxFileCount="1" ChooseText="Select new image" />

                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Details">
                        <RadzenRow Gap="5">

                            <RadzenFormField Text="Event type" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenDropDown Data="@(Enum.GetValues(typeof(EventTypeEnum)).Cast<Enum>())" @bind-Value=@Divesite.DefaultEventType Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="Dive Type" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenDropDown Data="@(Enum.GetValues(typeof(DiveTypeEnum)).Cast<Enum>())" @bind-Value=@Divesite.DiveType Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenRow>

                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Min. Depth" Variant="Variant.Outlined" Style="width:100%">
                                        <End>
                                            <RadzenIcon Icon="@IconsTextsAndColors.Icons.MIN_DEPTH"></RadzenIcon>
                                        </End>
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="@Divesite.MinDepth" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Max. Depth" Variant="Variant.Outlined" Style="width:100%">
                                        <End>
                                            <RadzenIcon Icon="@IconsTextsAndColors.Icons.MAX_DEPTH"></RadzenIcon>
                                        </End>
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="@Divesite.MaxDepth" />
                                        </ChildContent>
                                    </RadzenFormField>

                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Min. certificate requirement" Variant="Variant.Outlined" Style="width:100%">
                                        <RadzenDropDown Data="@certificates" TextProperty="Name" Value="Divesite.Certificate" TValue="Certificate" ValueChanged="@onRequiredCertificateChanged" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Min. participants" Variant="Variant.Outlined" Style="width:100%">
                                        <End>
                                            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_MIN"></RadzenIcon>
                                        </End>
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="Divesite.MinParticipants" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Max. participants" Variant="Variant.Outlined" Style="width:100%">
                                        <End>
                                            <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_MAX"></RadzenIcon>
                                        </End>
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="Divesite.MaxParticipants" />'
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>


                            </RadzenRow>



                            <RadzenRow>

                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Default Start time" Variant="Variant.Outlined" Style="width:100%">
                                        <RadzenDatePicker ShowTime="true" TimeOnly="true" DateFormat="HH:mm" @bind-Value="@startTime" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Default End time" Variant="Variant.Outlined" Style="width:100%">
                                        <RadzenDatePicker ShowTime="true" TimeOnly="true" DateFormat="HH:mm" @bind-Value="@endTime" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Price" Variant="Variant.Outlined" Style="width:100%">
                                        <End><RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT" /></End>
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="Divesite.Price"></RadzenNumeric>
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenColumn>

                            </RadzenRow>

                        </RadzenRow>

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Locations">
                        <RadzenRow>
                            <RadzenColumn Size="7">
                                <RadzenGoogleMap ApiKey="@googleMapsAPIKey" MapId="@googleMapsMapId" @ref=@map
                                                 Style="height:320px;width:360px;"
                                                 Options=@googleMapOptions
                                                 Zoom=11
                                                 MapClick="@onMapClick"
                                                 MarkerClick="@onMarkerClick"
                                                 FitBoundsToMarkersOnUpdate="@fitBoundsToMarkers"
                                                 Center=@(meetinLocationPosition ?? divesitePosition)>
                                    <Markers>
                                        @foreach (var item in markers)
                                        {
                                            <RadzenGoogleMapMarker Position="@item.Position" Title="@item.Title" />
                                        }
                                    </Markers>
                                </RadzenGoogleMap>
                            </RadzenColumn>
                            <RadzenColumn Size="5">
                                <RadzenFormField Style="width:100%" Variant="Variant.Outlined" Text="Select existing meeting spots">
                                    <RadzenDropDown Data="@meetingLocations" TValue="Address" Value="@Divesite.MeetingLocation" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                                </RadzenFormField>

                                <RadzenRow class="rz-mt-5">
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Variant="Variant.Outlined" Text="Short name" Style="width:100%">
                                            <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Name" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Variant="Variant.Outlined" Text="Streetname" Style="width:100%">
                                            <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Streetname" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow Gap="4">
                                    <RadzenColumn>
                                        <RadzenFormField Variant="Variant.Outlined" Text="Postcode" Style="width:100%">
                                            <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Zipcode" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="8">
                                        <RadzenFormField Variant="Variant.Outlined" Text="City" Style="width:100%">
                                            <RadzenTextBox @bind-Value="@divesiteMeetingLocation.City" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow>
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Variant="Variant.Outlined" Text="Streetname" Style="width:100%">
                                            <RadzenTextBox @bind-Value="@divesiteMeetingLocation.Country" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Upcoming trips">
                        <DivesiteEventsComponent DivesiteId="@Divesite.Id" ActiveEventsOnly=true  />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Completed trips">
                        <DivesiteEventsComponent DivesiteId="@Divesite.Id" ActiveEventsOnly=false CompletedEventsOnly=true />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenColumn>
    </RadzenRow>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-8">
        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="@IconsTextsAndColors.Icons.SAVE" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
        <RadzenButton ButtonType="ButtonType.Button" Text="Delete" Icon="@IconsTextsAndColors.Icons.DELETE" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="deleteDivesiteClick" Size="ButtonSize.Small" />
    </RadzenStack>

</RadzenTemplateForm>
