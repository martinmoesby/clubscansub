

<RadzenStack Orientation="Orientation.Horizontal" class="rz-mb-5" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%">
    @if (!ActiveEventsOnly) 
    {
        <EventTypeToggleButtonsComponent OnFilter="setFilter" InitialFilters="InitialSingleFilters" SingleSelect="true" />
    } else
    {
        <EventTypeToggleButtonsComponent OnFilter="setFilter" InitialFilters="InitialFilters" SingleSelect="false"  />
    }
    <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Eventsplanner..." Icon="add_circle" Shade="Shade.Light" Variant="Variant.Text" Visible="ActiveEventsOnly" Click="addNewEvents" />
</RadzenStack>

<RadzenDataGrid 
    TItem="Event" 
    Data="@filteredEvents" 
    AllowPaging PageSize="15" 
    AllowSorting 
    AllowAlternatingRows="true" 
    AllowRowSelectOnRowClick="true" 
    RowDoubleClick="editEvent">
    <EmptyTemplate>
        <BusyLoading isLoading="@isLoading" Message="Loading events..." NoDataMessage="No events with the current filter" />
    </EmptyTemplate>
    <Template Context="e">
        <EventUserActionsComponent ShowAddNewUser="false" Visible="@(e.EndDateAndTime > DateTime.Now && e.FreeSpots > 0 && !e.IsCancelled)" AddExistingUser="@((args) => enrollUser(e, args))" />
        <EventUserListComponent Event="e" EventUsers="@e.Participants.ToList()" OnRemoveUser="@((args) => removeUser(e, args))" OnReleaseSpot="@(() => releaseSpot(e))" />
    </Template>
    <Columns>
        <RadzenDataGridColumn Title="Date and Time" Width="200px">
            <Template>
                <RadzenStack Orientation="Orientation.Vertical" Gap="3">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                        <RadzenIcon Icon="@IconsTextsAndColors.Icons.START_TIME" IconColor="@Colors.Success"></RadzenIcon>
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="@context.StartDateAndTime.ToString("dd. MMMM yyyy kl. HH:mm")" />
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal">
                        <RadzenIcon Icon="@IconsTextsAndColors.Icons.END_TIME" IconColor="@Colors.Danger"></RadzenIcon>
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="@context.EndDateAndTime.ToString("dd. MMMM yyyy kl. HH:mm")" />
                    </RadzenStack>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Title" Title="Event name" Sortable MinWidth="180px">
            <Template>
                <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" Gap="3">

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start" Gap="10">
                    <RadzenIcon Icon="@IconsTextsAndColors.GetEventIcon(context.EventType)" />
                    <RadzenText Text="@context.Title" TextStyle="TextStyle.Body1" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">
                    <SeatComponent Event="context" ShowText="false" Text="Occupancy" Size="Utility.Enums.IconSizeEnum.Small" />
                        <CopyToClipboardComponent Text="@($"{linkString}{context.DeeplinkId.ToString()}")" IsTextVisible="false" IsTextReadOnly="true" ButtonText="Copy deeplink" />
                </RadzenStack>
                </RadzenStack>
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Pricing" Width="120px">
            <Template>

                <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal" Gap="3">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT" IconColor="@Colors.SuccessDarker" title="Premium membership price"></RadzenIcon>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@context.PremiumPrice?.ToString("C2")</RadzenText>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenIcon Icon="@IconsTextsAndColors.Icons.AMOUNT" IconColor="@Colors.SuccessLighter" title="Basic membership price"></RadzenIcon>
                        <RadzenText TextStyle="TextStyle.Subtitle2" >@context.Price?.ToString("C2")</RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </Template>

        </RadzenDataGridColumn>

        <RadzenDataGridColumn MinWidth="40px" Width="60px" TextAlign="TextAlign.Center" Visible="@ActiveEventsOnly">
            <Template>
                @if (context.IsCancelled)
                {
                    <RadzenButton Click="@(() => reactivateEvent(context))" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall" Icon="refresh" Variant="Variant.Text" />

                }
                else
                {
                    <RadzenButton Click="@(() => cancelEvent(context))" ButtonStyle="ButtonStyle.Warning" Shade="Shade.Light" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Icon="cancel" title="Cancel/Deactivate event" />
                }
                <RadzenButton Click="@(() => removeEvent(context))" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Icon="delete" title="Delete event completely - only if no divers are signed up for the event" Disabled="@(context.Participants.Count != 0)" />
            </Template>
        </RadzenDataGridColumn>

    </Columns>

</RadzenDataGrid>
<style>
    .fullHeight {
        height: 100%
    }
</style>

@code {
    [Inject]
    DialogService dialogService { get; set; }

    [Inject]
    EventService eventService { get; set; }

    [Inject]
    EventUserService eventUserService { get; set; }

    [Inject]
    UserService userService { get; set; }

    [Inject]
    NavigationManager navigationManager { get; set; }

    [Parameter]
    public bool ActiveEventsOnly { get; set; } = true;

    [Parameter]
    public bool CompletedEventsOnly { get; set; } = false;


    private string linkString = string.Empty;
    private bool isLoading = true;
    private IList<Event> allEvents = new List<Event>();
    private IList<Event> filteredEvents = new List<Event>();

    private Dictionary<EventTypeEnum, bool> InitialSingleFilters { get; set; } = new Dictionary<EventTypeEnum, bool>() {
            {    EventTypeEnum.Klubture, false },
            {    EventTypeEnum.Stranddyk, false },
            {    EventTypeEnum.Bådtur, true },
            {    EventTypeEnum.Liveaboard, false },
            {    EventTypeEnum.Rejse, false },
            {    EventTypeEnum.Other, false },
        };

    private Dictionary<EventTypeEnum, bool> InitialFilters { get; set; } = new Dictionary<EventTypeEnum, bool>() {
            {    EventTypeEnum.Klubture, true },
            {    EventTypeEnum.Stranddyk, true },
            {    EventTypeEnum.Bådtur, true },
            {    EventTypeEnum.Liveaboard, false },
            {    EventTypeEnum.Rejse, false },
            {    EventTypeEnum.Other, false },
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            var rootUri = navigationManager.BaseUri;
            var rootLink = rootUri.EndsWith("/") ? rootUri : rootUri + "/";
            linkString = $"{rootLink}?eventId=";
            allEvents = await eventService.GetAllAsync();
            setFilter(InitialFilters);
            StateHasChanged();
            isLoading = false;
        }
    }

    private void setFilter(Dictionary<EventTypeEnum, bool> filter)
    {
        InitialFilters = filter;

        var selectedEventTypes = filter.Where(x => x.Value == true).Select(x => x.Key);

        if (ActiveEventsOnly)
            filteredEvents = allEvents.Where(x => x.StartDateAndTime > DateTime.Now).ToList();
        else if (CompletedEventsOnly)
            filteredEvents = allEvents.Where(x => x.EndDateAndTime < DateTime.Now).ToList();

        filteredEvents = filteredEvents.Where(x => selectedEventTypes.Contains(x.EventType)).ToList();

    }

    private async void enrollUser(Event e, string userId)
    {

        var evnt = allEvents.Where(x => x.Id == e.Id).FirstOrDefault();

        if (evnt == null )
            return;

        if (userId == "scansub")
        {
            if (evnt.FreeSpots > 0)
            {
                evnt.FixedParticipants++;
                await eventService.UpdateAsync(e);
            }
        }
        else
        {

            var user = await userService.GetUserAsync(Guid.Parse(userId));
            if (user == null)
                return;

            var eu = new EventUser()
            {
                Event = evnt,
                ApplicationUser = user
            };
            evnt.Participants.Add(eu);
            await eventService.AddedUserToEvent(userId, evnt);
            reloadEvents();
            StateHasChanged();
        }
    }

    private async void releaseSpot(Event e)
    {
        e.FixedParticipants--;
        if (e.FixedParticipants < 0)
            e.FixedParticipants = 0;
        await eventService.UpdateAsync(e);
    }

    private async void addNewEvents()
    {
        await dialogService.OpenAsync<EventsPlannerComponent>("Events planner", null, new DialogOptions()
        {
            Width = "95%",
            Height = "95%",
            ContentCssClass = "fullHeight"
        });
        allEvents = await eventService.GetAllAsync();
        setFilter(InitialFilters);
        StateHasChanged();
    }

    private async void cancelEvent(Event item)
    {
        var questionText = $"Do you want to cancel '{item.Title}'?";

        if ((item.Price > 0 || item.PremiumPrice > 0) && item.FreeSpots != item.MaxParticipants)
        {
            questionText += "<br/>Payment will be refunded 100% to the participants";
        }

        var doCancel = await dialogService.Confirm(questionText, "Cancel event", new ConfirmOptions()
        {
            OkButtonText = "Yes",
            CancelButtonText = "No"
        });
        if (doCancel.GetValueOrDefault())
        {

            await eventService.CancelEventAsync(item);
            // allEvents = await eventService.GetAllAsync();
            // setFilter(InitialFilters);
            item.IsCancelled = true;
            StateHasChanged();
        }
    }

    private async void removeEvent(Event item)
    {
        var questionText = $"Do you want to remove '{item.Title}' from the calendar?";

        var doCancel = await dialogService.Confirm(questionText, "Delete event", new ConfirmOptions()
        {
            OkButtonText = "Yes",
            CancelButtonText = "No"
        });
        if (doCancel.GetValueOrDefault())
        {

            await eventService.DeleteAsync(item);
            allEvents = await eventService.GetAllAsync();
            setFilter(InitialFilters);
            StateHasChanged();
        }

    }

    private async void reactivateEvent(Event item)
    {
        var questionText = $"Do you want to reactivate '{item.Title}'?";

        var doCancel = await dialogService.Confirm(questionText, "Activate event", new ConfirmOptions()
        {
            OkButtonText = "Yes",
            CancelButtonText = "No"
        });
        if (doCancel.GetValueOrDefault())
        {

            await eventService.ActivateEventAsync(item);
            // allEvents = await eventService.GetAllAsync();
            // setFilter(InitialFilters);
            item.IsCancelled = false;
            StateHasChanged();
        }
    }

    private async void editEvent(DataGridRowMouseEventArgs<Event> item)
    {
        var dialogOptions = new DialogOptions()
        {
            Width = "800px",
            Height = "600px",
            ShowClose = true
        };
        var dialogParameters = new Dictionary<string, object>()
        {
            {"Event",item.Data },
            { "EventChanged", EventCallback.Factory.Create<Event>(this, updateEvent) }
        };
        if (ActiveEventsOnly) {

            await dialogService.OpenAsync<EditEventComponent>("Edit Event", dialogParameters, dialogOptions );
            allEvents = await eventService.GetAllAsync();
            setFilter(InitialFilters);
            StateHasChanged();
        } 
    }

    private async Task updateEvent(Event item)
    {
        await eventService.UpdateAsync(item);
        reloadEvents();
        StateHasChanged();

    }

    private async void removeUser(Event e, ApplicationUser user)
    {

        var confirmAnswer = await dialogService.Confirm($"Do you want to remove '{user.Name}' from '{e.Title}'?`", "Remove User?", new YesNoConfirmOptions());
        if (confirmAnswer == null || !confirmAnswer.Value)
            return;

        var ev = allEvents.Where(x => x.Id == e.Id).FirstOrDefault();
        if (ev == null)
            return;

        var eu = ev.Participants.Where(x => x.ApplicationUserId == user.Id).FirstOrDefault();
        if (eu != null)
        {
            ev.Participants.Remove(eu);
            await eventUserService.RemoveUserFromEvent(user.Id, e.Id);
            reloadEvents();
            StateHasChanged();

        }
    }

    private async void reloadEvents()
    {
        allEvents = await eventService.GetAllAsync();
        setFilter(InitialFilters);
    }
}