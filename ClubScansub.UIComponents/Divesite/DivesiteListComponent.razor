@using ClubScansub.Models.DTO
@using ClubScansub.Service
<RadzenStack Gap="5">

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%;" Gap="5" AlignItems="AlignItems.Center">
        <RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Style="flex:1" AlignItems="AlignItems.Center" Gap="5">
                <RadzenToggleButton Size="ButtonSize.Small" title="Show pool/confined water locations" Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.PoolDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.PoolDive)" />
                <RadzenToggleButton Size="ButtonSize.Small" title="Show nature/muck dive locations " Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.NatureDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.NatureDive)" />
                <RadzenToggleButton Size="ButtonSize.Small" title="Show wreck dive locations" Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.WreckDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.WreckDive)" />
                <RadzenToggleButton Size="ButtonSize.Small" title="Show Technical dive locations" Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.TechDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.TechDive)" />
            </RadzenStack>
        </RadzenStack>
        <SearchComponent Reset="@resetFilter" Search="@applySearch" />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="10">
            <RadzenToggleButton Variant="Variant.Text" Icon="grid_view" ButtonStyle="ButtonStyle.Success" ToggleButtonStyle="ButtonStyle.Success" Disabled="showAsCards" @bind-Value="@showAsCards" Size="ButtonSize.Small" Click="toggleView" />
            <RadzenToggleButton Variant="Variant.Text" Icon="lists" ButtonStyle="ButtonStyle.Success" ToggleButtonStyle="ButtonStyle.Success" Disabled="showAsList" @bind-Value="@showAsList" Size="ButtonSize.Small" Click="toggleView" />
            <AuthorizeView Roles="Administrator">
                <RadzenButton Icon="add_location" Size="ButtonSize.ExtraSmall" Text="New..." Variant="Variant.Text" ButtonStyle="ButtonStyle.Success" />
            </AuthorizeView>
        </RadzenStack>

    </RadzenStack>
    @if (showAsCards)
    {

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal" Wrap="FlexWrap.Wrap" Gap="5">
            @if (isLoading)
            {
                <BusyLoading Message="Getting divesites" NoDataMessage="No divesites available" isLoading />
            }
            else
            {
                if (filteredSites.Count() == 0)
                {
                    <RadzenStack JustifyContent="JustifyContent.Center">
                        <RadzenText TextStyle="TextStyle.Body1" Text="No divesites found" Style="width:100%" class="rz-mt-4"/>
                    </RadzenStack>
                }
                else
                {

                    @foreach (var item in filteredSites)
                    {
                        <DivesiteDetailsCardComponent Divesite="item" OnEdit="showEditDialog" OnRequestEvent="requestEvent" />
                    }
                }
            }

        </RadzenStack>
    }

    @if (showAsList)
    {

        <RadzenDataGrid Data="@filteredSites"
                        @ref=@grid
                        TItem="Divelocation"
                        AllowVirtualization="true"
                        AllowAlternatingRows=true
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="false"
                        AllowColumnPicking="false"
                        ShowPagingSummary="true"
                        FilterMode="FilterMode.Simple"
                        LogicalFilterOperator="LogicalFilterOperator.Or"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        PageSize="15"
                        Style="flex:1;"
                        SelectionMode="DataGridSelectionMode.Single"
                        RowDoubleClick="@onRowDblCLick"
                        CellContextMenu="@onCellContextMenu">
            <LoadingTemplate>
                <BusyLoading isLoading="@isLoading" Message="Loading divesites..." NoDataMessage="No divesites with the current filter" />
            </LoadingTemplate>
            <EmptyTemplate>
                <BusyLoading isLoading="@isLoading" Message="Loading divesites..." NoDataMessage="No divesites with the current filter" />
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="Divelocation" Title="Image" Width="160px" TextAlign="TextAlign.Left" Sortable="false">
                    <Template Context="location">
                        <RadzenStack Style="width:160px;height:80px;overflow:hidden;position:relative">
                            <RadzenBadge Text="@($"Requests waiting {location.EventRequests?.Count.ToString()}")" IsPill Style="position:absolute; top:2px;cursor:pointer" Shade="Shade.Default" BadgeStyle="BadgeStyle.Danger" Variant="Variant.Filled" Visible="@(location.EventRequests?.Any(x=>x.RequestProcessed == false) ?? false)" @onclick="@(() => showRequests(location))" />
                            <img src="@ImageUtils.GetImageSrc(location.Image?.ImageData)" class="img rounded h-100" style="object-fit:cover" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Divelocation" Title="Info" Width="100px" TextAlign="TextAlign.Left" Sortable="false">
                    <Template Context="location">
                        
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenStack>
                                <RadzenIcon Icon="@IconsTextsAndColors.GetDiveTypeIcon(location.DiveType)"  />
                                <RadzenIcon Icon="@IconsTextsAndColors.GetEventIcon(location.DefaultEventType)"  />
                            </RadzenStack>
                            
                            <RadzenStack JustifyContent="JustifyContent.Start">

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
                                    <RadzenIcon Icon="vertical_align_top" />
                                    <RadzenText TextStyle="TextStyle.Caption">@($"{location.MinDepth} m.")</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
                                    <RadzenIcon Icon="vertical_align_bottom" />
                                    <RadzenText TextStyle="TextStyle.Caption">@($"{location.MaxDepth} m.")</RadzenText>
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenStack>

                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Divelocation" Title="Name" Width="200px" Property="@nameof(Divelocation.Name)" SortProperty="Name" TextAlign="TextAlign.Start">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Divelocation" Title="Description" Property="@nameof(Divelocation.Description)"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Divelocation" Width="80px" TextAlign="TextAlign.Center" >
                        <Template Context="editItem">
                            <AuthorizeView Roles="@Userroles.Administrator">
                                <RadzenButton Variant="Variant.Text" Click="@(() => showEditDialog(editItem))" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" />
                            </AuthorizeView>
                            <AuthorizeView Roles="@Userroles.Member">
                                <RadzenButton Variant="Variant.Text" Click="@(() => requestEvent(editItem))" Icon="person_raised_hand" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" />
                            </AuthorizeView>
                        </Template>
                    </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
    }

</RadzenStack>

@code {
    [Inject]
    ContextMenuService contextMenuService { get; set; }
    [Inject]
    NotificationService notificationService { get; set; }

    [Inject]
    DialogService dialogService { get; set; }

    [Inject]
    SiteService siteService { get; set; }

    private IList<Divelocation> sites = new List<Divelocation>();
    IList<Divelocation> filteredSites = new List<Divelocation>();
    private IEnumerable<DiveTypeEnum> selectedDiveTypes = [];
    private List<EventRequest> eventRequests = new List<EventRequest>();

    private bool isLoading = true;
    private Dictionary<DiveTypeEnum, bool> diveTypeFilter = new Dictionary<DiveTypeEnum, bool>
    {
        { DiveTypeEnum.PoolDive, true },
        { DiveTypeEnum.NatureDive, true },
        { DiveTypeEnum.WreckDive, true },
        { DiveTypeEnum.TechDive, false },
    };

    private string searchFilter = "";
    private RadzenDataGrid<Divelocation> grid { get; set; }

    private bool showAsList = false;
    private bool showAsCards = true;

    private DialogOptions editDialogOptions = new DialogOptions()
    {
        Width = "800px",
        Height = "600px",
        AutoFocusFirstElement = true,
        CloseDialogOnEsc = true,
    };


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            selectedDiveTypes = diveTypeFilter.Where(x => x.Value == true).Select(x => x.Key);
            sites = (await siteService.GetAllWithRequestsAsync()).ToList();
            filteredSites = sites.Where(x => selectedDiveTypes.Contains(x.DiveType) && x.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name).ToList();
            isLoading = false;
            StateHasChanged();
        }

    }

    private async Task getSitesByTypeFilter()
    {
        selectedDiveTypes = diveTypeFilter.Where(x => x.Value == true).Select(x => x.Key);
        filteredSites = sites.Where(x => selectedDiveTypes.Contains(x.DiveType) && x.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name).ToList();
        StateHasChanged();
    }

    private void toggleView()
    {
        showAsCards = !showAsCards;
        showAsList = !showAsCards;
    }

    private async void applySearch(string filter)
    {
        searchFilter = filter;
        await getSitesByTypeFilter();
    }

    private async void resetFilter()
    {
        searchFilter = "";
        await getSitesByTypeFilter();
    }

    private string getImageSrc(DivelocationImage image)
    {
        if (image != null)
        {
            return $"data:image;base64,{Convert.ToBase64String(image.ImageData)}";

        }
        return "/images/logo-login.png";
    }

    void onCellContextMenu(DataGridCellMouseEventArgs<Divelocation> args)
    {
        List<ContextMenuItem> contextMenuItems = [
            new ContextMenuItem() { Text = "Edit", Value = 1, Icon = "edit" }
        ];

        contextMenuService.Open(args,
            contextMenuItems,
            (e) => handleContexteMenuClick(e, args)
         );

    }

    private void handleContexteMenuClick(MenuItemEventArgs e, DataGridCellMouseEventArgs<Divelocation> args)
    {
        switch (e.Value)
        {
            case 1:
                showEditDialog(args.Data);
                break;
            default:
                break;
        }
    }

    void onRowDblCLick(DataGridRowMouseEventArgs<Divelocation> args)
    {
        var site = args.Data;
        showEditDialog(site);
    }

    private void showEditDialog(Divelocation site)
    {
        var dialogParameters = new Dictionary<string, object>
            {
                { "Divesite", site },
                { "UpdateDivesiteCallback", EventCallback.Factory.Create<Divelocation>(this, updateSite)},
                { "DeleteDivesiteCallback", EventCallback.Factory.Create<Divelocation>(this, deleteSite)}
            };

        dialogService.Open<DivesiteDetailsComponent>("Edit Divesite", dialogParameters, editDialogOptions);

    }

    private async void updateSite(Divelocation site)
    {
        try
        {
            await siteService.UpdateAsync(site);
            dialogService.Close();
            notificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"Site '{site.Name}' has been updated"
            }
            );
            await getSitesByTypeFilter();

        }
        catch (Exception ex)
        {

            await dialogService.Alert($"An error occurred: {ex.Message}", "Update error!", new AlertOptions() { OkButtonText = "OK" });
        }

    }

    private async void deleteSite(Divelocation site)
    {
        var siteName = site.Name;
        var deleteSite = await dialogService.Confirm($"Are you sure you want to delete '{siteName}'?", "Delete Site", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (deleteSite.GetValueOrDefault())
        {
            await siteService.DeleteAsync(site);

            notificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"Site '{siteName}' has been deleted"
            }
            );

            await getSitesByTypeFilter();
        }

    }

    private async void requestEvent(Divelocation fordivesite)
    {
        await dialogService.OpenAsync<RequestEventComponent>($"Suggest trip to {fordivesite.Name}", new Dictionary<string, object>
        {
            { "Divesite", fordivesite },
            {  "OnRequestSubmitted", EventCallback.Factory.Create<RequestEventDTO>(this, eventRequested)  }
        });

        //TODO: Create a dialog for entering specific information about the request: 
        // No of people wanting this trip
        // Names opf divers wanting this trip
        // Specific dates
    }

    private async void eventRequested(RequestEventDTO requestedEvent)
    {
        var requestedEventLocation = sites.FirstOrDefault(x => x.Id == requestedEvent.DivelocationId);

        await siteService.RequestEventForDivesite(requestedEvent);
        await dialogService.Alert($"Request for a divetrip to divelocation '{requestedEventLocation.Name.ToString()}' has been submitted", "Event request");
        dialogService.Close();
    }
    private async void showRequests(Divelocation Divesite)
    {
        await dialogService.OpenAsync<RequestEventListComponent>($"Requests for '{Divesite.Name}'", new Dictionary<string, object>() {
            { "DivesiteId", Divesite.Id },
            { "OnProcessedComplete", EventCallback.Factory.Create<List<EventRequest>>(this, reload)}
        },
        new DialogOptions() { Width = "800px" });


    }

    private async void reload()
    {
        sites = (await siteService.GetAllWithRequestsAsync()).ToList();
        filteredSites = sites.Where(x => selectedDiveTypes.Contains(x.DiveType) && x.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name).ToList();
        isLoading = false;
        StateHasChanged();
        dialogService.Close();
    }

}
