@using ClubScansub.Service
<RadzenStack Gap="5">

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%;" Gap="5" AlignItems="AlignItems.Center">
        <RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Style="flex:1" AlignItems="AlignItems.Center" Gap="5">
                <RadzenToggleButton Size="ButtonSize.Small" title="Show pool/confined water locations" Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.PoolDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.PoolDive)" />
                <RadzenToggleButton Size="ButtonSize.Small" title="Show nature/muck dive locations " Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.NatureDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.NatureDive)" />
                <RadzenToggleButton Size="ButtonSize.Small" title="Show wreck dive locations" Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.WreckDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.WreckDive)" />
                <RadzenToggleButton Size="ButtonSize.Small" title="Show Technical dive locations" Change="getSitesByTypeFilter" ButtonStyle="ButtonStyle.Dark" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" @bind-Value="diveTypeFilter[DiveTypeEnum.TechDive]" Icon="@IconsTextsAndColors.GetDiveTypeIcon(DiveTypeEnum.TechDive)" />
            </RadzenStack>
        </RadzenStack>
        <SearchComponent Reset="@resetFilter" Search="@applySearch" />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="10">
            <RadzenToggleButton Variant="Variant.Text" Icon="lists" ButtonStyle="ButtonStyle.Success" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@showAsList" Size="ButtonSize.Small" Shade="Shade.Lighter" ToggleShade="Shade.Darker" Click="toggleView" />
            <RadzenToggleButton Variant="Variant.Text" Icon="grid_view" ButtonStyle="ButtonStyle.Success" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@showAsCards" Size="ButtonSize.Small" ToggleShade="Shade.Darker" Shade="Shade.Lighter" Click="toggleView" />

@*             <RadzenIcon Icon="lists" @onclick="toggleView" Visible="!showAsList" Style="cursor:pointer" />
            <RadzenIcon Icon="grid_view" @onclick="toggleView" Visible="showAsList" Style="cursor:pointer" /> *@
            <RadzenButton Icon="add_location" Size="ButtonSize.ExtraSmall" Text="New..." Variant="Variant.Text" ButtonStyle="ButtonStyle.Success" />
        </RadzenStack>

    </RadzenStack>
    @if (showAsCards)
    {

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Normal" Wrap="FlexWrap.Wrap" Gap="5">
            @if (isLoading)
            {
                <BusyLoading Message="Getting divesites" NoDataMessage="No divesites available" isLoading />
            }
            else
            {
                if (sites.Count() == 0)
                {
                    <RadzenStack JustifyContent="JustifyContent.Center">
                        <RadzenText TextStyle="TextStyle.Body1" Text="No divesites found" />
                    </RadzenStack>
                }
                else
                {

                    @foreach (var item in sites)
                    {
                        <RadzenCard Variant="Variant.Filled" Style="max-width:360px;" class="p-0 m-0" @ondblclick="() => showEditDialog(item)">
                            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" Gap="1rem" class="rz-p-4">
                                <RadzenStack Style="width:335px;height:180px;overflow:hidden">
                                    <img src="@ImageUtils.GetImageSrc(item.Image?.ImageData)" class="img rounded h-100" style="object-fit:cover" />
                                </RadzenStack>
                                <RadzenStack Gap="5">

                                    <RadzenText TextStyle="TextStyle.Body2"><b>@(item.Name)</b></RadzenText>

                                    <RadzenStack class="w-100" Style="height:100px;">
                                        <RadzenText TextStyle="TextStyle.Caption" Style="text-overflow:ellipsis;overflow:scroll;"><b>@item.Description</b></RadzenText>
                                    </RadzenStack>

                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    }
                }
            }

        </RadzenStack>
    }

    @if (showAsList)
    {

        <RadzenDataGrid Data="@sites"
                        @ref=@grid
                        @bind-Value=@selectedSites
                        TItem="Divelocation"
                        AllowVirtualization="true"
                        AllowAlternatingRows=false
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="false"
                        AllowColumnPicking="false"
                        ShowPagingSummary="true"
                        FilterMode="FilterMode.Simple"
                        LogicalFilterOperator="LogicalFilterOperator.Or"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        PageSize="8"
                        Style="flex:1;"
                        SelectionMode="DataGridSelectionMode.Single"
                        RowDoubleClick="@onRowDblCLick"
                        CellContextMenu="@onCellContextMenu">
            <LoadingTemplate>
                <BusyLoading isLoading="@isLoading" Message="Loading divesites..." NoDataMessage="No divesites with the current filter" />
            </LoadingTemplate>
            <EmptyTemplate>
                <BusyLoading isLoading="@isLoading" Message="Loading divesites..." NoDataMessage="No divesites with the current filter" />
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="Divelocation" Title="Image" Width="120px" TextAlign="TextAlign.Left" Sortable="false">
                    <Template Context="location">
                        <RadzenStack Style="width:120px;height:60px;overflow:hidden">
                            <img src="@ImageUtils.GetImageSrc(location.Image?.ImageData)" class="img rounded h-100" style="object-fit:cover" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Divelocation" Title="Name" MinWidth="100px" SortProperty="Name">
                    <Template>
                        <RadzenStack AlignItems="AlignItems.Start" Orientation="Orientation.Horizontal">
                            <RadzenStack>
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenText TextStyle="TextStyle.Subtitle1">@context.Name</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="text-overflow:ellipsis;overflow:hidden;">
                                    @context.Description
                                </RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Divelocation" Title="Dive Type" Property="DiveType" Sortable SortProperty="@nameof(Divelocation.DiveType)" Width="80px">
                    <Template>
                        <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                            <RadzenIcon Icon="@IconsTextsAndColors.GetDiveTypeIcon(context.DiveType)" Style="font-size:1.5rem;" IconColor="@Colors.SecondaryLight" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Divelocation" Title="Event type" Property="DefaultEventType" Width="80px">
                    <Template>
                        <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                            <RadzenIcon Icon="@IconsTextsAndColors.GetEventIcon(context.DefaultEventType)" Style="font-size:1.5rem;" IconColor="@Colors.SecondaryLight" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Divelocation" Title="Meeting location" Property="MeetingLocation.Name" Width="140px"></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Divelocation" Title="Depth" Width="120px" SortProperty="MinDepth">
                    <Template Context="Location">
                        <RadzenRow AlignItems="AlignItems.Start">
                            <RadzenIcon Icon="vertical_align_top" IconStyle="IconStyle.Primary" />
                            <RadzenText TextStyle="TextStyle.Body2">@($"{Location.MinDepth} m.")</RadzenText>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Start">
                            <RadzenIcon Icon="vertical_align_bottom" IconStyle="IconStyle.Primary" />
                            <RadzenText TextStyle="TextStyle.Body2">@($"{Location.MaxDepth} m.")</RadzenText>
                        </RadzenRow>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible="false" Pickable="true" TItem="Divelocation" Title="Economics" Width="160px">
                    <Template Context="location">
                        <RadzenRow>
                            <RadzenIcon Icon="payments" IconStyle="IconStyle.Primary" />
                            <RadzenText Text="@location.Price.ToString("C2")" />
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Start">
                            <RadzenIcon Icon="groups" IconStyle="IconStyle.Primary" />
                            <RadzenText Text="@($"{location.MinParticipants.ToString()} - {location.MaxParticipants.ToString()}")" />
                        </RadzenRow>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>
    }

</RadzenStack>

@code {
    [Inject]
    ContextMenuService contextMenuService { get; set; }
    [Inject]
    NotificationService notificationService { get; set; }

    [Inject]
    DialogService dialogService { get; set; }

    [Inject]
    SiteService siteService { get; set; }

    private IList<Divelocation> sites = new List<Divelocation>();
    IList<Divelocation> selectedSites = new List<Divelocation>();
    private bool isLoading = true;
    private Dictionary<DiveTypeEnum, bool> diveTypeFilter = new Dictionary<DiveTypeEnum, bool>
    {
        { DiveTypeEnum.PoolDive, true },
        { DiveTypeEnum.NatureDive, true },
        { DiveTypeEnum.WreckDive, true },
        { DiveTypeEnum.TechDive, false },
    };

    private string searchFilter = "";
    private RadzenDataGrid<Divelocation> grid { get; set; }

    private bool showAsList = true;
    private bool showAsCards = false;

    private DialogOptions editDialogOptions = new DialogOptions()
    {
        Width = "800px",
        Height = "600px",
        AutoFocusFirstElement = true,
        CloseDialogOnEsc = true,
    };


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            await getSitesByTypeFilter();
            isLoading = false;
            StateHasChanged();
        }

    }

    private async Task getSitesByTypeFilter()
    {
        isLoading = true;
        var selectedDiveTYpes = diveTypeFilter.Where(x => x.Value == true).Select(x => x.Key);

        sites = (await siteService.GetAllAsync()).Where(x => selectedDiveTYpes.Contains(x.DiveType) && x.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name).ToList();

        isLoading = false;
        StateHasChanged();
    }

    private void toggleView()
    {
        showAsCards = !showAsCards;
        showAsList = !showAsCards;
    }

    private async void applySearch(string filter)
    {
        searchFilter = filter;
        await getSitesByTypeFilter();
    }

    private async void resetFilter()
    {
        searchFilter = "";
        await getSitesByTypeFilter();
    }

    private string getImageSrc(DivelocationImage image)
    {
        if (image != null)
        {
            return $"data:image;base64,{Convert.ToBase64String(image.ImageData)}";

        }
        return "/images/logo-login.png";
    }

    void onCellContextMenu(DataGridCellMouseEventArgs<Divelocation> args)
    {
        List<ContextMenuItem> contextMenuItems = [
            new ContextMenuItem() { Text = "Edit", Value = 1, Icon = "edit" }
        ];

        selectedSites = new List<Divelocation> { args.Data };
        contextMenuService.Open(args,
            contextMenuItems,
            (e) => handleContexteMenuClick(e, args)
            //{
            //    switch (e.Value)
            //    {
            //        case 1:
            //            showEditDialog(selectedSites.FirstOrDefault());
            //            break;
            //        default:

            //            Console.WriteLine($"Menu item with Value={e.Value} clicked. Column: {args.Column.Property}, SiteName: {args.Data.Name}");
            //            break;
            //    }
            //}
         );

    }

    private void handleContexteMenuClick(MenuItemEventArgs e, DataGridCellMouseEventArgs<Divelocation> args)
    {
        switch (e.Value)
        {
            case 1:
                showEditDialog(selectedSites.FirstOrDefault());
                break;
            default:
                break;
        }
    }

    void onRowDblCLick(DataGridRowMouseEventArgs<Divelocation> args)
    {
        var site = args.Data;
        showEditDialog(site);
    }

    private void showEditDialog(Divelocation site)
    {
        var dialogParameters = new Dictionary<string, object>
            {
                { "Divesite", site },
                { "UpdateDivesiteCallback", EventCallback.Factory.Create<Divelocation>(this, updateSite)},
                { "DeleteDivesiteCallback", EventCallback.Factory.Create<Divelocation>(this, deleteSite)}
            };

        dialogService.Open<DivesiteDetailsComponent>("Edit Divesite", dialogParameters, editDialogOptions);

    }

    private async void updateSite(Divelocation site)
    {
        try
        {
            await siteService.UpdateAsync(site);
            dialogService.Close();
            notificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"Site '{site.Name}' has been updated"
            }
            );
            await getSitesByTypeFilter();

        }
        catch (Exception ex)
        {

            await dialogService.Alert($"An error occurred: {ex.Message}", "Update error!", new AlertOptions() { OkButtonText = "OK" });
        }

    }

    private async void deleteSite(Divelocation site)
    {
        var siteName = site.Name;
        var deleteSite = await dialogService.Confirm($"Are you sure you want to delete '{siteName}'?", "Delete Site", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (deleteSite.GetValueOrDefault())
        {
            await siteService.DeleteAsync(site);

            notificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"Site '{siteName}' has been deleted"
            }
            );

            await getSitesByTypeFilter();
        }

    }
    private void closeDialog()
    {
        dialogService.Close();
    }
}
