@using ClubScansub.Utility
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="@Alignment" AlignItems="AlignItems.Center" Style="width:100%" Gap="5">
    @Start
    <RadzenToggleButton MouseEnter="@(args => showTooltip(args,"Grundkurser"))" MouseLeave="hideTooltip" Size="ButtonSize.Small" Visible="@(isActive(CourseTypeEnum.BaseCourse))" ToggleShade="Shade.Light" ToggleButtonStyle="ButtonStyle.Warning" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_BASE_COURSE" Value="getCourseFilter(CourseTypeEnum.BaseCourse)" Change="@((args) => setCourseFilter(CourseTypeEnum.BaseCourse))" />
    <RadzenToggleButton MouseEnter="@(args => showTooltip(args,"Specialer"))" MouseLeave="hideTooltip" Size="ButtonSize.Small" Visible="@(isActive(CourseTypeEnum.SpecialtyCourse))" ToggleShade="Shade.Default" ToggleButtonStyle="ButtonStyle.Warning" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_SPEC_COURSE" Value="getCourseFilter(CourseTypeEnum.SpecialtyCourse)" Change="@((args) => setCourseFilter(CourseTypeEnum.SpecialtyCourse))" />
    <RadzenToggleButton MouseEnter="@(args => showTooltip(args,"Tekniske dykkerkurser"))" MouseLeave="hideTooltip" Size="ButtonSize.Small" Visible="@(isActive(CourseTypeEnum.TechCourse))" ToggleShade="Shade.Dark" ToggleButtonStyle="ButtonStyle.Warning" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_TECH_COURSE" Value="getCourseFilter(CourseTypeEnum.TechCourse)" Change="@((args) => setCourseFilter(CourseTypeEnum.TechCourse))" />
    <RadzenToggleButton MouseEnter="@(args => showTooltip(args,"Divepro kurser"))" MouseLeave="hideTooltip" Size="ButtonSize.Small" Visible="@(isActive(CourseTypeEnum.ProCourse))" ToggleShade="Shade.Darker" ToggleButtonStyle="ButtonStyle.Warning" ButtonStyle="ButtonStyle.Light" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_PRO_COURSE" Value="getCourseFilter(CourseTypeEnum.ProCourse)" Change="@((args) => setCourseFilter(CourseTypeEnum.ProCourse))" />

    @*  
    <RadzenToggleButton ToggleShade="Shade.Light" ToggleButtonStyle="ButtonStyle.Danger" ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_BASE_COURSE" Value="getCourseFilter(CourseTypeEnum.BaseCourse)" Change="@(() => setCourseFilter(CourseTypeEnum.BaseCourse))" />
    <RadzenToggleButton ToggleShade="Shade.Default" ToggleButtonStyle="ButtonStyle.Danger" ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_SPEC_COURSE" Value="getCourseFilter(CourseTypeEnum.SpecialtyCourse)" Change="@(() => setCourseFilter(CourseTypeEnum.SpecialtyCourse))" />
    <RadzenToggleButton ToggleShade="Shade.Dark" ToggleButtonStyle="ButtonStyle.Danger" ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_TECH_COURSE" Value="getCourseFilter(CourseTypeEnum.TechCourse)" Change="@(() => setCourseFilter(CourseTypeEnum.TechCourse))" />
    <RadzenToggleButton ToggleShade="Shade.Darker" ToggleButtonStyle="ButtonStyle.Danger" ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Icon="@IconsTextsAndColors.Icons.EVENTTYPE_PRO_COURSE" Value="getCourseFilter(CourseTypeEnum.ProCourse)" Change="@(() => setCourseFilter(CourseTypeEnum.ProCourse))" />
    *@    

 @End
</RadzenStack>

@code {
    [Inject]
    TooltipService tooltipService { get; set; }
    [Parameter]
    public bool SingleSelect { get; set; } = false;

    [Parameter]
    public RenderFragment Start { get; set; }

    [Parameter]
    public JustifyContent Alignment { get; set; } = JustifyContent.Normal;

    [Parameter]
    public Dictionary<CourseTypeEnum, bool> InitialFilters { get; set; } = new Dictionary<CourseTypeEnum, bool>() {
            {    CourseTypeEnum.BaseCourse, true },
            {    CourseTypeEnum.SpecialtyCourse, true },
            {    CourseTypeEnum.TechCourse, true },
            {    CourseTypeEnum.ProCourse, true }
        };

    [Parameter]
    public RenderFragment End { get; set; }

    [Parameter]
    public EventCallback<Dictionary<CourseTypeEnum, bool>> OnFilter { get; set; }

    private bool getCourseFilter(CourseTypeEnum type)
    {
        bool value = true;
        InitialFilters.TryGetValue(type, out value);
        return value;
    }

    private void setCourseFilter(CourseTypeEnum type)
    {
        if (SingleSelect)
        {
            foreach (var item in InitialFilters)
            {
                if (item.Key != type)
                    InitialFilters[item.Key] = false;
            }
            InitialFilters[type] = true;
        } else
        {
            InitialFilters[type] = !InitialFilters[type];
            
        }
        OnFilter.InvokeAsync(InitialFilters);
    }

    private bool isActive(CourseTypeEnum type)
    {
        return InitialFilters.Any(x => x.Key == type);
    }

    private void showTooltip(ElementReference elementReference, string message = "Hello")
    {
        TooltipOptions options = new TooltipOptions()
        {
            Delay = 200,
            Duration = 2000,
            CloseTooltipOnDocumentClick = true,
            CssClass = "rz-background-color-info-darker"
        };
        tooltipService.Open(elementReference, message, options);
    }

    private void hideTooltip()
    {
        tooltipService.Close();
    }

}
