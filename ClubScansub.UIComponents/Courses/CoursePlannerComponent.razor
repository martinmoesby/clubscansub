@using ClubScansub.Models.Interface
@using ClubScansub.Service
@using ClubScansub.Utility
@using System.Globalization
@using Nager.Date
@using Nager.Date.Model


<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="height:100%;">

    <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start" Style="flex:1;">
        <RadzenStack JustifyContent="JustifyContent.End" Style="flex:1">
            <CourseTypeToggleButtonsComponent SingleSelect="true" OnFilter="@((args) => filterCourseTemplates(args))" Alignment="JustifyContent.Start" InitialFilters="@initialCoursetypeFilter" />
            <RadzenRadioButtonList Data="@filteredTemplates" TValue="CourseTemplate" TextProperty="@nameof(CourseTemplate.TemplateName)" Orientation="Orientation.Vertical" Value="selectedTemplate" Change="@(args => setSelectedTemplate(args))" Style="flex:1" />

            <RadzenText Text="New courses to be created" TextStyle="TextStyle.Subtitle2" />

            <RadzenDataGrid Data="@newCourses" TItem="Course" @ref=newCoursesGrid AllowAlternatingRows="false">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(Course.CourseType)" Title="Type" Width="40px" SortProperty="@nameof(Course.CourseType)">
                        <Template Context="item">
                            <RadzenIcon Icon="@IconsTextsAndColors.GetCourseIcon(item.CourseType)" Style="font-size:1rem" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(Course.CourseName)" Title="Course Name">
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start">
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(() => removeCourse(context))"/>
                                <RadzenText Text="@context.Title" TextStyle="TextStyle.Body2"/>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Text="@context.StartDateAndTime.ToString("dd-MM-yy")" TextStyle="TextStyle.Caption" /> 
                                <RadzenText Text="@context.EndDateAndTime.ToString("dd-MM-yy")" TextStyle="TextStyle.Caption"  />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>

        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%" class="rz-mb-2">
            <RadzenButton ButtonStyle="ButtonStyle.Success" Shade="Shade.Light" Click="commitCourses" Text="Save courses" Icon="save" Size="ButtonSize.Small" Variant="Variant.Text" />
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Shade="Shade.Light" Click="resetCourses" Text="Reset" Icon="cancel" Size="ButtonSize.Small" Variant="Variant.Text" />
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Start" Style="flex:3;">
        <PlannerComponent NewItems="activeItems" OnSlotClicked="addNewCourse" DoReloadData="shouldDataReload" />
    </RadzenStack>
</RadzenStack>
<style>
    .scheduler-slot {
       
    }

        .scheduler-slot:hover {
            cursor:pointer;
            background-color: var(--rz-secondary-lighter) !important;
    }
</style>

@code {

    [Inject]
    CourseService courseService { get; set; }

    private RadzenDataGrid<Course> newCoursesGrid;

    private bool shouldDataReload = false;

    private IList<CourseTemplate> courseTemplates = new List<CourseTemplate>();
    private IList<CourseTemplate> filteredTemplates = new List<CourseTemplate>();
    private CourseTemplate? selectedTemplate;

    private IList<Course> newCourses = new List<Course>();

    private IList<CourseSession> activeCourseSessions = new List<CourseSession>();

    private IList<ICalendarEvent> activeItems = new List<ICalendarEvent>();

    private Dictionary<CourseTypeEnum, bool> initialCoursetypeFilter = new Dictionary<CourseTypeEnum, bool>()
    {
        { CourseTypeEnum.BaseCourse, true},
        { CourseTypeEnum.SpecialtyCourse, false},
        { CourseTypeEnum.TechCourse, false},
        { CourseTypeEnum.ProCourse, false}
    };

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            courseTemplates = await courseService.GetTemplatesAsync();
            filterCourseTemplates(initialCoursetypeFilter);
        }
    }
   
    private void setSelectedTemplate(CourseTemplate template) 
    {
        selectedTemplate = template;
    }

    private void filterCourseTemplates(Dictionary<CourseTypeEnum,bool> courseTypes)
    {
        selectedTemplate = null;
        var selectedTypes = courseTypes.Where(x => x.Value == true).Select(x => x.Key);
        filteredTemplates = courseTemplates.Where(x => selectedTypes.Contains(x.CourseType)).ToList();
        StateHasChanged();
    }

    private void addNewCourse(SchedulerSlotSelectEventArgs args)
    {
        args.PreventDefault();
        shouldDataReload = false;

        var course = courseService.CreateNewCourseFromTemplate(selectedTemplate, args.Start);
        if (course is null)
            return;

        newCourses.Add(course);

        InvokeAsync(newCoursesGrid.RefreshDataAsync);

        activeCourseSessions = newCourses.SelectMany(x => x.CourseSessions).ToList();
        activeItems = activeCourseSessions.ToList<ICalendarEvent>();

        StateHasChanged();
    }

    private async void commitCourses()
    {
        await courseService.AddAsync(newCourses);
        resetCourses();


    }
    
    private void resetCourses()
    {
        newCourses = new List<Course>();
        activeItems = [];
        shouldDataReload = true;
        // scheduler.Reload();
        StateHasChanged();
    }

    private void removeCourse(Course item)
    {
        newCourses.Remove(item);
        InvokeAsync(newCoursesGrid.RefreshDataAsync);
        activeCourseSessions = newCourses.SelectMany(x => x.CourseSessions).ToList();
        activeItems = activeCourseSessions.ToList<ICalendarEvent>();
    }
}
