@using Microsoft.JSInterop
@using ClubScansub.Service
<RadzenTemplateForm TItem="CourseTemplate">
        <RadzenRow>
            <RadzenColumn Size="3">
                <RadzenFormField Text="Type" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@Template.CourseType" Data="Enum.GetValues(typeof(CourseTypeEnum)).Cast<CourseTypeEnum>()" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Template.TemplateName" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenFormField Text="Price" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.DefaultPrice" Format="C2" ShowUpDown="false" />
                </RadzenFormField>
            </RadzenColumn>

        </RadzenRow>

        <RadzenRow>
            <RadzenColumn Size="2">
                <RadzenFormField Text="Duration in Weeks" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.TemplateDurationInWeeks" Format="N0" ShowUpDown="false" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Required Instructor level" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@Template.InstructorCertificate" Data="@instructorCertificates" TextProperty="@nameof(Certificate.Name)" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenFormField Text="Min." Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.MinStudents" Format="N0" ShowUpDown="false" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenFormField Text="Max." Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.MaxStudents" Format="N0" ShowUpDown="false" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Academig Sessions" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.AcademicSessions" Format="N0" ShowUpDown="false" />
                </RadzenFormField>

            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Pool sessions" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.PoolSessions" Format="N0" ShowUpDown="false" />
                </RadzenFormField>

            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenFormField Text="Open water Sessions" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@Template.OpenWaterSessions" Format="N0" ShowUpDown="false" />
                </RadzenFormField>

            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%" AlignItems="AlignItems.Center">
            <RadzenText Text="Course sessions:" TextStyle="TextStyle.Subtitle1" class="rz-my-4"/>
            <RadzenButton ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Text="Add" Icon="add" Size="ButtonSize.Small" Click="onAddSession"/>
        </RadzenStack>
        @foreach (var item in Template.Sessions.OrderBy(x=>x.SessionNumber))
    {
        <RadzenPanel Expand="@(() => onSessionCollapse(item))" Text="@($"Session# {item.SessionNumber.ToString()} - {item.Name}")" ExpandTitle="@($"Edit # {item.SessionNumber.ToString()}")" CollapseTitle="@($"Save # {item.SessionNumber.ToString()}")" Collapsed="@(selectedSessionNumber != item.SessionNumber)" AllowCollapse
        class="rz-border rz-border-radius-2 rz-border-color-base-400 rz-mb-4 rz-p-5" Style="width:100%">
            <RadzenRow>
                <RadzenColumn Size="11">
                    <RadzenRow>

                        <RadzenColumn SizeLG="1" SizeMD="2" SizeXS="2">
                            <RadzenFormField Text="#" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="item.SessionNumber" ReadOnly Disabled />
                            </RadzenFormField>
                        </RadzenColumn>
                        
                        <RadzenColumn SizeLG="2" SizeMD="3" SizeXS="4">
                            <RadzenFormField Text="Type" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="item.SessionType" Data="Enum.GetValues(typeof(CourseSessionTypeEnum)).Cast<CourseSessionTypeEnum>()" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn  SizeLG="3" SizeMD="3" SizeXS="6">
                            <RadzenFormField Text="Name" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="item.Name" id="@(item.SessionNumber)" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn SizeLG="6" SizeMD="4" SizeXS="12">
                            <RadzenFormField Text="Description" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="item.Description" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="3">
                            <RadzenFormField Text="Default WeekDay" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="item.DefaultWeekday" Data="Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>()" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="3">
                            <RadzenFormField Text="Default Start time" Variant="Variant.Outlined">
                                <RadzenTimePicker @bind-TimeValue="item.DefaultStartTime" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="3">
                            <RadzenFormField Text="Default duration" Variant="Variant.Outlined">
                                <RadzenTimePicker @bind-TimeValue="item.DefaultDuration" />
                            </RadzenFormField>
                        </RadzenColumn>

                        <RadzenColumn Size="3">
                            <RadzenFormField Text="Instructor Ratio 1:X" Variant="Variant.Outlined">
                                <RadzenNumeric @bind-Value="item.InstructorRatio" Format="N0" />
                            </RadzenFormField>
                        </RadzenColumn>

                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="1" >
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-pt-3">
                        <RadzenStack>
                            <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="keyboard_arrow_up" Click="@(() => moveSession(-1,item))" Disabled="@(item.SessionNumber == "1")" Variant="Variant.Text" />
                            <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="keyboard_arrow_down" Click="@(() => moveSession(1,item))" Disabled="@(item.SessionNumber == Template.Sessions.Max(x=>x.SessionNumber))" Variant="Variant.Text" />
                        </RadzenStack>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="@(() => removeSession(item))" Variant="Variant.Text" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenPanel>
    }
</RadzenTemplateForm>
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="10" class="rz-my-8">
    <RadzenButton Click="onSave" ButtonStyle="ButtonStyle.Success" Text="Save" Icon="save" />
    <RadzenButton Click="onCancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Text="Cancel" Icon="cancel" />
</RadzenStack>
<style>
    .rz-form-field {
    width: 100%
    }
</style>
@code {
    [Inject]
    IJSRuntime JSRuntime { get; set; }

    [Inject]
    DialogService dialogService { get; set; }

    [Inject]
    MemberService service { get; set; }

    [Parameter]
    public CourseTemplate Template { get; set; }

    [Parameter]
    public EventCallback<CourseTemplate> OnSave { get; set; }

    private RadzenDropDown<CourseTypeEnum> courseTypeDropdown;

    private IList<Certificate> instructorCertificates = new List<Certificate>();

    private string selectedSessionNumber = "1";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var certificates = await service.GetAvailableCertificatesAsync(true);
        instructorCertificates = certificates.Where(x => x.IsDiveproCertificate == true).ToList();
    }

    private void onSessionCollapse(CourseSessionTemplate item)
    {
        selectedSessionNumber = item.SessionNumber;
        setFocus(selectedSessionNumber);

        // StateHasChanged();
    }

    private void onSave()
    {
        OnSave.InvokeAsync(Template);

    }

    private void onCancel()
    {
        dialogService.Close();
    }

    private void onAddSession()
    {
        var newSession = new CourseSessionTemplate()
            {
                CourseTemplate = Template,
                SessionNumber = Template.Sessions.Max(t => t.SessionNumber)
            };

        int maxSessionNUmber = 0;
        if (int.TryParse(Template.Sessions.Max(t => t.SessionNumber), out maxSessionNUmber))
        {
            newSession.SessionNumber = (maxSessionNUmber + 1).ToString();
        } else
        {
            newSession.SessionNumber = (Template.Sessions.Count + 1).ToString();
        };

        Template.Sessions.Add(newSession);
        selectedSessionNumber = newSession.SessionNumber;
        setFocus(selectedSessionNumber);


    }

    private async void setFocus(string documentElementId)
    {
        await JSRuntime.InvokeVoidAsync("eval", $@"document.getElementById('{documentElementId}').focus()");
    }

    private void moveSession(int direction, CourseSessionTemplate item)
    {
        int currentSessionNumber = 0;


        if (!int.TryParse(item.SessionNumber, out currentSessionNumber))
        {
            return;
        };

        var swappingWithSession = Template.Sessions.Where(x => x.SessionNumber == (currentSessionNumber + direction).ToString()).FirstOrDefault();
        if (swappingWithSession!= null)
        {
            item.SessionNumber = swappingWithSession.SessionNumber;
            swappingWithSession.SessionNumber = currentSessionNumber.ToString();
        }
        selectedSessionNumber = item.SessionNumber;
        // renumberSessions();
    }

    private void removeSession(CourseSessionTemplate sessionTemplate)
    {
        Template.Sessions.Remove(sessionTemplate);
        renumberSessions();
    }

    private void renumberSessions()
    {
        int sessionNumber = 0;
        foreach (var item in Template.Sessions.OrderBy(x=>x.SessionNumber))
        {
            item.SessionNumber = (++sessionNumber).ToString();
        }
        
    }

}
