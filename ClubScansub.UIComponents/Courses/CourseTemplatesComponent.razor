@using ClubScansub.Service
@using ClubScansub.Utility
<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-5">

    <RadzenStack Orientation="Orientation.Horizontal">
        <CourseTypeToggleButtonsComponent OnFilter="applyTemplateFilter" SingleSelect="true" InitialFilters="initialFilters" />
    </RadzenStack>
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="New template..." Variant="Variant.Text" Click="addTemplate" Size="ButtonSize.Small"/>
</RadzenStack>

<RadzenDataGrid Data="@filteredTemplates" TItem="CourseTemplate" AllowAlternatingRows="false" RowDoubleClick="onEdit" @ref=grid>
    <EmptyTemplate>
        <BusyLoading isLoading="@isLoading" Message="Loading course templates..." NoDataMessage="No course templates found with the selected filters." />
    </EmptyTemplate>
    <Template Context="sessiondetails">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenText Text="Course sessions" TextStyle="TextStyle.Subtitle1"></RadzenText>

            <RadzenDataGrid Data="@sessiondetails.Sessions.OrderBy(x=>x.SessionNumber)" TItem="CourseSessionTemplate" AllowAlternatingRows="false">
                <Columns>
                    <RadzenDataGridColumn Width="40px" Title="Type">
                        <Template Context="sessionItem">
                            <RadzenIcon Icon="@IconsTextsAndColors.GetCourseSessionIcon(@sessionItem.SessionType)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(CourseSessionTemplate.Description)" Title="Description">
                        <Template Context="sessionItem">
                            <RadzenText Text="@sessionItem.Name" TextStyle="TextStyle.Subtitle2" />
                            <RadzenText Text="@sessionItem.Description" class="rz-text-truncate" TextStyle="TextStyle.Body2" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(CourseSessionTemplate.Address)" Title="Location" MinWidth="100px" Width="180px">
                        <Template Context="sessionItem">
                            <RadzenText Text="@sessionItem.Address?.Name" TextStyle="TextStyle.Subtitle2" class="rz-text-truncate" />
                            <RadzenText Text="@($"{sessionItem.Address?.Streetname}, {sessionItem.Address?.Zipcode}  {sessionItem.Address?.City}")" class="rz-text-truncate"  TextStyle="TextStyle.Caption" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(CourseSessionTemplate.DefaultWeekday)" Title="Default weekday and time" Width="180px;">
                        <Template Context="sessionItem">

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
                                <RadzenIcon Icon="@IconsTextsAndColors.Icons.CALENDAR" />
                                <RadzenText Text="@sessionItem.DefaultWeekday.ToString()" TextStyle="TextStyle.Body2" />
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenIcon Icon="@IconsTextsAndColors.Icons.START_TIME" />
                                <RadzenText Text="@sessionItem.DefaultStartTime.ToString(@"hh\:mm")" TextStyle="TextStyle.Body2" />
                                <RadzenIcon Icon="@IconsTextsAndColors.Icons.END_TIME" />
                                <RadzenText Text="@sessionItem.DefaultStartTime.Add(sessionItem.DefaultDuration).ToString(@"hh\:mm")" TextStyle="TextStyle.Body2" />
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">

                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>

        </RadzenStack>
    </Template>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(CourseTemplate.CourseType)" Title="Type" Width="40px">
            <Template Context="item">
                <RadzenIcon Icon="@IconsTextsAndColors.GetCourseIcon(item.CourseType)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CourseTemplate.TemplateName)" Title="Course Name">
            <Template Context="item">
                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@item.TemplateName" />
                <RadzenText TextStyle="TextStyle.Body2" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Attendance requirements" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="item">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_MIN" />
                    <RadzenText TextStyle="TextStyle.Body2" Text="@item.MinStudents.ToString()" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenIcon Icon="@IconsTextsAndColors.Icons.USER_MAX" />
                    <RadzenText TextStyle="TextStyle.Body2" Text="@item.MaxStudents.ToString()" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CourseTemplate.DefaultPrice)" Title="Price" Width="80px" TextAlign="TextAlign.Right" HeaderCssClass="rz-text-align-left">
            <Template Context="item">
                <RadzenText TextStyle="TextStyle.Body2" Text="@item.DefaultPrice.ToString("C0")" />

            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="40px" TextAlign="TextAlign.Center">
            <Template>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Icon="delete" Click="@(() => deleteTemplate(context))" Size="ButtonSize.Small" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {

    [Inject]
    CourseService courseService { get; set; }

    [Inject]
    DialogService dialogService { get; set; }

    private RadzenDataGrid<CourseTemplate> grid;
    private IList<CourseTemplate> templates = new List<CourseTemplate>();
    private IList<CourseTemplate> filteredTemplates = new List<CourseTemplate>();
    private CourseTypeEnum selectedCourseType = CourseTypeEnum.BaseCourse;
    private bool isLoading = true;

    private Dictionary<CourseTypeEnum, bool> initialFilters = new Dictionary<CourseTypeEnum, bool>()
    {
        {CourseTypeEnum.BaseCourse, true},
        {CourseTypeEnum.SpecialtyCourse, false},
        {CourseTypeEnum.TechCourse, false},
        {CourseTypeEnum.ProCourse, false}
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            templates = await courseService.GetTemplatesAsync();
            isLoading = false;
            applyTemplateFilter(initialFilters);
        }
    }

    private void applyTemplateFilter(Dictionary<CourseTypeEnum,bool> filter)
    {
        var selectedCouorseTypes = filter.Where(x => x.Value == true).Select(x => x.Key).ToList();
        filteredTemplates = templates.Where(x => selectedCouorseTypes.Contains(x.CourseType)).ToList();
        StateHasChanged();
    }

    private async void onEdit(DataGridRowMouseEventArgs<CourseTemplate> args)
    {
        await dialogService.OpenAsync<CourseTemplateDetailsComponent>("Edit Template",
        new Dictionary<string, object>()
            {
            {"Template",args.Data },
            {"OnSave", EventCallback.Factory.Create<CourseTemplate>(this,saveEditedTemplate)}
            },
        new DialogOptions()
            {
                Width = "85%",
                Height = "75%"
            }
        );

    }
    private async void deleteTemplate(CourseTemplate template)
    {
        var confirmAnswer = await dialogService.Confirm($"Do you want to delete '{template.TemplateName}'?", "Delete template", new ConfirmOptions()
            {
                OkButtonText = "Yes",
                CancelButtonText = "No"
            });

        if (confirmAnswer.GetValueOrDefault()) 
        {
            await courseService.DeleteTemplateAsync(template);
            templates.Remove(template);
            applyTemplateFilter(initialFilters);
        }

    }

    private async void addTemplate()
    {
        var newTemplate = new CourseTemplate()
            {
                Sessions = new List<CourseSessionTemplate>()
            };

        await dialogService.OpenAsync<CourseTemplateDetailsComponent>("New Template",
        new Dictionary<string, object>()
                {
            {"Template",newTemplate },
            {"OnSave", EventCallback.Factory.Create<CourseTemplate>(this,saveNewTemplate)}
                },
        new DialogOptions()
            {
                Width = "85%",
                Height = "75%"
            }
        );
    }

    private async void saveNewTemplate(CourseTemplate template)
    {
        var createdTemplate = await courseService.AddTemplateAsync(template);
        templates.Add(createdTemplate);
        applyTemplateFilter(initialFilters);
        dialogService.Close();
    }

    private async void saveEditedTemplate(CourseTemplate template)
    {
        await courseService.UpdateCourseTemplateAsync(template);
        dialogService.Close();
    }

}
