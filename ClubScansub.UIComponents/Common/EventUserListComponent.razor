@using ClubScansub.Utility
<RadzenDataGrid TItem="EventUser" Data="@EventUsers" class="rz-mb-4" AllowAlternatingRows="false">
    <EmptyTemplate>
        <RadzenText Text="No divers joined" TextStyle="TextStyle.Body1" TextAlign="TextAlign.Center" />
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn Title="Medlemsnummer" Width="120px">
            <Template Context="item">
                <RadzenText Text="@item.ApplicationUser?.AccountNumber" TextStyle="TextStyle.Body1" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Title="Navn">
            <Template Context="item">
                <RadzenText TextStyle="TextStyle.Subtitle1">
                    @($"{item.ApplicationUser?.Firstname} {@item.ApplicationUser?.Lastname}")
                </RadzenText>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Title="Alder" TextAlign="TextAlign.Center" Width="60px">
            <Template Context="item">
                <RadzenText Text="@((new DateTime((DateTime.Now - item.ApplicationUser.DayOfbirth).Ticks).Year-1).ToString())" TextStyle="TextStyle.Body1" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Title="Telefon" TextAlign="TextAlign.Center" Width="120px">
            <Template Context="item">
                <RadzenText Text="@item.ApplicationUser?.PhoneNumber" TextStyle="TextStyle.Body1" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="40px" Visible="!ReadOnly">
            <Template Context="item">
                <RadzenButton Icon="@IconsTextsAndColors.Icons.DELETE" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Shade="Shade.Lighter" Click="@(() => removeUserFromEvent_Click(item.ApplicationUser))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>

</RadzenDataGrid>

@if (Event?.FixedParticipants != null && Event?.FixedParticipants > 0)
{
    <RadzenPanel AllowCollapse Collapsed CollapseTitle="Hide other participants" ExpandTitle="Show other participants" Style="flex:1" Text="Other participants" class="rz-border-radius-2 rz-p-2" >

        <RadzenStack Orientation="Orientation.Horizontal" Gap="10" class="rz-mt-2">

            @for (int i = 0; i < Event.FixedParticipants; i++)
            {
                @if (!ReadOnly)
                {

                    <RadzenBadge BadgeStyle="BadgeStyle.Info" IsPill Shade="Shade.Lighter" Variant="Variant.Filled">
                        <RadzenButton Icon="@IconsTextsAndColors.Icons.USER_MIN" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text" Shade="Shade.Default" Click="removeFixedUser" Size="ButtonSize.ExtraSmall" Text="Scansub" />
                    </RadzenBadge>
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" IsPill Shade="Shade.Lighter" Variant="Variant.Filled" Icon="@IconsTextsAndColors.Icons.USER_MIN" Text="Scansub" />
                }
            }
        </RadzenStack>
   
    </RadzenPanel>
}