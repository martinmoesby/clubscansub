@using Radzen.Blazor
<RadzenDatePicker style="display: block; width: 100%"
                  @bind-Value="@dateTime"
                  TValue="DateTime?"
                  Change="UpdateTime"
                  Name="@Name"
                  DateFormat="HH:mm tt"
                  ShowTime="true"
                  HourFormat="24"
                  TimeOnly="true" Disabled="@Disabled"/>

@code {
    [Parameter]
    public TimeSpan TimeValue { get; set; }

    [Parameter]
    public EventCallback<TimeSpan> TimeValueChanged { get; set; }

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    private DateTime? dateTime { get; set; }

    protected override void OnInitialized()
    {
        dateTime = (new DateTime()).Add(TimeValue);
        base.OnInitialized();
    }

    void UpdateTime(DateTime? dateTime)
    {
        if (dateTime is null) return;
        TimeValue = TimeOnly.FromDateTime(dateTime.Value).ToTimeSpan();
        TimeValueChanged.InvokeAsync(TimeValue);
    }
}