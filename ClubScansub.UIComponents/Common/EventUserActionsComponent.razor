@using ClubScansub.Utility

<RadzenStack Orientation="Orientation.Horizontal" Gap="50" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-5" Visible="@Visible">

    <RadzenStack Orientation="Orientation.Horizontal" Style="flex:1" Gap="5">
        <RadzenButton Click="reserveSpotCallback" Text="Seat reservation" Icon="@IconsTextsAndColors.Icons.USER_CHECK" ButtonStyle="ButtonStyle.Info" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall"/>
        <RadzenDropDown AllowFiltering="true"
                        AllowClear="true"
                        AllowSelectAll="false"
                        Data="@filteredUsers"
                        @bind-Value="@selectedUser"
                        TextProperty="@nameof(ApplicationUser.Name)"
                        ValueProperty="@nameof(ApplicationUser.Id)"
                        LoadData="@onLoadExistingUsers">

        </RadzenDropDown>
        <RadzenButton Click="enrollExistingUserCallback" Text="Enroll user" Size="ButtonSize.ExtraSmall" Icon="@IconsTextsAndColors.Icons.USER_CHECK" ButtonStyle="ButtonStyle.Success" Shade="Shade.Light" Disabled="@(string.IsNullOrEmpty(selectedUser))" />
    </RadzenStack>

    <RadzenButton Text="Add user" ButtonStyle="ButtonStyle.Primary" Shade="Shade.Lighter" Icon="@IconsTextsAndColors.Icons.USER_ADD" Click="addNewUser_Click" Visible ="ShowAddNewUser" />

</RadzenStack>
