@using ClubScansub.Utility
@* @rendermode InteractiveServer *@

<RadzenStack Orientation="Orientation.Horizontal" Gap="50" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-5" Visible="@Visible">

    <RadzenStack Orientation="Orientation.Horizontal" Style="flex:1" Gap="5">
        <RadzenButton Style="flex:1;" Click="reserveSpotCallback" Text="Seat reservation" Icon="@IconsTextsAndColors.Icons.USER_CHECK" ButtonStyle="ButtonStyle.Info" Shade="Shade.Dark" Size="ButtonSize.Small"/>
        <RadzenDropDown AllowFiltering="true"
                        AllowClear="true"
                        AllowSelectAll="false"
                        
                        Data="@members"
                        @bind-Value="@selectedUser"
                        TextProperty="@nameof(ApplicationUser.Name)"
                        ValueProperty="@nameof(ApplicationUser.Id)"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterAutoCompleteType="AutoCompleteType.Name"
                        FilterOperator="StringFilterOperator.Contains"
                        FilterPlaceholder="Search for name.."
                        ClearSearchAfterSelection
                        Style="flex:3;width:100%; white-space:nowrap"
                        PopupStyle="width:100%; height:120px; white-space:nowrap"
                        ></RadzenDropDown>


        @* LoadData="@onLoadExistingUsers" *@

        <RadzenButton Style="flex:1;" Click="enrollExistingUserCallback" Text="Enroll user" Size="ButtonSize.Small" Icon="@IconsTextsAndColors.Icons.USER_CHECK" ButtonStyle="ButtonStyle.Success" Shade="Shade.Default" Disabled="@(string.IsNullOrEmpty(selectedUser))" />
    </RadzenStack>

    <RadzenButton Text="Create..." Size="ButtonSize.Small"  ButtonStyle="ButtonStyle.Success" Shade="Shade.Light" Variant="Variant.Text" Icon="@IconsTextsAndColors.Icons.USER_ADD" Click="addNewUser_Click" Visible="ShowAddNewUser" />

</RadzenStack>