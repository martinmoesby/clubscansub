@using ClubScansub.Utility;
    <RadzenText TextStyle="TextStyle.DisplayH6" Text="@($"Account details")" />
<RadzenStack Gap="40">

    <RadzenDataGrid TItem="ApplicationUserAccountEntry" Data="@Transactions" AllowSorting AllowPaging PageSize="15" AllowAlternatingRows="false">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(ApplicationUserAccountEntry.Id)" Title="Entry no." Width="80px" />
            <RadzenDataGridColumn Property="@nameof(ApplicationUserAccountEntry.PostingDate)" Title="Posting Date" Width="180px" />
            <RadzenDataGridColumn Property="@nameof(ApplicationUserAccountEntry.Description)" Title="Description" />
            <RadzenDataGridColumn Property="@nameof(ApplicationUserAccountEntry.Amount)" Title="Amount" TextAlign="TextAlign.Right" Width="180px" />
        </Columns>
    </RadzenDataGrid>
</RadzenStack>
<RadzenButton Click="@closeDialog" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Success" Shade="Shade.Default" Text="Close" Icon="close" class="rz-mt-6" />



