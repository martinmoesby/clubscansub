<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLubScansub.MAUI.App2.Views.ContactsPage"
             Title="Contacts">

    <Grid RowDefinitions="50,*,50" ColumnDefinitions="*" Padding="10">

        <ListView 
        Grid.Column="0" Grid.Row="1"
        x:Name="contactsList" 
        BackgroundColor="Transparent" SeparatorColor="Silver" RowHeight="65" SelectionMode="Single" 
        ItemSelected="contactsList_ItemSelected"
        ItemTapped="contactsList_ItemTapped"
        >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}" Detail="{Binding Email}">
                        <TextCell.ContextActions>
                            <MenuItem Text="Delete" x:Name="deleteButton" Clicked="deleteButton_Clicked" CommandParameter="{Binding .}"></MenuItem>
                            <!--<MenuItem Text="Edit"></MenuItem>-->
                        </TextCell.ContextActions>
                    </TextCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
        <Button Clicked="addContactButton_Clicked" Text="Add contact" Grid.Row="2" Grid.Column="0" />
        <SearchBar Grid.Row="0" Grid.Column="0" Placeholder="Search contacts" TextChanged="SearchBar_TextChanged" SearchButtonPressed="SearchBar_SearchButtonPressed" />
    </Grid>
</ContentPage>